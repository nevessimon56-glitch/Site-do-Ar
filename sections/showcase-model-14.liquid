<!-- Showcase Model 14 - Instagram  -->
<section class="showcase showcase-{{ showcaseSection.id }} showcase-model-{{ showcaseSection.typeId }}">
    {% assign sectionConfig = showcaseSection.config %}
    <div class="container">
        {% comment %}*** START - Title ***{% endcomment %}
        {% assign styleTitle = '' %}
        {% assign classTitle = '' %}
        {% case sectionConfig.namePosition %}
            {% when 'center' %}
                {% if sectionConfig.display == 'carousel' %}
                    {% assign classTitle = ' showcase-title_carousel' %}
                {% endif %}
                {% assign styleTitle = 'text-align: center;' %}
            {% when 'left' %}
                {% if sectionConfig.display == 'carousel' %}
                    {% assign classTitle = ' showcase-title_carousel' %}
                {% endif %}
                {% assign styleTitle = 'text-align: left;' %}
            {% when 'right' %}
                {% if sectionConfig.display == 'carousel' %}
                    {% assign classTitle = ' showcase-title_carousel' %}
                {% endif %}
                {% assign styleTitle = 'text-align: right;' %}
            {% when "hidden" %}
                {% assign styleTitle = "display: none;" %}
        {% endcase %}
        {% if showcaseSection.metadata.user %}
            <h2 class="showcase-title" style="{{ styleTitle }}">
                Siga nosso instagram
                <a href="https://www.instagram.com/{{ showcaseSection.metadata.user }}" target="_blank">@{{ showcaseSection.metadata.user }}</a>
            </h2>
        {% elsif showcaseSection.name %}
            <h2 class="showcase-title{{ classTitle }}" style="{{ styleTitle }}">
                {{ showcaseSection.name }}
            </h2>
        {% endif %}
        {% comment %}*** END - Title ***{% endcomment %}


        {% assign iconInsta = '<svg xmlns="http://www.w3.org/2000/svg" width="56px" height="56px" x="0" y="0" fill="#fff" viewBox="0 0 409.61 409.61"><path d="M307.205 0h-204.8C46.09 0 .005 46.085.005 102.4v204.81c0 56.3 46.085 102.4 102.4 102.4h204.8c56.315 0 102.4-46.1 102.4-102.4V102.4c0-56.315-46.085-102.4-102.4-102.4zm68.265 307.21c0 37.632-30.612 68.265-68.265 68.265h-204.8c-37.637 0-68.265-30.633-68.265-68.265V102.4c0-37.642 30.628-68.265 68.265-68.265h204.8c37.653 0 68.265 30.623 68.265 68.265v204.81z"></path><circle cx="315.755" cy="93.865" r="25.6"></circle><path d="M204.805 102.4c-56.566 0-102.4 45.839-102.4 102.4 0 56.54 45.834 102.41 102.4 102.41 56.55 0 102.4-45.87 102.4-102.41 0-56.561-45.85-102.4-102.4-102.4zm0 170.675c-37.699 0-68.265-30.566-68.265-68.275s30.566-68.265 68.265-68.265 68.265 30.556 68.265 68.265-30.566 68.275-68.265 68.275z"></path></svg>' %}

        {% assign isCarousel = false %}
        {% assign classLazy = ' lazy' %}
        {% if sectionConfig.display == 'carousel' %}
            {% assign isCarousel = true %}
            {% assign classLazy = ' lazy-slider' %}
        {% endif %}

        {% assign maximumItensInsta = 30 %}
        {% if sectionConfig.rowQuantity and sectionConfig.columnQuantity %}
            {% assign maximumItensInsta = sectionConfig.rowQuantity | times: sectionConfig.columnQuantity %}
        {% endif %}

        <div class="showcase-banners showcase-insta showcase-insta_{{ sectionConfig.display }} showcase-insta_{{ sectionConfig.display }}__{{ sectionConfig.columnQuantity }}">
            <div class="showcase-box showcase-box-{{ sectionConfig.display }}">
                <ul class="showcase-list showcase-list-{{ sectionConfig.display }} showcase-list-{{ sectionConfig.columnQuantity }} banners-slider-insta-{{ sectionConfig.columnQuantity }}">
                    {% for showcaseMedia in showcaseSection.config.medias limit:maximumItensInsta %}
                        {% assign redirectLink = 'javascript:void(0)' %}
                        {% assign medialink = 'javascript:void(0)' %}
                        {% assign mediaType = 'IMAGE' %}

                        {% if showcaseMedia.redirectLink %}
                            {% assign redirectLink = showcaseMedia.redirectLink %}
                        {% endif %}
                        {% if showcaseMedia.link %}
                            {% assign medialink = showcaseMedia.link %}
                        {% endif %}
                        {% if showcaseMedia.type %}
                            {% assign mediaType = showcaseMedia.type %}
                        {% endif %}
                        <li class="showcase-item">
                            <a class="showcase-insta_link showcase-insta_link__image" href="{{ redirectLink }}" rel="noopener" target="_blank">
                                <div class="showcase-insta-media_mask">
                                    <div class="showcase-insta-mask_icon">
                                        {{ iconInsta }}
                                    </div>
                                </div>
                                <div class="showcase-insta_media">
                                    {% if medialink %}
                                        {% if mediaType == 'VIDEO' %}
                                            {% if isCarousel %}
                                                <video src="{{ medialink }}"></video>
                                            {% else %}
                                                <video class="{{ classLazy }}" data-src="{{ medialink }}"></video>
                                            {% endif %}
                                        {% else %}
                                            <picture>
                                                <img class="{{ classLazy }}" data-src="{{ medialink }}"/>
                                            </picture>
                                        {% endif %}
                                    {% else %}
                                        {{ themeConfig.icons.image }}
                                    {% endif %}
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if isCarousel %}
                    {% comment %}*** START - Btn Arrow ***{% endcomment %}
                    {% assign classCenterSliderArrow = '' %}
                    {% if sectionConfig.namePosition == 'hidden' %}
                        {% assign classCenterSliderArrow = ' slider__arrow--center' %}
                    {% endif %}
                    <div class="controls controls-arrow" aria-label="Carousel Navigation" tabindex="0">
                        <button class="slider__arrow slider__arrow--prev{{ classCenterSliderArrow }}" aria-label="Anterior">
                            {{ themeConfig.icons.arrow.prev }}
                        </button>
                        <button class="slider__arrow slider__arrow--next{{ classCenterSliderArrow }}" aria-label="Próximo">
                            {{ themeConfig.icons.arrow.next }}
                        </button>
                    </div>
                    {% comment %}*** END - Btn Arrow ***{% endcomment %}
                {% endif %}
            </div>
        </div>
    </div>
</section>
