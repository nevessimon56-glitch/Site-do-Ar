{% comment %}
  Dados JSON para comparador de produtos
  VERSAO: 2026-07-30-compare-v2-area
  Uso: {% render 'sections/product-compare-data', product: product, pixPrice: pixPriceCard, listPrice: listPriceCard %}
{% endcomment %}

{% assign specTitle = product.title | downcase %}
{% assign specBlob = specTitle %}

{% if product.url and product.url != '' %}
  {% assign specBlob = specBlob | append: ' | ' | append: product.url | downcase %}
{% endif %}
{% if product.tags and product.tags != '' %}
  {% assign specBlob = specBlob | append: ' | ' | append: product.tags | downcase %}
{% endif %}
{% if product.shortDescription and product.shortDescription != '' %}
  {% assign specBlob = specBlob | append: ' | ' | append: product.shortDescription | downcase %}
{% endif %}

{% capture specHtmlRaw %}
{% if product.specification and product.specification != '' %}{{ product.specification }}{% endif %}
{% if product.specifications and product.specifications != '' %}{{ product.specifications }}{% endif %}
{% if product.specificationText and product.specificationText != '' %}{{ product.specificationText }}{% endif %}
{% if product.especificacao and product.especificacao != '' %}{{ product.especificacao }}{% endif %}
{% if product.especificacoes and product.especificacoes != '' %}{{ product.especificacoes }}{% endif %}
{% endcapture %}
{% assign specHtmlRaw = specHtmlRaw | strip %}

{% if specHtmlRaw != '' %}
  {% assign specPlain = specHtmlRaw
    | replace: '<br>', ' | '
    | replace: '<br/>', ' | '
    | replace: '<br />', ' | '
    | replace: '</tr>', ' | '
    | replace: '</td>', ' '
    | replace: '<td>', ' '
    | replace: '</th>', ' '
    | replace: '<th>', ' '
    | strip_html
    | downcase
  %}
  {% assign specBlob = specBlob | append: ' | ' | append: specPlain %}
{% endif %}

{% assign cmpProcelA = false %}
{% assign cmpQuenteFrio = false %}
{% assign cmpFrio = false %}
{% assign cmpCobre = false %}
{% assign cmpWifi = false %}
{% assign cmpInverter = false %}
{% assign cmpVoltage = '' %}

{% if specBlob contains 'procel' or specBlob contains 'classificação a' or specBlob contains 'classificacao a' or specBlob contains 'selo a' %}
  {% assign cmpProcelA = true %}
{% endif %}
{% if specBlob contains 'quente/frio' or specBlob contains 'quente-frio' or specBlob contains 'quente e frio' or specBlob contains 'ciclo reverso' %}
  {% assign cmpQuenteFrio = true %}
{% elsif specBlob contains 'só frio' or specBlob contains 'so frio' or specBlob contains 'somente frio' or specBlob contains 'ciclo: frio' %}
  {% assign cmpFrio = true %}
{% elsif specBlob contains 'frio' %}
  {% unless specBlob contains 'quente' %}
    {% assign cmpFrio = true %}
  {% endunless %}
{% endif %}
{% if specBlob contains 'inverter' or specBlob contains 'inversor' %}
  {% assign cmpInverter = true %}
{% endif %}
{% if specBlob contains 'cobre' %}
  {% unless specBlob contains 'alumínio' or specBlob contains 'aluminio' %}
    {% assign cmpCobre = true %}
  {% endunless %}
{% endif %}
{% if specBlob contains '220v' or specBlob contains '220 v' %}
  {% assign cmpVoltage = '220V' %}
{% elsif specBlob contains '127v' or specBlob contains '127 v' %}
  {% assign cmpVoltage = '127V' %}
{% elsif specBlob contains 'bivolt' or specBlob contains 'bi-volt' %}
  {% assign cmpVoltage = 'Bivolt' %}
{% endif %}
{% unless specTitle contains 'mecânico' or specTitle contains 'mecanico' or specTitle contains 'janela' %}
  {% if specBlob contains 'wi-fi' or specBlob contains 'wifi' %}
    {% assign cmpWifi = true %}
  {% endif %}
{% endunless %}

{% assign cmpType = 'Split' %}
{% if specTitle contains 'janela' %}
  {% assign cmpType = 'Janela' %}
{% elsif specTitle contains 'piso teto' or specTitle contains 'piso-teto' %}
  {% assign cmpType = 'Piso Teto' %}
{% elsif specTitle contains 'multi split' %}
  {% assign cmpType = 'Multi Split' %}
{% endif %}

{% assign cmpArea = '' %}
{% if product.attributes and product.attributes.size > 0 %}
  {% for attr in product.attributes %}
    {% assign attrNameCmp = attr.name | default: attr.nome | default: '' | downcase %}
    {% assign attrValCmp = '' %}
    {% if attr.values and attr.values.size > 0 %}
      {% assign attrValCmp = attr.values[0].name | default: attr.values[0].value | default: '' %}
    {% elsif attr.value %}
      {% assign attrValCmp = attr.value %}
    {% endif %}
    {% if attrNameCmp contains 'área' or attrNameCmp contains 'area' or attrNameCmp contains 'ambiente' %}
      {% if attrValCmp != '' %}
        {% assign cmpArea = attrValCmp %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign cmpSearchText = specBlob | truncate: 1800, '' %}

{% assign cmpPix = pixPrice | default: product.price.price %}
{% assign cmpList = listPrice | default: product.price.price %}
{% assign cmpImg = '' %}
{% if product.medias[0].path %}
  {% assign cmpImg = product.medias[0].path | imgUrl: 250 %}
{% endif %}

<script type="application/json" class="product-compare-json" data-product-id="{{ product.id }}">
{
  "id": {{ product.id | json }},
  "title": {{ product.title | json }},
  "url": {{ product.url | json }},
  "image": {{ cmpImg | json }},
  "pixPrice": {{ cmpPix | json }},
  "listPrice": {{ cmpList | json }},
  "specs": {
    "procelA": {{ cmpProcelA | json }},
    "quenteFrio": {{ cmpQuenteFrio | json }},
    "frio": {{ cmpFrio | json }},
    "inverter": {{ cmpInverter | json }},
    "cobre": {{ cmpCobre | json }},
    "wifi": {{ cmpWifi | json }},
    "voltage": {{ cmpVoltage | json }},
    "type": {{ cmpType | json }},
    "recommendedArea": {{ cmpArea | json }}
  },
  "searchText": {{ cmpSearchText | json }},
  "attributes": [
    {% if product.attributes and product.attributes.size > 0 %}
      {% for attr in product.attributes %}
        {% assign attrName = attr.name | default: attr.nome | default: '' %}
        {% assign attrVal = '' %}
        {% if attr.values and attr.values.size > 0 %}
          {% assign attrVal = attr.values[0].name | default: attr.values[0].value | default: '' %}
        {% elsif attr.value %}
          {% assign attrVal = attr.value %}
        {% endif %}
        {"name": {{ attrName | json }}, "value": {{ attrVal | json }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endif %}
  ]
}
</script>
