{% comment %}
  Dados compactos para comparador (sem script tag — não quebra layout do card)
  VERSAO: 2026-07-30-compare-v3-perf
{% endcomment %}

{% assign specTitle = product.title | downcase %}
{% assign specBlob = specTitle %}

{% if product.tags and product.tags != '' %}
  {% assign specBlob = specBlob | append: ' | ' | append: product.tags | downcase %}
{% endif %}

{% capture specHtmlRaw %}
{% if product.specification and product.specification != '' %}{{ product.specification }}{% endif %}
{% if product.specifications and product.specifications != '' %}{{ product.specifications }}{% endif %}
{% if product.specificationText and product.specificationText != '' %}{{ product.specificationText }}{% endif %}
{% endcapture %}
{% assign specHtmlRaw = specHtmlRaw | strip %}

{% assign cmpArea = '' %}
{% assign cmpAreaHint = '' %}

{% if product.attributes and product.attributes.size > 0 %}
  {% for attr in product.attributes %}
    {% assign attrNameCmp = attr.name | default: attr.nome | default: '' | downcase %}
    {% assign attrValCmp = '' %}
    {% if attr.values and attr.values.size > 0 %}
      {% assign attrValCmp = attr.values[0].name | default: attr.values[0].value | default: '' %}
    {% elsif attr.value %}
      {% assign attrValCmp = attr.value %}
    {% endif %}
    {% if cmpArea == '' %}
      {% if attrNameCmp contains 'área' or attrNameCmp contains 'area' or attrNameCmp contains 'ambiente' %}
        {% if attrValCmp != '' %}
          {% assign cmpArea = attrValCmp %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if specHtmlRaw != '' %}
  {% assign specPlain = specHtmlRaw | strip_html | downcase %}
  {% if cmpArea == '' %}
    {% if specPlain contains 'm²' or specPlain contains 'm2' %}
      {% assign cmpAreaHint = specPlain | truncate: 160, '' %}
    {% endif %}
  {% endif %}
{% endif %}

{% assign cmpProcelA = false %}
{% assign cmpQuenteFrio = false %}
{% assign cmpFrio = false %}
{% assign cmpCobre = false %}
{% assign cmpWifi = false %}
{% assign cmpInverter = false %}
{% assign cmpVoltage = '' %}

{% if specBlob contains 'procel' or specBlob contains 'classificação a' or specBlob contains 'classificacao a' %}
  {% assign cmpProcelA = true %}
{% endif %}
{% if specBlob contains 'quente/frio' or specBlob contains 'quente-frio' or specBlob contains 'quente e frio' %}
  {% assign cmpQuenteFrio = true %}
{% elsif specBlob contains 'só frio' or specBlob contains 'so frio' or specBlob contains 'somente frio' %}
  {% assign cmpFrio = true %}
{% endif %}
{% if specBlob contains 'inverter' or specBlob contains 'inversor' %}
  {% assign cmpInverter = true %}
{% endif %}
{% if specBlob contains 'cobre' %}
  {% unless specBlob contains 'alumínio' or specBlob contains 'aluminio' %}
    {% assign cmpCobre = true %}
  {% endunless %}
{% endif %}
{% if specBlob contains '220v' %}
  {% assign cmpVoltage = '220V' %}
{% elsif specBlob contains '127v' %}
  {% assign cmpVoltage = '127V' %}
{% elsif specBlob contains 'bivolt' %}
  {% assign cmpVoltage = 'Bivolt' %}
{% endif %}
{% unless specTitle contains 'mecânico' or specTitle contains 'mecanico' or specTitle contains 'janela' %}
  {% if specBlob contains 'wi-fi' or specBlob contains 'wifi' %}
    {% assign cmpWifi = true %}
  {% endif %}
{% endunless %}

{% assign cmpType = 'Split' %}
{% if specTitle contains 'janela' %}
  {% assign cmpType = 'Janela' %}
{% elsif specTitle contains 'piso teto' or specTitle contains 'piso-teto' %}
  {% assign cmpType = 'Piso Teto' %}
{% endif %}

{% assign cmpPix = pixPrice | default: product.price.price %}
{% assign cmpList = listPrice | default: product.price.price %}
{% assign cmpImg = '' %}
{% if product.medias[0].path %}
  {% assign cmpImg = product.medias[0].path | imgUrl: 250 %}
{% endif %}

<template class="product-compare-data" data-product-id="{{ product.id }}">{"id":{{ product.id }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ cmpImg | json }},"pixPrice":{{ cmpPix }},"listPrice":{{ cmpList }},"area":{{ cmpArea | json }},"areaHint":{{ cmpAreaHint | json }},"specs":{"procelA":{{ cmpProcelA }},"quenteFrio":{{ cmpQuenteFrio }},"frio":{{ cmpFrio }},"inverter":{{ cmpInverter }},"cobre":{{ cmpCobre }},"wifi":{{ cmpWifi }},"voltage":{{ cmpVoltage | json }},"type":{{ cmpType | json }},"recommendedArea":{{ cmpArea | json }}}}</template>
