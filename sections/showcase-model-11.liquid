<!-- Showcase Model 11 - Mosaic Banner Small 6 And Large 1 -->
{% if showcaseSection.config.medias.size > 0 %}
    <section class="showcase showcase-{{ showcaseSection.id }} showcase-model-{{ showcaseSection.typeId }}">
        {% assign bannerGridConfig = showcaseSection.config %}
        <div class="container">
            <!-- Título da Vitrine -->
            {% if showcaseSection.name %}
                {% assign styleTitle = '' %}
                {% case bannerGridConfig.namePosition %}
                    {% when 'center' %}
                        {% assign styleTitle = 'text-align: center;' %}
                    {% when 'left' %}
                        {% assign styleTitle = 'text-align: left;' %}
                    {% when 'right' %}
                        {% assign styleTitle = 'text-align: right;' %}
                    {% when "hidden" %}
                        {% assign styleTitle = "display: none;" %}
                {% endcase %}
                <h2 class="showcase-title" style="{{ styleTitle }}">
                    {{ showcaseSection.name }}
                </h2>
            {% endif %}
            <div class="showcase-banners showcase-banners_grid showcase-banners_grid__custom showcase-banners_grid__custom11">
                <div class="showcase-banners-box">
                    <div class="columns hide-sm">
                        {% for showcaseMedia in showcaseSection.config.medias limit: 7 %}
                            {% if forloop.index <= 6 %}
                                <div class="column col-4 col-lg-6 col-md-6 col-sm-12">
                                    <a class="showcase-banner_link" href="{% if showcaseMedia.link %}{{ showcaseMedia.link }}{% else %}javascript:void(0){% endif %}" title="{{ showcaseMedia.title }}">
                                        {% if showcaseMedia.path %}
                                            <picture>
                                                <img class="showcase-banner_img banner-img_grid banner-img_grid__{{ forloop.index }} img-lazy" data-src="{{ showcaseMedia.path | imgUrl }}" alt="{{ showcaseMedia.title }}">
                                            </picture>
                                        {% else %}
                                            <div class="showcase-banner_image__empty">
                                                {{ themeConfig.icons.image }}
                                            </div>
                                        {% endif %}
                                    </a>
                                </div>
                            {% else %}
                                <div class="column col-12">
                                    <a class="showcase-banner_link" href="{% if showcaseMedia.link %}{{ showcaseMedia.link }}{% else %}javascript:void(0){% endif %}" title="{{ showcaseMedia.title }}">
                                        {% if showcaseMedia.path %}
                                            <picture>
                                                <img class="showcase-banner_img banner-img_grid banner-img_grid__{{ forloop.index }} img-lazy" data-src="{{ showcaseMedia.path | imgUrl }}" alt="{{ showcaseMedia.title }}">
                                            </picture>
                                        {% else %}
                                            <div class="showcase-banner_image__empty">
                                                {{ themeConfig.icons.image }}
                                            </div>
                                        {% endif %}
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="columns show-sm">
                        <div class="column col-12">
                            <div class="showcase-banner_carousel">
                                <ul class="showcase-banner_list showcase-banner_slider">
                                    {% for showcaseMedia in showcaseSection.config.medias limit:6 %}
                                        {% if forloop.index <= 6 %}
                                            <li class="showcase-banner_item">
                                                <a class="showcase-banner_link" href="{% if showcaseMedia.link %}{{ showcaseMedia.link }}{% else %}javascript:void(0){% endif %}" title="{{ showcaseMedia.title }}">
                                                    {% if showcaseMedia.path %}
                                                        <picture>
                                                            <img class="showcase-banner_img banner-img_grid banner-img_grid__{{ forloop.index }} img-lazy" data-src="{{ showcaseMedia.path | imgUrl  }}" alt="{{ showcaseMedia.title }}">
                                                        </picture>
                                                    {% else %}
                                                        <div class="showcase-banner_image__empty">
                                                            {{ themeConfig.icons.image }}
                                                        </div>
                                                    {% endif %}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                                {% assign classCenterSliderArrow = '' %}
                                {% if bannerGridConfig.namePosition == 'hidden' %}
                                    {% assign classCenterSliderArrow = ' slider__arrow--center' %}
                                {% endif %}
                                <div class="controls controls-arrow" aria-label="Carousel Navigation" tabindex="0">
                                    <button class="slider__arrow slider__arrow--prev{{ classCenterSliderArrow }}" aria-label="Anterior">
                                        {{ themeConfig.icons.arrow.prev }}
                                    </button>
                                    <button class="slider__arrow slider__arrow--next{{ classCenterSliderArrow }}" aria-label="Próximo">
                                        {{ themeConfig.icons.arrow.next }}
                                    </button>
                                </div>
                            </div>
                        </div>
                        {% if showcaseSection.config.medias[6] %}
                            <div class="column col-12">
                                {% assign showcaseMediaLast = showcaseSection.config.medias[6] %}
                                <a class="showcase-banner_link" href="{% if showcaseMediaLast.link %}{{ showcaseMediaLast.link }}{% else %}javascript:void(0){% endif %}" title="{{ showcaseMediaLast.title }}">
                                    {% if showcaseMediaLast.path %}
                                        <picture>
                                            <img class="showcase-banner_img banner-img_grid banner-img_grid__7 img-lazy" data-src="{{ showcaseMediaLast.path | imgUrl }}" alt="{{ showcaseMediaLast.title }}">
                                        </picture>
                                    {% else %}
                                        <div class="showcase-banner_image__empty">
                                            {{ themeConfig.icons.image }}
                                        </div>
                                    {% endif %}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}
