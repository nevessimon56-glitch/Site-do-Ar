<div class="card checkout-card checkout-card-summary">
    <div class="card-body">
        <template x-for="(product, index) in state.products" :key="index">
            <section class="checkout-product">
                <div class="checkout-product-left">
                    <a class="checkout-product-image" :title="product.title" x-bind:href="product.url">
                        <template x-if="product.image">
                            <picture>
                                <img class="lazy loaded" x-bind:data-src="product.image.thumbUrl"
                                     x-bind:src="product.image.thumbUrl" :alt="product.title">
                            </picture>
                        </template>
                        <template x-if="!product.image">
                            {{ themeConfig.icons.image }}
                        </template>
                    </a>
                </div>
                <div class="checkout-product-center">
                    <a class="checkout-product-title" :title="product.title" x-bind:href="product.url">
                        <p x-text="`${product.title}`"></p>
                        <p x-text="`Quantidade: ${product.quantity}`"></p>
                        <template x-if="product.grids">
                            <p>
                                <template x-for="(grid, index, collection) in product.grids" :key="index">
                                    <span x-text="`${[grid.name + ': ' + grid.value]}${(product.grids.length !== index+1) ? ' / ' : ''}`"></span>
                                </template>
                            </p>
                        </template>
                        <template x-if="product.products">
                            <template x-for="(productKit, index) in product.products" :key="index">
                                <p :class="{ 'mt-0': (index > 0) }" style="padding-top: 4px;">
                                    <span x-text="`${[productKit.quantity + 'x '+productKit.title]}`"></span>
                                </p>
                            </template>
                        </template>
                    </a>
                </div>
                <div class="checkout-product-right">
                    <template x-if="!product.groupPurchase">
                        <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(product.originalTotalPrice)"></p>
                    </template>
                    <template x-if="product.groupPurchase && product.groupPurchase.length > 0">
                        <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(product.principalPriceInGroupPurchase.totalPrice)"></p>
                    </template>
                    <a class="btn-checkout-delete float-right" @click="removeProduct(product.uid, product)" href="javascript:void(0)" aria-label="Close">
                        {% assign iconDeleteCheckout = themeConfig.icons.close %}
                        {% if themeConfig.icons.checkout.delete %}
                            {% assign iconDeleteCheckout = themeConfig.icons.checkout.delete %}
                        {% endif %}
                        {{ iconDeleteCheckout }}
                    </a>
                </div>
                <template x-if="product.groupPurchase && product.groupPurchase.length > 0">
                    <div class="col-12 checkout-product-info">
                        <ul class="checkout-product-groupPurchase_list">
                        <template x-for="(productGroupPurchase, indexGroupPurchase) in product.groupPurchase" :key="index">
                            <li class="checkout-product-groupPurchase_item">
                                <div class="checkout-product-groupPurchase_box checkout-product-groupPurchase-box_image">
                                    <div class="checkout-product-image">
                                        <template x-if="productGroupPurchase.image">
                                            <picture>
                                                <img class="lazy loaded" x-bind:data-src="productGroupPurchase.image" x-bind:src="productGroupPurchase.image" :alt="productGroupPurchase.title">
                                            </picture>
                                        </template>
                                        <template x-if="!productGroupPurchase.image">
                                            {{ themeConfig.icons.image }}
                                        </template>
                                    </div>
                                </div>
                                <div class="checkout-product-groupPurchase_box checkout-product-groupPurchase-box_title">
                                    <div class="checkout-product-title">
                                        <p x-text="`${productGroupPurchase.title}`"></p>
                                        <p x-text="`Quantidade: ${product.quantity}`"></p>
                                    </div>
                                </div>
                                <div class="checkout-product-groupPurchase_box checkout-product-groupPurchase-box_price">
                                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(productGroupPurchase.originalTotalPrice)"></p>
                                </div>
                            </li>
                        </template>
                    </ul>
                    </div>
                </template>
            </section>
        </template>
    </div>
    <div class="card-footer">
        <section class="checkout-product-subtotal_price">
            <div class="checkout-product-left">
                <p class="checkout-product-title">
                    Subtotal
                </p>
            </div>
            <div class="checkout-product-right">
                <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(state.subtotal)"></p>
            </div>
        </section>

        <!-- Desconto Pagamento: Com Frete selecionado / Pegando as informações do checkout -->
        <template x-if="state.shippingSelected.code && getTaxValue() < 0">
            <section class="checkout-product-payment_price" data-info="checkout">
                <div class="checkout-product-left">
                    <p class="checkout-product-title">Desconto da forma de pagamento</p>
                </div>
                <div class="checkout-product-right">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(getTaxValue())"></p>
                </div>
            </section>
        </template>

        <!-- Desconto Pagamento: Sem Frete selecionado / Pegando as informações do cart -->
        <template x-if="!state.shippingSelected.code && (state.currentStep === 'shipping') && (state.cart.tax < 0)">
            <section class="checkout-product-payment_price" data-info="cart">
                <div class="checkout-product-left">
                    <p class="checkout-product-title">Desconto da forma de pagamento</p>
                </div>
                <div class="checkout-product-right">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(state.cart.tax)"></p>
                </div>
            </section>
        </template>

        <template x-for="(promotion, index) in state.promotions" :key="index">
            <section class="checkout-product-coupon_price">
                <div class="checkout-product-left">
                    <p class="checkout-product-title" x-show="promotion.observation">
                        <span x-text="promotion.observation"></span>
                    </p>
                </div>
                <div class="checkout-product-right">
                    <p class="checkout-product-price">
                        -
                        <span x-text="StoreSDK.utils.toCurrency(promotion.value)"></span>
                    </p>
                </div>
            </section>
        </template>
        <section class="checkout-product-coupon_price" x-show="state.coupon.applied && state.coupon.code">
            <div class="checkout-product-left">
                <p class="checkout-product-title" x-show="state.coupon.observation">
                    <span x-text="state.coupon.observation"></span>
                </p>
            </div>
            <div class="checkout-product-right">
                <p class="checkout-product-price">
                    -
                    <span x-text="StoreSDK.utils.toCurrency(state.coupon.value)"></span>
                </p>
            </div>
        </section>
        <section class="checkout-product-shipping_price" x-show="state.shippingSelected.code" :class="{ 'd-hide': state.shippingSelected.toCombine }">
            <div class="checkout-product-left">
                <p class="checkout-product-title">
                    Custo do frete
                </p>
            </div>
            <div class="checkout-product-right">
                <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(getShippingTotal())"></p>
            </div>
        </section>

        <!-- Acréscimo da forma de pagamento: Com Frete selecionado / Pegando as informações do checkout -->
        <template x-if="state.shippingSelected.code && getTaxValue() > 0">
            <section class="checkout-product-payment_price" data-info="checkout">
                <div class="checkout-product-left">
                    <p class="checkout-product-title">Acréscimo da forma de pagamento</p>
                </div>
                <div class="checkout-product-right">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(getTaxValue())"></p>
                </div>
            </section>
        </template>

        <!-- Acréscimo da forma de pagamento: Sem Frete selecionado / Pegando as informações do cart -->
        <template x-if="!state.shippingSelected.code && (state.currentStep === 'shipping') && (state.cart.tax > 0)">
            <section class="checkout-product-payment_price" data-info="cart">
                <div class="checkout-product-left">
                    <p class="checkout-product-title">Acréscimo da forma de pagamento</p>
                </div>
                <div class="checkout-product-right">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(state.cart.tax)"></p>
                </div>
            </section>
        </template>

        <section class="checkout-product-total">
            <div class="checkout-product-left">
                <p class="checkout-product-title">
                    Total
                </p>
            </div>

            <!-- Total: Com Frete selecionado / Pegando as informações do checkout -->
            <template x-if="state.shippingSelected.code">
                <div class="checkout-product-right" data-info="checkout">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(getTotal())"></p>
                </div>
            </template>

            <!-- Total: Sem Frete selecionado / Pegando as informações do cart -->
            <template x-if="!state.shippingSelected.code && (state.currentStep === 'shipping') && (state.cart.tax !==0)">
                <div class="checkout-product-right" data-info="cart">
                    <p class="checkout-product-price" x-text="StoreSDK.utils.toCurrency(state.cart.totalWithoutTax + state.cart.tax)"></p>
                </div>
            </template>

        </section>
        <section class="checkout-product-coupon" checkout-product-total x-show="state.shippingSelected.code && state.shippingAddress.zipcode">
            <div class="form-group" x-show="!state.coupon.show">
                <a class="btn btn-block btn-checkout-coupon" href="javascript:void(0)" title="Clique para informar o cupom"
                    @click="handleShowCoupon()">
                    Possui cupom de desconto?
                </a>
            </div>
            <div class="columns checkout-product-coupon_new" x-show="state.coupon.show && !state.coupon.applied">
                <div class="col-8">
                    <div class="form-group form-group_custom">
                        <label class="form-label">Digite o código do cupom</label>
                        <input
                            class="form-input"
                            :class="{ 'is-error': !!errors.coupon, 'onFocus': !state.coupon.code }"
                            name="coupon-code"
                            type="text"
                            @keydown.enter="handleCouponApply()"
                            x-model="state.coupon.code">
                        <p
                            x-show="errors.coupon"
                            class="form-input-hint"
                            x-text="errors.coupon"
                        >
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <a class="btn btn-block" href="javascript:void(0)" title="Clique para aplicar o cupom"
                            :disabled="!state.coupon.code" @click="handleCouponApply()">
                            Aplicar
                        </a>
                    </div>
                </div>
            </div>
            <div class="form-group" x-show="state.coupon.applied">
                <a class="btn btn-block btn-checkout-coupon" href="javascript:void(0)" title="Clique para alterar o cupom"
                    @click="handleChangeCoupon()">
                    Alterar cupom de desconto?
                </a>
            </div>
        </section>
    </div>
</div>
<div class="card checkout-card checkout-card-summary_info" x-show="state.currentStep == 'payment'">
    <div class="card-header">
        <div class="card-title">Forma de entrega</div>
        <a @click.debounce.500="handleReturnToShipping()">Editar</a>
    </div>
    <div class="card-body">
        <p x-text="state.shippingSelected.name" class="card-subtitle"></p>
    </div>
    <div class="card-header">
        <div class="card-title">Dados de entrega</div>
        <a @click.debounce.500="handleReturnToShipping()">Editar</a>
    </div>
    <div class="card-body">
        <p class="card-subtitle">
            <span x-text="state.shippingAddress.receiver"></span>
            <span x-show="state.customer.document && state.shippingAddress.receiver && !state.isSameBillingAddress"> - </span>
            <span x-show="(state.customer.document) && (state.customer.document.replace(/\D/g, '').length < 12) && !state.isSameBillingAddress">CPF: </span>
            <span x-show="(state.customer.document) && (state.customer.document.replace(/\D/g, '').length > 12) && !state.isSameBillingAddress">CNPJ: </span>
            <span x-show="!state.isSameBillingAddress" x-text="state.customer.document" data-mask='["###.###.###-##", "##.###.###/####-##"]'></span>
        </p>
        <p class="card-subtitle">
            <span x-text="state.customer.phone" data-mask='["(##) #####-####", "(##) ####-####"]'></span>
        </p>
        <p class="card-subtitle">
            <span x-text="state.shippingAddress.street"></span>
            <span x-show="state.shippingAddress.number">,</span>
            <span x-text="state.shippingAddress.number"></span>
        </p>
        <p class="card-subtitle">
            <span x-show="state.shippingAddress.zipcode">CEP: </span>
            <span x-text="state.shippingAddress.zipcode" data-mask='["#####-###", "##########"]'></span>
        </p>
        <p class="card-subtitle">
            <span x-text="state.shippingAddress.city"></span>
            <span x-show="state.shippingAddress.state">, </span>
            <span x-text="state.shippingAddress.state"></span>
            <span>.</span>
        </p>
    </div>
    <template x-if="state.isSameBillingAddress">
        <div class="card-header">
            <div class="card-title">Dados do comprador</div>
            <a @click.debounce.500="handleReturnToShipping()">Editar</a>
        </div>
        <div class="card-body">
            <p class="card-subtitle">
                <span x-text="state.customer.address.receiver"></span>
                <span x-show="state.customer.document && state.customer.address.receiver"> - </span>
                <span x-show="(state.customer.document) && (state.customer.document.replace(/\D/g, '').length < 12) && state.isSameBillingAddress">CPF: </span>
                <span x-show="(state.customer.document) && (state.customer.document.replace(/\D/g, '').length > 12) && state.isSameBillingAddress">CNPJ: </span>
                <span x-show="state.isSameBillingAddress" x-text="state.customer.document" data-mask='["###.###.###-##", "##.###.###/####-##"]'></span>
            </p>
            <p class="card-subtitle">
                <span x-text="state.customer.secondaryPhone" data-mask='["(##) #####-####", "(##) ####-####"]'></span>
            </p>
            <p class="card-subtitle">
                <span x-text="state.customer.address.street"></span>
                <span x-show="state.customer.address.number">,</span>
                <span x-text="state.customer.address.number"></span>
            </p>
            <p class="card-subtitle">
                <span x-show="state.customer.address.zipcode">CEP: </span>
                <span x-text="state.customer.address.zipcode" data-mask='["#####-###", "##########"]'></span>
            </p>
            <p class="card-subtitle">
                <span x-text="state.customer.address.city"></span>
                <span x-show="state.customer.address.state">, </span>
                <span x-text="state.customer.address.state"></span>
                <span>.</span>
            </p>
        </div>
    </template>
</div>
