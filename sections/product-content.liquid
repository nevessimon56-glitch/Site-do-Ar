        <script>
        (function () {
          var VISIBLE = 4;

          function getGap(list) {
            var styles = window.getComputedStyle(list);
            return parseFloat(styles.columnGap || styles.gap || '8') || 8;
          }

          function layoutThumbs(wrap) {
            var viewport = wrap.querySelector('.product-pdp-thumbs_viewport');
            var list = wrap.querySelector('.product-pdp-thumbs_list');
            if (!viewport || !list) return;
            var items = list.querySelectorAll('.product-gallery_item');
            if (!items.length) return;
            var gap = getGap(list);
            var viewW = viewport.clientWidth;
            if (viewW < 1) return;
            var thumbW = (viewW - gap * (VISIBLE - 1)) / VISIBLE;
            thumbW = Math.max(48, thumbW);
            viewport.style.setProperty('--pdp-thumb-w', thumbW + 'px');
            items.forEach(function (item) {
              item.style.flex = '0 0 ' + thumbW + 'px';
              item.style.width = thumbW + 'px';
              item.style.maxWidth = thumbW + 'px';
            });
            var listW = items.length * thumbW + Math.max(0, items.length - 1) * gap;
            list.style.width = listW + 'px';
            list.style.minWidth = listW + 'px';
            list.style.maxWidth = 'none';
          }

          function scrollThumbs(wrap, dir) {
            var viewport = wrap.querySelector('.product-pdp-thumbs_viewport');
            var list = wrap.querySelector('.product-pdp-thumbs_list');
            if (!viewport || !list) return;
            layoutThumbs(wrap);
            var item = list.querySelector('.product-gallery_item');
            if (!item) return;
            var gap = getGap(list);
            var step = item.getBoundingClientRect().width + gap;
            var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
            var target = viewport.scrollLeft + dir * step;
            if (target < 0) target = 0;
            if (target > maxScroll) target = maxScroll;
            if (viewport.scrollTo) {
              try {
                viewport.scrollTo({ left: target, behavior: 'smooth' });
              } catch (err) {
                viewport.scrollLeft = target;
              }
            } else {
              viewport.scrollLeft = target;
            }
            window.setTimeout(function () { syncNav(wrap); }, 280);
          }

          function syncNav(wrap) {
            var viewport = wrap.querySelector('.product-pdp-thumbs_viewport');
            var list = wrap.querySelector('.product-pdp-thumbs_list');
            if (!viewport || !list) return;
            layoutThumbs(wrap);
            var items = list.querySelectorAll('.product-gallery_item');
            var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
            var left = viewport.scrollLeft;
            var needsCarousel = items.length > VISIBLE || maxScroll > 1;
            wrap.classList.toggle('product-pdp-thumbs_carousel--static', !needsCarousel);
            wrap.classList.toggle('product-pdp-thumbs_carousel--start', needsCarousel && left <= 1);
            wrap.classList.toggle('product-pdp-thumbs_carousel--end', needsCarousel && left >= maxScroll - 1);
          }

          function setActiveThumb(list, index) {
            list.querySelectorAll('.product-gallery_link').forEach(function (link) {
              link.classList.toggle('image-main', link.getAttribute('data-index') === String(index));
            });
          }

          function scrollActiveThumbIntoView(wrap) {
            var viewport = wrap.querySelector('.product-pdp-thumbs_viewport');
            var list = wrap.querySelector('.product-pdp-thumbs_list');
            if (!viewport || !list) return;
            var active = list.querySelector('.product-gallery_link.image-main');
            if (!active) return;
            var item = active.closest('.product-gallery_item');
            if (!item) return;
            var pad = 2;
            var itemLeft = item.offsetLeft;
            var itemRight = itemLeft + item.offsetWidth;
            var viewLeft = viewport.scrollLeft;
            var viewRight = viewLeft + viewport.clientWidth;
            var target = null;
            if (itemLeft < viewLeft) target = itemLeft - pad;
            else if (itemRight > viewRight) target = itemRight - viewport.clientWidth + pad;
            if (target == null) return;
            if (viewport.scrollTo) {
              try {
                viewport.scrollTo({ left: target, behavior: 'smooth' });
              } catch (err) {
                viewport.scrollLeft = target;
              }
            } else {
              viewport.scrollLeft = target;
            }
          }

          function bindCarousel(wrap) {
            if (wrap.dataset.pdpThumbsReady === '1') return;
            wrap.dataset.pdpThumbsReady = '1';
            var viewport = wrap.querySelector('.product-pdp-thumbs_viewport');
            var list = wrap.querySelector('.product-pdp-thumbs_list');
            if (!viewport || !list) return;

            wrap.addEventListener('click', function (event) {
              var navBtn = event.target.closest('[data-pdp-thumb-nav]');
              if (!navBtn || !wrap.contains(navBtn)) return;
              event.preventDefault();
              event.stopPropagation();
              var dir = parseInt(navBtn.getAttribute('data-pdp-thumb-nav'), 10);
              if (dir === -1 || dir === 1) scrollThumbs(wrap, dir);
            });

            viewport.addEventListener('scroll', function () { syncNav(wrap); }, { passive: true });
            window.addEventListener('resize', function () { syncNav(wrap); });
            list.addEventListener('click', function (event) {
              var link = event.target.closest('.product-gallery_link');
              if (!link || !list.contains(link)) return;
              var idx = link.getAttribute('data-index');
              if (idx != null) setActiveThumb(list, idx);
              window.setTimeout(function () { scrollActiveThumbIntoView(wrap); }, 80);
            });
            list.querySelectorAll('img').forEach(function (img) {
              if (!img.complete) img.addEventListener('load', function () { syncNav(wrap); }, { once: true });
            });
            if (typeof ResizeObserver !== 'undefined') {
              new ResizeObserver(function () { syncNav(wrap); }).observe(viewport);
            }
            syncNav(wrap);
          }

          function initPdpThumbsCarousel() {
            var root = document.getElementById('product-pdp-v2');
            if (!root) return;
            root.querySelectorAll('[data-pdp-thumbs-carousel]').forEach(function (wrap) {
              wrap.removeAttribute('data-pdp-thumbs-ready');
              bindCarousel(wrap);
            });

            if (!window.__pdpThumbsOnChangeWrapped) {
              window.__pdpThumbsOnChangeWrapped = true;
              var prevOnChange = window.onChangeProductGallery;
              window.onChangeProductGallery = function (index, url1200, url800) {
                if (typeof prevOnChange === 'function') {
                  prevOnChange(index, url1200, url800);
                }
                var pdpRoot = document.getElementById('product-pdp-v2');
                if (!pdpRoot) return;
                pdpRoot.querySelectorAll('[data-pdp-thumbs-carousel]').forEach(function (wrap) {
                  var list = wrap.querySelector('.product-pdp-thumbs_list');
                  if (list) setActiveThumb(list, index);
                  scrollActiveThumbIntoView(wrap);
                  window.setTimeout(function () { syncNav(wrap); }, 120);
                });
              };
            }
          }

          window.__pdpThumbNav = function (btn, dir) {
            var wrap = btn && btn.closest ? btn.closest('[data-pdp-thumbs-carousel]') : null;
            if (wrap) scrollThumbs(wrap, dir);
            return false;
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPdpThumbsCarousel);
          } else {
            initPdpThumbsCarousel();
          }
          window.addEventListener('load', initPdpThumbsCarousel);
          window.initPdpThumbsCarousel = initPdpThumbsCarousel;
        })();
        </script>
