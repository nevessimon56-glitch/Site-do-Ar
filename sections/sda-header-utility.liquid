{% comment %} Barra superior discreta — Fase 2 conversão {% endcomment %}
<div class="sda-header-utility hide-lg" role="region" aria-label="Atendimento e conta">
  <div class="sda-header-utility__inner container">
    <div class="sda-header-utility__left">
      {% if store.phone.size > 0 %}
        {% assign linkPhone = 'tel:+'| append: store.phone %}
        {% assign textPhone = store.phone | maskTel %}
        <a class="sda-header-utility__link" href="{{ linkPhone }}" title="Telefone">{{ textPhone }}</a>
      {% endif %}
      <a class="sda-header-utility__link sda-header-utility__link--wa" href="javascript:void(0);" onclick="sendWhatsPlugin()" title="WhatsApp">WhatsApp</a>
      <span class="sda-header-utility__sep" aria-hidden="true">·</span>
      <span class="sda-header-utility__kicker">Atendimento especializado</span>
    </div>
    <div class="sda-header-utility__right">
      <a class="sda-header-utility__link" href="javascript:void(0)" title="Entre ou cadastre-se" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">Entre ou cadastre-se</a>
    </div>
  </div>
</div>
