<header class="header">
    <div class="top-content content" style="background-color: {{ themeConfig.store.bannerTop.backgroundColor }};">
        <a href="{{ themeConfig.store.bannerTop.link }}" title="{{ themeConfig.store.bannerTop.title }}">
            {% if themeConfig.store.bannerTop.image %}
                <img class="hide-lg" style="max-width: 100%;" src="{{ themeConfig.store.bannerTop.image }}" alt="{{ themeConfig.store.bannerTop.title }}"/>
            {% endif %}
            {% if themeConfig.store.bannerTop.image.desktop %}
                <img class="hide-lg" style="max-width: 100%;" src="{{ themeConfig.store.bannerTop.image.desktop }}" alt="{{ themeConfig.store.bannerTop.title }}"/>
            {% endif %}
            {% if themeConfig.store.bannerTop.image.mobile %}
                <img class="show-lg" style="max-width: 100%;" src="{{ themeConfig.store.bannerTop.image.mobile }}" alt="{{ themeConfig.store.bannerTop.title }}"/>
            {% endif %}
        </a>
    </div>
    <div class="header-content content">
        <div class="container">
            <div class="navbar">
                <div class="navbar-section">
                    <a class="logo" href="/" title="{{ store.name }}">
                        <h1>{{ store.name }}</h1>
                        {% if  theme.logo.path %}
                            <picture>
                                <img class="lazy" data-src="{{ theme.logo.path | imgUrl: 260 }}" alt="{% if theme.logo.title and theme.logo.title != '' %}{{ theme.logo.title }}{% else %}{{ store.name }}{% endif %}">
                            </picture>
                        {% else %}
                            {{ themeConfig.icons.image }}
                        {% endif %}
                    </a>
                </div>
                <div class="navbar-center">
                    {% if themeConfig.account.type != 'disabled' %}
                        <div class="header-box header-box_account header-box-account-info hide-lg">
                            <div class="header-link header-link_account header-link-account_info">
                                <a  class="header-link_icon" href="javascript:void(0)" title="Acesse sua conta"
                                    onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                    {{ themeConfig.icons.user }}
                                </a>
                                <template x-if="data.isLogged">
                                    <div class="header-link_text header-link_text__logged">
                                        <a class="account_link" href="javascript:void(0)" x-bind:title="`${data.user ? data.user : 'visitante'}`" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                            Olá,
                                            <span x-text="`${data.user ? data.user : 'Olá, visitante'}`"></span>
                                        </a>
                                        <a class="account_link account_link__logout" href="javascript:void(0)" title="Logout" @click="headerLogout()">
                                            Logout
                                        </a>
                                    </div>
                                </template>
                                <template x-if="!data.isLogged">
                                    <div class="header-link_text">
                                        <a class="account_link" href="javascript:void(0)" title="Olá visitante" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                            Olá visitante,
                                        </a>
                                        <a class="account_link" href="javascript:void(0)" title="Entre ou Cadastre-se" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                            Entre ou Cadastre-se
                                        </a>
                                    </div>
                                </template>
                            </div>
                        </div>
                    {% endif %}
                    <div class="search-desktop hide-lg">
                        <form id="myForm2" method="POST" action="">
                            <div class="input-group">
                                <input type="search" id="term2" class="form-input" placeholder="O que deseja buscar?">
                                <button class="btn" title="Enviar" onclick="alterForm2()">
                                    {{ themeConfig.icons.search }}
                                </button>
                            </div>
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        </form>
                    </div>
                </div>
                <div class="navbar-section">
                    <a class="header-link header-link_search search_link show-lg" href="javascript:void(0)" title="Busca" onclick="openSearch()">
                        <div class="icon-search">
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </div>
                    </a>
                    {% assign numberWhats = '' %}
                    {% for script in scripts.footer %}
                        {% if script.slug and script.slug == 'whatsapp' and script.config.number %}
                            {% assign numberWhats = script.config.number %}
                        {% endif %}
                    {% endfor %}
                    {% if numberWhats != '' %}
                        <div class="header-box header-box_whatsapp hide-lg">
                            <div class="header-link header-link_whatsapp">
                                <a  class="header-link_icon" href="javascript:void(0);" onclick="sendWhatsPlugin()">
                                    {{ themeConfig.icons.whatsapp }}
                                </a>
                            </div>
                        </div>
                    {% endif %}
                    {% if store.phone.size > 0 %}
                        {% assign linkPhone = 'tel:+'| append: store.phone %}
                        {% assign textPhone = store.phone | maskTel %}
                        <div class="header-box header-box_account header-box-account_tel hide-lg">
                            <div class="header-link header-link_account header-link-account_tel">
                                <a  class="header-link_icon" href="{{ linkPhone }}" title="Fale conosco">
                                    {{ themeConfig.icons.contactHeader }}
                                </a>
                                <div class="header-link_text">
                                    <a class="account_link" href="{{ linkPhone }}" title="Fale conosco">
                                        Fale conosco
                                    </a>
                                    <a class="account_link" href="{{ linkPhone }}" title="Fale conosco">
                                        {{ textPhone }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if themeConfig.cart.type == 'default' %}
                        <a class="header-link header-link_cart cart_link" href="javascript:void(0)" title="Carrinho" {% if themeConfig.buyAction.type == "login" %}@click="openSideNavOverlayCartB2B()"{% else %}onclick="openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: true})"{% endif %}>
                            {{ themeConfig.icons.cart }}
                            {% assign cartQtd = 0 %}
                            {% if cart.quantity %}
                                {% assign cartQtd = cart.quantity %}
                            {% endif %}
                            <span class="cart_quantity" data-cart-quantity>{{ cartQtd }}</span>
                        </a>
                    {% endif %}
                    <a class="header-link header-link_menu__mobile menu-mobile_link" href="javascript:void(0)" title="Menu Mobile" onclick="openNavMobile()">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </a>
                </div>
            </div>
            <!-- Search -->
            <div class="search close">
                <form id="myForm" method="POST" action="">
                    <div class="input-group">
                        <input type="search" id="term" class="form-input" placeholder="Buscar produtos">
                        <button class="btn" title="Enviar" onclick="alterForm()">
                            {{ themeConfig.icons.search }}
                        </button>
                    </div>
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                </form>
            </div>
        </div>
    </div>
    <div class="nav-content content hide-lg">
        <div class="container">
            <nav class="nav-main">
                {% for menuItem in menu.items limit: 7 %}
                    <div class="nav-main_item dropdown">
                        <a href="{{ menuItem.link }}" class="nav-main_link dropdown-toggle" tabindex="0" title="{{ menuItem.name }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                            <div class="nav-main-box_link">
                                {% if menuItem.iconSvg %}
                                    <div class="nav-main_icon nav-main-icon_svg">
                                        {{ menuItem.iconSvg }}
                                    </div>
                                {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                    <div class="nav-main_icon nav-main-icon_img">
                                        <picture>
                                            <img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuItem.name }}">
                                        </picture>
                                    </div>
                                {% endif %}
                                <div class="nav-main_text">{{ menuItem.name }}</div>
                                {% if menuItem.items.size > 0 %}
                                    <div class="nav-main_arrow">
                                        {{ themeConfig.icons.arrow.down }}
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        {% if menuItem.items.size > 0 %}
                            <div class="nav-main_content dropdown-content">
                                {% assign limitMenuChildren = 6 %}
                                {% assign limitMenuAll = limitMenuChildren | times: 6 %}
                                {% assign startMenuChildren = 1 %}
                                {% assign endMenuChildren = startMenuChildren | times: limitMenuChildren %}
                                {% for menuChildrenItem1 in menuItem.items limit:limitMenuAll %}
                                    {% if forloop.index == startMenuChildren %}
                                        <ul>
                                    {% endif %}
                                    <li class="nav-children dropdown">
                                        <a class="nav-main_children" title="{{ menuChildrenItem1.name }}" href="{{ menuChildrenItem1.link }}"{% if menuChildrenItem1.newTab == true %} target="_blank"{% endif %}>
                                            {{ menuChildrenItem1.name }}
                                        </a>
                                        {% if menuChildrenItem1.items.size > 0 %}
                                            <div class="nav-main_content nav-main_content__children dropdown-content">
                                                {% assign limitMenuChildren1 = 6 %}
                                                {% assign limitMenuAll1 = limitMenuChildren1 | times: 5 %}
                                                {% assign startMenuChildren1 = 1 %}
                                                {% assign endMenuChildren1 = startMenuChildren1 | times: limitMenuChildren1 %}

                                                {% for menuChildrenItem2 in menuChildrenItem1.items %}

                                                    {% if forloop.index == startMenuChildren1 %}
                                                        <ul>
                                                    {% endif %}
                                                    <li class="nav-children dropdown">
                                                        <a class="nav-main_children" href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}"{% if menuChildrenItem2.newTab == true %} target="_blank"{% endif %}>
                                                            {{ menuChildrenItem2.name }}
                                                        </a>
                                                        {% if menuChildrenItem2.items.size > 0 %}
                                                            <div class="nav-main_content nav-main_content__children dropdown-content">
                                                                <ul>
                                                                    {% for menuChildrenItem3 in menuChildrenItem2.items %}
                                                                        <li class="nav-children dropdown">
                                                                            <a class="nav-main_children" href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}"{% if menuChildrenItem3.newTab == true %} target="_blank"{% endif %}>
                                                                                {{ menuChildrenItem3.name }}
                                                                            </a>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            </div>
                                                        {% endif %}
                                                    </li>
                                                    {% if forloop.index == endMenuChildren1 or forloop.last %}
                                                        </ul>
                                                        {% assign startMenuChildren1 = endMenuChildren1 | plus: 1 %}
                                                        {% assign endMenuChildren1 = endMenuChildren1 | plus: limitMenuChildren %}
                                                    {% endif %}
                                                {% endfor %}

                                            </div>
                                        {% endif %}
                                    </li>
                                    {% if forloop.index == endMenuChildren or forloop.last %}
                                        </ul>
                                        {% assign startMenuChildren = endMenuChildren | plus: 1 %}
                                        {% assign endMenuChildren = endMenuChildren | plus: limitMenuChildren %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </nav>
        </div>
    </div>
    <!-- Nav Mobile -->
    <nav class="sidebar-nav show-lg">
        {% if themeConfig.account.type != 'disabled' %}
            <div class="sidebar-nav-header">
                <div class="sidebar-nav-account">
                <span class="sidebar-nav-icon account_link">
                    {{ themeConfig.icons.user }}
                </span>
                    <template x-if="data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link sidebar-nav-link_user account_link" href="javascript:void(0)" x-bind:title="`${data.user ? data.user : 'visitante'}`"
                               x-text="`Olá ${data.user ? data.user : 'visitante'}`" onclick="openSideNavOverlay('.sidenav-overlay_account', true)"></a>
                            <a class="sidebar-nav-link sidebar-nav-link_logout" href="javascript:void(0)" title="Logout" @click="headerLogout()">Logout</a>
                        </div>
                    </template>
                    <template x-if="!data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link account_link" href="javascript:void(0)" title="Login ou Cadastre-se" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                Login ou Cadastre-se
                            </a>
                        </div>
                    </template>
                </div>
            </div>
        {% endif %}
        <div class="sidebar-nav-content content">
            <div>
                <ul class="nav-mobile metismenu" id="nav-mobile">
                    {% for menuItem in menu.items %}
                        <li class="nav-mobile_item">
                            {% assign classArrowItem = '' %}
                            {% if menuItem.items.size > 0 %}
                                {% assign classArrowItem = ' has-arrow' %}
                            {% endif %}
                            <div class="nav-mobile_link{{ classArrowItem }}" aria-expanded="false">
                                <p>
                                    <a href="{{ menuItem.link }}" title="{{ menuItem.name }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                                        <div class="nav-mobile-box_link">
                                            {% if menuItem.iconSvg %}
                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                    {{ menuItem.iconSvg }}
                                                </div>
                                            {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                    <picture>
                                                        <img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuItem.name }}">
                                                    </picture>
                                                </div>
                                            {% endif %}
                                            <div class="nav-mobile_text">
                                                {{ menuItem.name }}
                                            </div>
                                        </div>
                                    </a>
                                </p>
                            </div>
                            {% if menuItem.items.size > 0 %}
                                <ul>
                                    {% for menuChildrenItem1 in menuItem.items %}
                                        <li>
                                            {% assign classArrowChildren1 = '' %}
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                {% assign classArrowChildren1 = ' has-arrow' %}
                                            {% endif %}
                                            <div class="nav-mobile_link{{ classArrowChildren1 }}" aria-expanded="false">
                                                <p>
                                                    <a href="{{ menuChildrenItem1.link }}" title="{{ menuChildrenItem1.name }}"{% if menuChildrenItem1.newTab == true %} target="_blank"{% endif %}>
                                                        <div class="nav-mobile-box_link">
                                                            {% if menuChildrenItem1.iconSvg %}
                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                    {{ menuChildrenItem1.iconSvg }}
                                                                </div>
                                                            {% elsif menuChildrenItem1.icon and menuChildrenItem1.icon.file and menuChildrenItem1.icon.file.url %}
                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                    <picture>
                                                                        <img class="lazy" data-src="{{ menuChildrenItem1.icon.file.url }}" alt="{{ menuChildrenItem1.name }}">
                                                                    </picture>
                                                                </div>
                                                            {% endif %}
                                                            <div class="nav-mobile_text">
                                                                {{ menuChildrenItem1.name }}
                                                            </div>
                                                        </div>
                                                    </a>
                                                </p>
                                            </div>
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                <ul>
                                                    {% for menuChildrenItem2 in menuChildrenItem1.items %}
                                                        <li>
                                                            {% assign classArrowChildren2 = '' %}
                                                            {% if menuChildrenItem2.items.size > 0 %}
                                                                {% assign classArrowChildren2 = ' has-arrow' %}
                                                            {% endif %}
                                                            <div class="nav-mobile_link{{ classArrowChildren2 }}" aria-expanded="false">
                                                                <p>
                                                                    <a href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}"{% if menuChildrenItem2.newTab == true %} target="_blank" {% endif %}>
                                                                        <div class="nav-mobile-box_link">
                                                                            {% if menuChildrenItem2.isSvg %}
                                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                                    {{ menuChildrenItem2.iconSvg }}
                                                                                </div>
                                                                            {% elsif menuChildrenItem2.icon and menuChildrenItem2.icon.file and menuChildrenItem2.icon.file.url %}
                                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                                    <picture>
                                                                                        <img class="lazy" data-src="{{ menuChildrenItem2.icon.file.url }}" alt="{{ menuChildrenItem2.name }}">
                                                                                    </picture>
                                                                                </div>
                                                                            {% endif %}
                                                                            <div class="nav-mobile_text">
                                                                                {{ menuChildrenItem2.name }}
                                                                            </div>
                                                                        </div>
                                                                    </a>
                                                                </p>
                                                            </div>
                                                            {% if menuChildrenItem2.items.size > 0 %}
                                                                <ul>
                                                                    {% for menuChildrenItem3 in menuChildrenItem2.items %}
                                                                        <li>
                                                                            <div class="nav-mobile_link" aria-expanded="false">
                                                                                <p>
                                                                                    <a href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}"{% if menuChildrenItem3.newTab == true %} target="_blank"{% endif %}>
                                                                                        <div class="nav-mobile-box_link">
                                                                                            {% if menuChildrenItem3.isSvg %}
                                                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                                                    {{ menuChildrenItem3.iconSvg }}
                                                                                                </div>
                                                                                            {% elsif menuChildrenItem3.icon and menuChildrenItem3.icon.file and menuChildrenItem3.icon.file.url %}
                                                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                                                    <picture>
                                                                                                        <img class="lazy" data-src="{{ menuChildrenItem3.icon.file.url }}" alt="{{ menuChildrenItem3.name }}">
                                                                                                    </picture>
                                                                                                </div>
                                                                                            {% endif %}
                                                                                            <div class="nav-mobile_text">
                                                                                                {{ menuChildrenItem3.name }}
                                                                                            </div>
                                                                                        </div>
                                                                                    </a>
                                                                                </p>
                                                                            </div>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </nav>
    <script>
        function alterForm() {
            var input = document.getElementById("term").value;
            if (input.length > 0) {
                document.getElementById("myForm").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
            } else {
                document.getElementById("myForm").addEventListener('submit', function(e){
                    e.preventDefault();
                }, false);
                window.location.href = `${window.location.protocol}//${window.location.host}/busca/`;
            }
        }

        function alterForm2() {
            var input = document.getElementById("term2").value;
            if (input.length > 0) {
                document.getElementById("myForm2").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
            } else {
                document.getElementById("myForm2").addEventListener('submit', function(e){
                    e.preventDefault();
                }, false);
                window.location.href = `${window.location.protocol}//${window.location.host}/busca/`;
            }
        }
    </script>
</header>
