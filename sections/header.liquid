    <script>
        function alterForm() {
            var input = document.getElementById("term").value;
            if (input.length > 0) {
                document.getElementById("myForm").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
            } else {
                document.getElementById("myForm").addEventListener('submit', function(e){
                    e.preventDefault();
                }, false);
                window.location.href = window.location.protocol + '//' + window.location.host + '/busca/';
            }
        }

        function alterForm2() {
            var inputEl = document.getElementById('term2');
            var formEl = document.getElementById('myForm2');
            if (!inputEl || !formEl) return;
            var input = inputEl.value;
            if (input.length > 0) {
                formEl.action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
                formEl.submit();
            } else {
                window.location.href = window.location.protocol + '//' + window.location.host + '/busca/';
            }
        }

        function alterForm2Desktop() {
            var inputEl = document.getElementById('term2Desktop');
            var formEl = document.getElementById('myForm2Desktop');
            if (!inputEl || !formEl) return;
            var input = inputEl.value;
            if (input.length > 0) {
                formEl.action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
                formEl.submit();
            } else {
                window.location.href = window.location.protocol + '//' + window.location.host + '/busca/';
            }
        }

        function headerV2FocusMobileSearch() {
            var input = document.getElementById('term2');
            if (!input) {
                openSearch();
                return;
            }
            input.focus();
            try {
                input.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } catch (e) {}
        }
    </script>


<style>
/* Site do Ar — redesign visual do header v2 (escopado) */
.header.header-v2 {
