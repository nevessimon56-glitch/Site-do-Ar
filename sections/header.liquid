{% comment %}
  Header v2 — Site do Ar
  Substituir o header.liquid padrão do tema WDNA por este arquivo.
{% endcomment %}

{% assign iconSearchFallback = '<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16a6.471 6.471 0 0 0 3.23-.86l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>' %}
{% assign iconHeadset = '<svg class="header-utility__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v4a2 2 0 0 0 2 2h1v-5H4zm14 3h1a2 2 0 0 0 2-2v-4h-3v6zM12 4a4 4 0 0 0-4 4v5h8V8a4 4 0 0 0-4-4z"/></svg>' %}
{% assign iconBoxUtility = '<svg class="header-utility__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14v12H5V8z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg>' %}
{% assign iconBoxOutline = '<svg class="sda-ico-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5 12 3l8 4.5V18l-8 4.5L4 18V7.5z"/><path d="M4 7.5 12 12l8-4.5M12 12v10.5"/></svg>' %}
{% assign iconUser = '<svg class="header-utility__svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.25"/><path d="M6 20v-0.5c0-3 2.7-4.5 6-4.5s6 1.5 6 4.5V20"/></svg>' %}
{% assign iconHeartOutline = '<svg class="sda-ico-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-6.2-3.9-6.2-8.6c0-2.4 1.9-4.3 4.2-4.3 1.4 0 2.7.7 3.5 1.8.8-1.1 2.1-1.8 3.5-1.8 2.3 0 4.2 1.9 4.2 4.3 0 4.7-6.2 8.6-6.2 8.6z"/></svg>' %}
{% assign iconCartOutline = '<svg class="sda-ico-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 9.2h11.3L21 7H7"/><circle cx="10" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>' %}
{% assign iconHome = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>' %}
{% assign iconTag = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58s1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>' %}

<header class="header header-v2">
    <div class="header-utility content">
        <div class="container header-utility__inner">
            <ul class="header-utility__links">
                <li>
                    <a href="https://api.whatsapp.com/send/?phone=5519984176960&text&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer" title="Atendimento">
                        <span class="header-utility__icon">{{ iconHeadset }}</span>
                        <span class="header-utility__label">Atendimento</span>
                    </a>
                </li>
                <li>
                    <a href="/pedidos" title="Meus pedidos">
                        <span class="header-utility__icon">{{ iconBoxUtility }}</span>
                        <span class="header-utility__label">Meus pedidos</span>
                    </a>
                </li>
            </ul>
            {% if themeConfig.account.type != 'disabled' %}
                <button type="button" class="header-utility__account" onclick="openSideNavOverlay('.sidenav-overlay_account', true)"
                    x-bind:title="data.isLogged ? (data.user ? 'Olá, ' + data.user : 'Minha conta') : 'Entre ou cadastre-se'">
                    <span class="header-utility__icon">{{ iconUser }}</span>
                    <span class="header-utility__label" x-show="data.isLogged" x-cloak x-text="utilityGreeting()"></span>
                    <span class="header-utility__label" x-show="!data.isLogged" x-cloak>Entre ou cadastre-se</span>
                </button>
            {% endif %}
        </div>
    </div>

    <div class="header-content content">
        <div class="container">
            <div class="navbar header-v2-navbar">
                <div class="navbar-section">
                    <a class="logo" href="/" title="{{ store.name }}">
                        <h1>{{ store.name }}</h1>
                        {% if theme.logo.path %}
                            <picture>
                                <img class="lazy" data-src="{{ theme.logo.path | imgUrl: 260 }}" alt="{% if theme.logo.title and theme.logo.title != '' %}{{ theme.logo.title }}{% else %}{{ store.name }}{% endif %}">
                            </picture>
                        {% else %}
                            {{ themeConfig.icons.image }}
                        {% endif %}
                    </a>
                </div>

                <div class="header-v2-search search-desktop hide-lg">
                    <form id="myForm2" method="POST" action="">
                        <div class="input-group">
                            <input type="search" id="term2" class="form-input" placeholder="Busque por produto, marca ou modelo" autocomplete="off">
                            <button class="btn" type="button" title="Buscar" onclick="alterForm2()">
                                {% if themeConfig.icons.search %}{{ themeConfig.icons.search }}{% else %}{{ iconSearchFallback }}{% endif %}
                            </button>
                        </div>
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    </form>
                </div>

                <div class="header-v2-actions hide-lg">
                    <a class="header-v2-action" href="/pedidos" title="Meus pedidos">
                        <span class="header-v2-action__icon">{{ iconBoxOutline }}</span>
                        <span class="header-v2-action__label">Meus pedidos</span>
                    </a>
                    <a class="header-v2-action" href="/pagina/favoritos" title="Favoritos">
                        <span class="header-v2-action__icon">{{ iconHeartOutline }}</span>
                        <span class="header-v2-action__label">Favoritos</span>
                        <span class="header-v2-action__badge" data-favorites-count data-count="0">0</span>
                    </a>
                    {% if themeConfig.cart.type == 'default' %}
                        {% assign cartQtd = 0 %}
                        {% if cart.quantity %}
                            {% assign cartQtd = cart.quantity %}
                        {% endif %}
                        <a class="header-v2-action header-v2-action--cart" href="javascript:void(0)" title="Carrinho" {% if themeConfig.buyAction.type == "login" %}@click="openSideNavOverlayCartB2B()"{% else %}onclick="openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: true})"{% endif %}>
                            <span class="header-v2-action__icon">{{ iconCartOutline }}</span>
                            <span class="header-v2-action__label">Carrinho</span>
                            <span class="header-v2-action__badge cart_quantity" data-cart-quantity>{{ cartQtd }}</span>
                        </a>
                    {% endif %}
                </div>

                <div class="navbar-section header-v2-mobile-tools show-lg">
                    <a class="header-v2-action header-v2-action--compact" href="/pagina/favoritos" title="Favoritos">
                        <span class="header-v2-action__icon">{{ iconHeartOutline }}</span>
                        <span class="header-v2-action__badge" data-favorites-count data-count="0">0</span>
                    </a>
                    {% if themeConfig.cart.type == 'default' %}
                        <a class="header-link header-link_cart cart_link" href="javascript:void(0)" title="Carrinho" {% if themeConfig.buyAction.type == "login" %}@click="openSideNavOverlayCartB2B()"{% else %}onclick="openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: true})"{% endif %}>
                            {{ themeConfig.icons.cart }}
                            {% assign cartQtdMobile = 0 %}
                            {% if cart.quantity %}
                                {% assign cartQtdMobile = cart.quantity %}
                            {% endif %}
                            <span class="cart_quantity" data-cart-quantity>{{ cartQtdMobile }}</span>
                        </a>
                    {% endif %}
                    <a class="header-link header-link_search search_link" href="javascript:void(0)" title="Busca" onclick="openSearch()">
                        <div class="icon-search">
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </div>
                    </a>
                    <a class="header-link header-link_menu__mobile menu-mobile_link" href="javascript:void(0)" title="Menu Mobile" onclick="openNavMobile()">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </a>
                </div>
            </div>

            <div class="search close">
                <form id="myForm" method="POST" action="">
                    <div class="input-group">
                        <input type="search" id="term" class="form-input" placeholder="Busque por produto, marca ou modelo">
                        <button class="btn" type="button" title="Buscar" onclick="alterForm()">
                            {% if themeConfig.icons.search %}{{ themeConfig.icons.search }}{% else %}{{ iconSearchFallback }}{% endif %}
                        </button>
                    </div>
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                </form>
            </div>
        </div>
    </div>

    <div class="nav-content content hide-lg header-v2-nav-row">
        <div class="container header-v2-nav-inner">
            <a class="header-v2-cta-ambiente" href="/pagina/calculadora-btus" title="Compre por ambiente">
                {{ iconHome }}
                <span class="header-v2-cta-ambiente__text">Compre por ambiente</span>
            </a>
            <nav class="nav-main">
                {% for menuItem in menu.items limit: 7 %}
                    {% assign menuLabel = menuItem.name %}
                    {% assign menuLabelLower = menuLabel | downcase %}
                    {% if menuLabelLower contains 'peças' or menuLabelLower contains 'pecas' or menuLabelLower contains 'acessório' or menuLabelLower contains 'acessorio' %}
                        {% assign menuLabel = 'Modelo' %}
                    {% endif %}
                    <div class="nav-main_item dropdown">
                        <a href="{{ menuItem.link }}" class="nav-main_link dropdown-toggle" tabindex="0" title="{{ menuLabel }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                            <div class="nav-main-box_link">
                                {% if menuItem.iconSvg %}
                                    <div class="nav-main_icon nav-main-icon_svg">{{ menuItem.iconSvg }}</div>
                                {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                    <div class="nav-main_icon nav-main-icon_img">
                                        <picture>
                                            <img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuLabel }}">
                                        </picture>
                                    </div>
                                {% endif %}
                                <div class="nav-main_text">{{ menuLabel }}</div>
                                {% if menuItem.items.size > 0 %}
                                    <div class="nav-main_arrow">{{ themeConfig.icons.arrow.down }}</div>
                                {% endif %}
                            </div>
                        </a>
                        {% if menuItem.items.size > 0 %}
                            <div class="nav-main_content dropdown-content">
                                {% assign limitMenuChildren = 6 %}
                                {% assign limitMenuAll = limitMenuChildren | times: 6 %}
                                {% assign startMenuChildren = 1 %}
                                {% assign endMenuChildren = startMenuChildren | times: limitMenuChildren %}
                                {% for menuChildrenItem1 in menuItem.items limit:limitMenuAll %}
                                    {% if forloop.index == startMenuChildren %}<ul>{% endif %}
                                    <li class="nav-children dropdown">
                                        <a class="nav-main_children" title="{{ menuChildrenItem1.name }}" href="{{ menuChildrenItem1.link }}"{% if menuChildrenItem1.newTab == true %} target="_blank"{% endif %}>{{ menuChildrenItem1.name }}</a>
                                        {% if menuChildrenItem1.items.size > 0 %}
                                            <div class="nav-main_content nav-main_content__children dropdown-content">
                                                {% assign limitMenuChildren1 = 6 %}
                                                {% assign startMenuChildren1 = 1 %}
                                                {% assign endMenuChildren1 = startMenuChildren1 | times: limitMenuChildren1 %}
                                                {% for menuChildrenItem2 in menuChildrenItem1.items %}
                                                    {% if forloop.index == startMenuChildren1 %}<ul>{% endif %}
                                                    <li class="nav-children dropdown">
                                                        <a class="nav-main_children" href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}"{% if menuChildrenItem2.newTab == true %} target="_blank"{% endif %}>{{ menuChildrenItem2.name }}</a>
                                                        {% if menuChildrenItem2.items.size > 0 %}
                                                            <div class="nav-main_content nav-main_content__children dropdown-content">
                                                                <ul>
                                                                    {% for menuChildrenItem3 in menuChildrenItem2.items %}
                                                                        <li class="nav-children dropdown">
                                                                            <a class="nav-main_children" href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}"{% if menuChildrenItem3.newTab == true %} target="_blank"{% endif %}>{{ menuChildrenItem3.name }}</a>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            </div>
                                                        {% endif %}
                                                    </li>
                                                    {% if forloop.index == endMenuChildren1 or forloop.last %}
                                                        </ul>
                                                        {% assign startMenuChildren1 = endMenuChildren1 | plus: 1 %}
                                                        {% assign endMenuChildren1 = endMenuChildren1 | plus: limitMenuChildren1 %}
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </li>
                                    {% if forloop.index == endMenuChildren or forloop.last %}
                                        </ul>
                                        {% assign startMenuChildren = endMenuChildren | plus: 1 %}
                                        {% assign endMenuChildren = endMenuChildren | plus: limitMenuChildren %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </nav>
            <a class="header-v2-cta-semana" href="/ofertas" title="Ofertas da semana">
                {{ iconTag }}
                <span class="header-v2-cta-semana__text">Ofertas da semana</span>
            </a>
        </div>
    </div>

    <nav class="sidebar-nav show-lg">
        {% if themeConfig.account.type != 'disabled' %}
            <div class="sidebar-nav-header">
                <div class="sidebar-nav-account">
                    <span class="sidebar-nav-icon account_link">{{ themeConfig.icons.user }}</span>
                    <template x-if="data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link sidebar-nav-link_user account_link" href="javascript:void(0)" x-bind:title="`${data.user ? data.user : 'visitante'}`" x-text="`Olá ${data.user ? data.user : 'visitante'}`" onclick="openSideNavOverlay('.sidenav-overlay_account', true)"></a>
                            <a class="sidebar-nav-link sidebar-nav-link_logout" href="javascript:void(0)" title="Logout" @click="headerLogout()">Logout</a>
                        </div>
                    </template>
                    <template x-if="!data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link account_link" href="javascript:void(0)" title="Login ou Cadastre-se" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">Login ou Cadastre-se</a>
                        </div>
                    </template>
                </div>
            </div>
        {% endif %}
        <div class="sidebar-nav-content content">
            <div>
                <ul class="nav-mobile metismenu" id="nav-mobile">
                    <li class="nav-mobile_item">
                        <div class="nav-mobile_link" aria-expanded="false">
                            <p><a href="/pagina/calculadora-btus" title="Compre por ambiente"><div class="nav-mobile-box_link"><div class="nav-mobile_text">Compre por ambiente</div></div></a></p>
                        </div>
                    </li>
                    <li class="nav-mobile_item">
                        <div class="nav-mobile_link" aria-expanded="false">
                            <p><a href="/pagina/favoritos" title="Favoritos"><div class="nav-mobile-box_link"><div class="nav-mobile_text">Favoritos</div></div></a></p>
                        </div>
                    </li>
                    <li class="nav-mobile_item">
                        <div class="nav-mobile_link" aria-expanded="false">
                            <p><a href="/pedidos" title="Meus pedidos"><div class="nav-mobile-box_link"><div class="nav-mobile_text">Meus pedidos</div></div></a></p>
                        </div>
                    </li>
                    {% for menuItem in menu.items %}
                        {% assign menuLabel = menuItem.name %}
                        {% assign menuLabelLower = menuLabel | downcase %}
                        {% if menuLabelLower contains 'peças' or menuLabelLower contains 'pecas' or menuLabelLower contains 'acessório' or menuLabelLower contains 'acessorio' %}
                            {% assign menuLabel = 'Modelo' %}
                        {% endif %}
                        <li class="nav-mobile_item">
                            {% assign classArrowItem = '' %}
                            {% if menuItem.items.size > 0 %}
                                {% assign classArrowItem = ' has-arrow' %}
                            {% endif %}
                            <div class="nav-mobile_link{{ classArrowItem }}" aria-expanded="false">
                                <p>
                                    <a href="{{ menuItem.link }}" title="{{ menuLabel }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                                        <div class="nav-mobile-box_link">
                                            {% if menuItem.iconSvg %}
                                                <div class="nav-mobile_icon nav-mobile-icon_svg">{{ menuItem.iconSvg }}</div>
                                            {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                    <picture><img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuLabel }}"></picture>
                                                </div>
                                            {% endif %}
                                            <div class="nav-mobile_text">{{ menuLabel }}</div>
                                        </div>
                                    </a>
                                </p>
                            </div>
                            {% if menuItem.items.size > 0 %}
                                <ul>
                                    {% for menuChildrenItem1 in menuItem.items %}
                                        <li>
                                            {% assign classArrowChildren1 = '' %}
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                {% assign classArrowChildren1 = ' has-arrow' %}
                                            {% endif %}
                                            <div class="nav-mobile_link{{ classArrowChildren1 }}" aria-expanded="false">
                                                <p>
                                                    <a href="{{ menuChildrenItem1.link }}" title="{{ menuChildrenItem1.name }}"{% if menuChildrenItem1.newTab == true %} target="_blank"{% endif %}>
                                                        <div class="nav-mobile-box_link">
                                                            <div class="nav-mobile_text">{{ menuChildrenItem1.name }}</div>
                                                        </div>
                                                    </a>
                                                </p>
                                            </div>
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                <ul>
                                                    {% for menuChildrenItem2 in menuChildrenItem1.items %}
                                                        <li>
                                                            <div class="nav-mobile_link" aria-expanded="false">
                                                                <p>
                                                                    <a href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}"{% if menuChildrenItem2.newTab == true %} target="_blank"{% endif %}>
                                                                        <div class="nav-mobile-box_link">
                                                                            <div class="nav-mobile_text">{{ menuChildrenItem2.name }}</div>
                                                                        </div>
                                                                    </a>
                                                                </p>
                                                            </div>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </nav>

    <script>
        function alterForm() {
            var input = document.getElementById("term").value;
            if (input.length > 0) {
                document.getElementById("myForm").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
            } else {
                document.getElementById("myForm").addEventListener('submit', function(e){
                    e.preventDefault();
                }, false);
                window.location.href = window.location.protocol + '//' + window.location.host + '/busca/';
            }
        }

        function alterForm2() {
            var input = document.getElementById("term2").value;
            if (input.length > 0) {
                document.getElementById("myForm2").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
                document.getElementById("myForm2").submit();
            } else {
                window.location.href = window.location.protocol + '//' + window.location.host + '/busca/';
            }
        }
    </script>
</header>
