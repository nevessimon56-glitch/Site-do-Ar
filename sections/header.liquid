  position: relative;
  z-index: 20;
  color: var(--sda-ink);
  background: #fff;
  box-shadow: 0 5px 22px rgba(16,45,70,.07);
}
.header-v2 *, .header-v2 *::before, .header-v2 *::after { box-sizing: border-box; }
.header-v2 .header-utility { background: var(--sda-ink); color: #fff; }
