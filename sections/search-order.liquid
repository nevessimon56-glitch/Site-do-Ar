<div class="form-group float-left">
    <label class="form-label">Ordenar por</label>
    <div class="dropdown">
        <a href="javascript:void(0)" class="btn dropdown-toggle" tabindex="0">
            {% case search.query.ordem %}
                {% when "relevancia" %}
                    Mais vendidos
                {% when "maior-preco" %}
                    Maior preço
                {% when "menor-preco" %}
                    Menor preço
                {% when "nome" %}
                    Nome (A–Z)
                {% else %}
                    Mais vendidos
            {% endcase %}
            <i>
                {{ themeConfig.icons.arrow.down }}
            </i>
        </a>
        <ul class="menu">
            <li class="menu-item">
                <a href="{{ currentPage.path | linkSearch : search.query , 'ordem', 'relevancia' }}">
                    Mais vendidos
                </a>
            </li>
            <li class="menu-item">
                <a href="{{ currentPage.path | linkSearch : search.query , 'ordem', 'menor-preco' }}">
                    Menor preço
                </a>
            </li>
            <li class="menu-item">
                <a href="{{ currentPage.path | linkSearch : search.query , 'ordem', 'maior-preco' }}">
                    Maior preço
                </a>
            </li>
            <li class="menu-item">
                <a href="{{ currentPage.path | linkSearch : search.query , 'ordem', 'nome' }}">
                    Nome (A–Z)
                </a>
            </li>
        </ul>
    </div>
</div>
