<script>
    function setupShowcaseVideo{{ index }}Id{{ showcaseSection.id }}() {
        const state = {
            isOpenModal: false,
            isVisibleVideo: false,
            video: {
                videoType: null,
                videoId: null,
                urlVideo: null,
                width: 720,
                height: 405,
            },
            youtube: {
                player: null,
            },
            vimeo: {
                options: {
                    id: null,
                    width: null,
                    height: null,
                    responsive: true,
                }
            },
            videoSize:{
                width: '100%',
                height: '100%',
            }
        };

        function initShowcaseVideo() {
            if (this.state.autoplay) {
                this.state.isVisibleVideo = true;
            }
        }

        function uploadVideo(data) {
            this.state.video.videoType = data.videoType;
            this.state.video.videoId = data.videoId;
            this.state.video.urlVideo = data.urlVideo;
            if ((data.videoType === 'youtube') || (data.videoType === 'vimeo')) {

                if ((data.videoType === 'youtube')) {
                    if (data.videoId !== '') {
                        if (validURL(data.videoId)) {
                            /*** Link 1: https://www.youtube.com/watch?v=9xxxxXx9XXx ***/
                            const pattYT1 = new RegExp("https://[a-z]*\\.youtube\\.com", "ig");
                            /*** Link 2: https://youtu.be/9xxxxXx9XXx ***/
                            const pattYT2 = new RegExp("https://youtu\\.be", "ig");
                            // /*** Link 1: https://www.youtube.com/shorts/9xxxxXx9XXx ***/
                            const pattYT3 = new RegExp("https://[a-z]*\\.youtube\\.com/shorts", "ig");


                            if (pattYT1.test(data.videoId)) {
                                if (typeof getAllUrlParams(data.videoId)['v'] !== 'undefined') {
                                    this.state.video.videoId = getAllUrlParams(data.videoId)['v'];
                                } else if (pattYT3.test(data.videoId)) {
                                    const urlTemp = new URL(data.videoId);
                                    const pathnameTemp = urlTemp.pathname;
                                    const arrUrlTemp = pathnameTemp.split('/');
                                    if ((typeof arrUrlTemp[2] !== 'undefined') && arrUrlTemp[2] !== '') {
                                        this.state.video.videoId = arrUrlTemp[2];
                                    }
                                }
                            } else if (pattYT2.test(data.videoId)) {
                                const urlTemp = new URL(data.videoId);
                                const pathnameTemp = urlTemp.pathname;
                                const arrUrlTemp = pathnameTemp.split('/');
                                if ((typeof arrUrlTemp[1] !== 'undefined') && arrUrlTemp[1] !== '') {
                                    this.state.video.videoId = arrUrlTemp[1];
                                }
                            }
                        }
                        onYouTubeIframeAPIReady();
                    }
                } else if ((data.videoType === 'vimeo')) {
                    if (data.videoId !== '') {
                        if (validURL(data.videoId)) {
                            /*** Link: https://vimeo.com/999999999 ***/
                            const pattVimeo = new RegExp("https://vimeo\\.com", "ig");
                            if (pattVimeo.test(data.videoId)) {
                                const urlTemp = new URL(data.videoId);
                                const pathnameTemp = urlTemp.pathname;
                                const arrUrlTemp = pathnameTemp.split('/');
                                if ((typeof arrUrlTemp[1] !== 'undefined') && arrUrlTemp[1] !== '') {
                                    this.state.video.videoId = arrUrlTemp[1];
                                }
                            }
                        }
                    }
                    this.state = onVimeoIframeAPIReady(this.state);
                    startVideoVimeo(this.state.vimeo, this.state);
                }
            }
        }
        function openModalVideo(videoType, videoId, urlVideo) {
            if ((videoType === '') || (videoType === 'html5' && urlVideo === '') || ((videoType === 'vimeo' || videoType === 'youtube') && videoId === '')) {
                return false;
            }
            const dataVideo = {
                videoType: videoType,
                videoId: videoId,
                urlVideo: urlVideo
            };
            this.uploadVideo(dataVideo);

            this.state.isVisibleVideo = true;
        }

        /*** Start - Vimeo ***/
        function loadIframeVimeo() {
            const tag = document.createElement('script');

            tag.src = "https://player.vimeo.com/api/player.js";
            const firstScriptTag = document.getElementsByTagName('script')[0];
            firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        }
        function onVimeoIframeAPIReady(state){
            state.vimeo.options.id = state.video.videoId;
            state.vimeo.options.width = state.videoSize.width;
            state.vimeo.options.height = state.videoSize.height;
            state.vimeo.options.allowfullscreen = true;
            state.vimeo.options.responsive = true;
            state.vimeo.player = new Vimeo.Player('playerVimeo{{ index }}Id{{ showcaseSection.id }}', state.vimeo.options);
            return state;
        }

        function startVideoVimeo(vimeo, state) {
            vimeo.player.play().then(function() {
                // The video is playing
                /*var vimeoElementAdjustHeight = document.querySelectorAll('#playerVimeo{{ index }}Id{{ showcaseSection.id }} > div');
                for (var i = 0; i < vimeoElementAdjustHeight.length; i++) {
                    vimeoElementAdjustHeight[i].style.paddingTop = `${state.videoSize.height}px`
                }*/
            }).catch(function(error) {
                switch (error.name) {
                    case 'PasswordError':
                        // The video is password-protected
                        break;
                    case 'PrivacyError':
                        // The video is private
                        break;
                    default:
                        // Some other error occurred
                        break;
                }
            });
        }

        function destroyVideoVimeo(vimeo) {
            vimeo.player.destroy();
        }
        /*** End - Vimeo ***/

        /*** Start - YouTube ***/
        function loadIframeYoutube() {
            // 2. This code loads the IFrame Player API code asynchronously.
            const tag = document.createElement('script');

            tag.src = "https://www.youtube.com/iframe_api";
            const firstScriptTag = document.getElementsByTagName('script')[0];
            firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        }

        function onYouTubeIframeAPIReady() {
            state.youtube.player = new YT.Player('playerYT{{ index }}Id{{ showcaseSection.id }}', {
                height: '100%',
                width: '100%',
                // height: state.videoSize.height,
                // width: state.videoSize.width,
                videoId: state.video.videoId,
                events: {
                    'onReady': onPlayerReadyVT,
                    'onStateChange': onPlayerStateChangeYT
                }
            });
        }

        // 4. The API will call this function when the video player is ready.
        function onPlayerReadyVT(event) {
            event.target.playVideo();
        }

        function onPlayerStateChangeYT(event) {
            if (event.data === YT.PlayerState.ENDED) {
                player.playVideo();
            }
        }

        function stopVideoYT() {
            state.youtube.player.stopVideo();
        }

        function destroyVideoYT() {
            state.youtube.player.destroy();
            state.youtube.player === null;
        }

        /*** End - YouTube ***/

        return {
            state,
            openModalVideo,
            uploadVideo,
            initShowcaseVideo,
        };
    }
</script>
