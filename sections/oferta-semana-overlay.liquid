{% comment %}
  Oferta da semana — layout estilo curadoria PMN (overlay full-screen).
  Abre: /#sda-oferta-immersiva ou banner do header.
{% endcomment %}
<style id="sda-oferta-fallback-v2">
@media (max-width: 767px) {
  .sda-oferta-overlay .opmn-mobile-dock { display: flex !important; }
  .sda-oferta-overlay .opmn-main { padding-bottom: calc(88px + env(safe-area-inset-bottom)) !important; }
  .sda-oferta-overlay .opmn-offers__filter { display: inline-flex !important; }
}
</style>
<div
  id="sda-oferta-immersiva"
  class="sda-oferta-overlay"
  data-sda-oferta-overlay
  data-sda-oferta-version="2026-03-25-mobile"
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="opmn-hero-title"
>
  <button type="button" class="sda-oferta-overlay__close" data-sda-oferta-close aria-label="Fechar">
    <span aria-hidden="true">×</span>
  </button>

  <div class="opmn" data-opmn-root>
    <header class="opmn-top">
      <span class="opmn-top__brand">site do ar</span>
      <nav class="opmn-top__nav" aria-label="Atalhos da oferta">
        <button type="button" class="opmn-top__link" data-opmn-scroll="ofertas">Ofertas</button>
        <a class="opmn-top__link" href="/pagina/calculadora-btus">Por ambiente</a>
        <a class="opmn-top__link" href="/pagina/calculadora-btus">Como escolher</a>
      </nav>
    </header>

    <main class="opmn-main">
      <section class="opmn-hero">
        <p class="opmn-kicker" data-opmn-edition>— EDIÇÃO 03 · CURADORIA DE CLIMATIZAÇÃO</p>
        <h1 class="opmn-hero__title" id="opmn-hero-title">
          <span>O clima certo</span>
          <span class="opmn-hero__accent">muda tudo.</span>
        </h1>
        <p class="opmn-hero__lead">
          Escolha conforto para todos os dias. Modelos selecionados, preço justo e a potência certa para cada ambiente.
        </p>
        <div class="opmn-hero__actions">
          <button type="button" class="opmn-btn opmn-btn--primary" data-opmn-scroll="ofertas">
            Ver ofertas <span aria-hidden="true">→</span>
          </button>
          <a class="opmn-btn opmn-btn--text" href="/pagina/calculadora-btus">Como escolher <span aria-hidden="true">→</span></a>
        </div>
        <div class="opmn-stats">
          <div class="opmn-stat">
            <strong>4,9</strong>
            <span>avaliação média de satisfação</span>
          </div>
          <div class="opmn-stat">
            <strong>+12 mil</strong>
            <span>aparelhos vendidos neste ano</span>
          </div>
        </div>
      </section>

      <aside class="opmn-spot" data-opmn-spot aria-label="Destaque da semana">
        <p class="opmn-spot__label">DESTAQUE DA SEMANA</p>
        <h2 class="opmn-spot__headline">Ar que combina com sua rotina.</h2>
        <div class="opmn-spot__card">
          <div class="opmn-spot__badges">
            <span class="opmn-badge opmn-badge--ok">Disponível</span>
            <span class="opmn-badge opmn-badge--tag" data-opmn-spot-discount hidden></span>
          </div>
          <div class="opmn-spot__media">
            <img data-opmn-spot-img src="" alt="" width="280" height="200" loading="lazy" decoding="async">
          </div>
          <p class="opmn-spot__meta">SITE DO AR · 2026</p>
          <h3 class="opmn-spot__name" data-opmn-spot-title>Carregando seleção…</h3>
          <p class="opmn-spot__hint">Tecnologia inverter — mais conforto, menos consumo.</p>
          <a class="opmn-btn opmn-btn--primary opmn-btn--block" data-opmn-spot-link href="#">Ver produto</a>
        </div>
      </aside>

      <div class="opmn-trust-wrap">
        <ul class="opmn-trust" aria-label="Benefícios">
          <li>
            <strong>Compra segura</strong>
            <span>certificados em todas as etapas</span>
          </li>
          <li>
            <strong>Instalação descomplicada</strong>
            <span>agendamento rápido</span>
          </li>
          <li>
            <strong>Conforto de verdade</strong>
            <span>tecnologia inverter</span>
          </li>
        </ul>
      </div>

      <section class="opmn-offers" id="opmn-ofertas" data-opmn-offers>
        <p class="opmn-kicker">— OFERTAS SELECIONADAS</p>
        <div class="opmn-offers__head">
          <div class="opmn-offers__head-text">
            <h2 class="opmn-section-title">
              Conforto em <span class="opmn-hero__accent">boa companhia.</span>
            </h2>
            <p class="opmn-offers__sub">
              Uma seleção enxuta de aparelhos para climatizar cada ambiente na temperatura ideal.
            </p>
          </div>
          <button type="button" class="opmn-offers__filter" data-opmn-scroll="ofertas" aria-label="Ir para ofertas">
            Filtrar ofertas
          </button>
        </div>
        <div class="opmn-rail-wrap">
          <div class="opmn-rail" data-opmn-rail tabindex="0" aria-live="polite"></div>
        </div>
        <p class="opmn-empty" data-opmn-empty hidden>Em breve novas ofertas curadas.</p>
      </section>

      <section class="opmn-guide">
        <div class="opmn-guide__icon" aria-hidden="true">❄</div>
        <div class="opmn-guide__text">
          <p class="opmn-guide__kicker">AJUDA EM DÚVIDA?</p>
          <p class="opmn-guide__title">BTUs, ambiente e economia sem complicação.</p>
        </div>
        <a class="opmn-guide__link" href="/pagina/calculadora-btus">Ver guia de escolha →</a>
      </section>

      <footer class="opmn-foot">
        <span>© 2026 Site do Ar</span>
        <span>Curadoria semanal · vitrine + config</span>
      </footer>
    </main>

    <div class="opmn-loader" data-opmn-loader aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <div class="opmn-mobile-dock" data-opmn-mobile-dock aria-hidden="true">
      <button type="button" class="opmn-mobile-dock__ghost" data-opmn-scroll="ofertas">Ofertas</button>
      <a class="opmn-mobile-dock__primary" data-opmn-dock-link href="#">Ver destaque</a>
    </div>
  </div>
</div>
