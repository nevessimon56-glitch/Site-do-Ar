{% comment %}
  PDP v2 — Descrição / Destaques / Especificações
  Usa abas de descrição do produto no WDNA (nome contendo "destaque" ou "especifica").
  Fallback Destaques: pills de sections/product-spec-icons.liquid
{% endcomment %}

{% assign pdpDescMain = nil %}
{% assign pdpDescDestaques = nil %}
{% assign pdpDescSpecs = nil %}

{% for description in product.descriptions %}
  {% if description.text != '' %}
    {% assign dname = description.name | downcase | strip %}
    {% if dname contains 'destaque' %}
      {% assign pdpDescDestaques = description %}
    {% elsif dname contains 'especifica' %}
      {% assign pdpDescSpecs = description %}
    {% elsif pdpDescMain == nil and dname contains 'descri' %}
      {% assign pdpDescMain = description %}
    {% endif %}
  {% endif %}
{% endfor %}

{% for description in product.descriptions %}
  {% if description.text != '' and pdpDescMain == nil %}
    {% assign dname = description.name | downcase | strip %}
    {% unless dname contains 'destaque' or dname contains 'especifica' %}
      {% assign pdpDescMain = description %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% if pdpDescMain or pdpDescDestaques or pdpDescSpecs or product %}
<section class="product-descriptions">
  <div class="product-descriptions-content content">
    <div class="product-descriptions-container container">
      <div class="product-descriptions_grid">
        {% if pdpDescMain %}
        <details class="product-description accordion product-description--desc" open>
          <summary class="product-description_header accordion-header">
            <span class="product-description_ico-lead"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l3 3v17H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></span>
            <span class="product-description_title">{{ pdpDescMain.name }}</span>
            <span class="product-description_ico">{{ themeConfig.icons.arrow.down }}</span>
          </summary>
          <div class="product-description_body">
            <div class="accordion-body">{{ pdpDescMain.text }}</div>
          </div>
        </details>
        {% endif %}

        <details class="product-description accordion product-description--highlights" open>
          <summary class="product-description_header accordion-header">
            <span class="product-description_ico-lead product-description_ico-lead--green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C10.5 5 12 3 12 3s1.5 2 2.2 3.1A7 7 0 0 1 13 20z"/></svg></span>
            <span class="product-description_title">{% if pdpDescDestaques %}{{ pdpDescDestaques.name }}{% else %}Destaques{% endif %}</span>
            <span class="product-description_ico">{{ themeConfig.icons.arrow.down }}</span>
          </summary>
          <div class="product-description_body">
            <div class="accordion-body product-description_highlights-body">
              {% if pdpDescDestaques %}
                {{ pdpDescDestaques.text }}
              {% else %}
                <div class="product-spec-icons-pdp">
                  {% render 'sections/product-spec-icons', product: product %}
                </div>
              {% endif %}
            </div>
          </div>
        </details>
      </div>

      <details class="product-description accordion product-description--specs" open>
        <summary class="product-description_header accordion-header">
          <span class="product-description_ico-lead"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg></span>
          <span class="product-description_title">{% if pdpDescSpecs %}{{ pdpDescSpecs.name }}{% else %}Especificações{% endif %}</span>
          <span class="product-description_ico">{{ themeConfig.icons.arrow.down }}</span>
        </summary>
        <div class="product-description_body">
          <div class="accordion-body">
            {% if pdpDescSpecs %}
              {{ pdpDescSpecs.text }}
            {% elsif product.specification and product.specification != '' %}
              {{ product.specification }}
            {% else %}
              <p class="product-specs-fallback">Consulte a ficha técnica na descrição ou entre em contato.</p>
            {% endif %}
          </div>
        </div>
      </details>
    </div>
  </div>
</section>
{% endif %}
