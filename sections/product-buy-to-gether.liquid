{% if buyToGether.length > 0 and product.manageStock == false or product.stockTotal > 0 %}
    {% assign classProductLogin = '' %}
    {% if themeConfig.price.type == 'show-logged' %}
        {% assign classProductLogin = ' login-btn_logged d-hide' %}
    {% endif %}
    <section class="product-buy-to-gether">
        <div class="product-showcase-content content">
            <div class="product-showcase-container container">
                <h2 class="showcase-title">
                    Compre Junto
                </h2>
                <div class="columns">
                    <div class="col-product-buy-to-gether col-12 column">
                        {% for productBuyToGether in buyToGether limit: maximumProducts %}
                            {% if productBuyToGether.price.status %}
                                {% if productBuyToGether.manageStock == false or productBuyToGether.stockTotal > 0 %}
                                    <!-- Produto Principal -->
                                    <!-- TODO: Não alterar mainPrice. Se caso alterar, vai afetar no calculo de pagamento-->
                                    {% assign mainPrice = product.price.price %}
                                    {% if product.price.promotionPrice > 0 %}
                                        {% assign mainPrice = product.price.promotionPrice %}
                                    {% endif %}
                                    <!-- Segundo Produto -->
                                    <!-- TODO: Não alterar mainPriceBuyToGether. Se caso alterar, vai afetar no calculo de pagamento-->
                                    {% assign mainPriceBuyToGether = productBuyToGether.price.price %}
                                    {% if productBuyToGether.price.promotionPrice > 0 %}
                                        {% assign mainPriceBuyToGether = productBuyToGether.price.promotionPrice %}
                                    {% endif %}

                                    <!-- Produto Principal -->
                                    {% assign productPricePrimary = product.price %}
                                    {% if product.primaryPrice %}
                                        {% assign productPricePrimary = product.primaryPrice %}
                                    {% endif %}
                                    {% if product.secondaryPrice %}
                                        {% assign productPriceSecond = product.secondaryPrice %}
                                    {% endif %}

                                    <!-- Segundo Produto -->
                                    {% assign productPricePrimaryBuyToGether = productBuyToGether.price %}
                                    {% if productBuyToGether.primaryPrice %}
                                        {% assign productPricePrimaryBuyToGether = productBuyToGether.primaryPrice %}
                                    {% endif %}
                                    {% if productBuyToGether.secondaryPrice %}
                                        {% assign productPriceSecondBuyToGether = productBuyToGether.secondaryPrice %}
                                    {% endif %}

                                    {% assign maximumProducts = 30 %}
                                    <div class="showcase showcase-buy-to-gether showcase-buy-to-gether__{{ productBuyToGether.id }}"
                                         x-init="getProductBuyToGether{{ forloop.index }}()"
                                         x-on:cart-change-quantity-parent.window="changeProductParent{{ forloop.index }}($event.detail.quantity)"
                                         x-data="setupProductBuyToGether{{ forloop.index }}()">
                                        <div class="showcase-products">
                                            <div class="showcase-option showcase-option_buy-to-gether">
                                                <div class="columns">
                                                    <div class="col-3 col-lg-12 column">
                                                        <div class="showcase-item showcase-item_buy-to-gether">
                                                            {% render 'sections/showcase-model-product-buy-to-gether', product: product, themeConfig: themeConfig %}
                                                        </div>
                                                    </div>
                                                    <div class="col-1 col-lg-12 col-custom column">
                                                        <div class="showcase-item_calc">
                                                            +
                                                        </div>
                                                    </div>
                                                    <div class="col-3 col-lg-12 column">
                                                        <div class="showcase-item showcase-item_buy-to-gether">
                                                            {% render 'sections/showcase-model-product-buy-to-gether', product: productBuyToGether, themeConfig: themeConfig %}
                                                        </div>
                                                    </div>
                                                    <div class="col-1 col-lg-12 col-custom column">
                                                        <div class="showcase-item_calc">
                                                            =
                                                        </div>
                                                    </div>
                                                    <div class="col-5 col-lg-12 column">
                                                        <div class="product-header-box">
                                                            <div class="product-prices">
                                                                {% assign mainPricePrimary = productPricePrimary.price %}
                                                                {% if productPricePrimary.promotionPrice > 0 %}
                                                                    {% assign mainPricePrimary = productPricePrimary.promotionPrice %}
                                                                    {% assign promotionPrice = productPricePrimary.price %}
                                                                {% endif %}

                                                                {% assign mainPricePrimaryBuyToGether = productPricePrimaryBuyToGether.price %}
                                                                {% assign promotionPriceBuyToGether = 0 %}
                                                                {% if productPricePrimaryBuyToGether.promotionPrice > 0 %}
                                                                    {% assign mainPricePrimaryBuyToGether = productPricePrimaryBuyToGether.promotionPrice %}
                                                                    {% assign promotionPriceBuyToGether = productPricePrimaryBuyToGether.price %}
                                                                {% endif %}
                                                                <div class="product-content_box product-box_prices col-12{{ classProductLogin }}">
                                                                    {% if promotionPrice > 0 or promotionPriceBuyToGether > 0 %}
                                                                        <del class="product-prices_strike">
                                                                            {{ productPricePrimary.price | plus: productPricePrimaryBuyToGether.price | money }}
                                                                        </del>
                                                                    {% endif %}
                                                                    <p class="product-prices_price">
                                                                        {{ mainPricePrimary | plus: mainPricePrimaryBuyToGether | money }}
                                                                    </p>
                                                                    {% if productPriceSecond and productPriceSecondBuyToGether %}
                                                                        {% if productPriceSecondBuyToGether.installment > 1 %}
                                                                            <p class="product-prices_plots">
                                                                                ou {{ productPriceSecond.installment }}x
                                                                                de {{ productPriceSecond.installmentValue | plus: productPriceSecondBuyToGether.installmentValue | money }} no cartão
                                                                            </p>
                                                                        {% else %}
                                                                            <p class="product-prices_plots">
                                                                                ou {{ productPriceSecond.price | plus: productPriceSecondBuyToGether.price | money }} à vista
                                                                            </p>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                </div>
                                                                <div class="product-content_box product-box_qtd col-12{{ classProductLogin }}">
                                                                    <div class="product-qtd input-group_qtd input-group">
                                                                        <button class="product-qtd_minus btn input-group-btn"
                                                                                @click="handleQuantityBuyToGether{{ forloop.index }}('-')">
                                                                            -
                                                                        </button>
                                                                        <input
                                                                                class="product-qtd_value form-input"
                                                                                type="number"
                                                                                min="1"
                                                                                x-model="state.quantity"
                                                                                @focusout="handleQuantityBuyToGether{{ forloop.index }}('')"
                                                                        >
                                                                        <button class="product-qtd_plus btn input-group-btn"
                                                                                @click="handleQuantityBuyToGether{{ forloop.index }}('+')">
                                                                            +
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="product-payments{{ classProductLogin }}">
                                                                <a class="product-btn_payment btn col-12"
                                                                   href="javascript:void(0)"
                                                                   title="Outras formas de pagamentos"
                                                                   @click="openPaymentCalculationBuyToGether{{ forloop.index }}()">
                                                                    Mais formas de pagamento
                                                                </a>
                                                            </div>
                                                            <div class="columns">
                                                                <div class="column col-6 col-sm-12">

                                                                    <div class="product-buy">
                                                                        {% case themeConfig.buyAction.type %}
                                                                            {% when "chat-buy" %}
                                                                                <!-- chat-buy -->
                                                                                <a class="product-btn product-btn_buy btn col-12" href="javascript:void(0)" title="Adicionar ao carrinho" @click="buyChatProductBuyToGether{{ forloop.index }}()">
                                                                                    {{ themeConfig.buyAction.plugin | textBtnChatBuy: themeConfig.price.type }}
                                                                                </a>
                                                                            {% when "login" %}
                                                                                <!-- login -->
                                                                                {% assign classBtnBuy = ' login-btn_logged d-hide' %}
                                                                                {% assign classBtnLogin = ' login-btn_not_logged d-hide' %}
                                                                                <a class="product-btn product-btn_buy btn col-12{{ classBtnBuy }}" href="javascript:void(0)" title="Adicionar ao carrinho" @click="handleAddToCartBuyToGether{{ forloop.index }}()">
                                                                                    Comprar
                                                                                </a>
                                                                                <a class="product-btn product-btn_buy btn col-12{{ classBtnLogin }}" href="javascript:void(0)" title="Fazer Login" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                                                                    Fazer Login
                                                                                </a>
                                                                            {% when "cart-add" %}
                                                                                <!-- cart-add -->
                                                                                <a class="product-btn product-btn_buy btn col-12" href="javascript:void(0)" title="Adicionar ao carrinho" @click="handleAddToCartBuyToGether{{ forloop.index }}()">
                                                                                    Comprar
                                                                                </a>
                                                                        {% endcase %}
                                                                    </div>
                                                                </div>
                                                                <div class="column col-6 col-sm-12{{ classProductLogin }}">
                                                                    <div class="product-shipping">
                                                                        <a class="product-btn product-btn_shipping btn col-12"
                                                                           href="javascript:void(0)"
                                                                           title="Calcule o frete e prazo de entrega"
                                                                           @click="openShippingCalculationBuyToGether{{ forloop.index }}">
                                                                            Calcular frete
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <script>
                                        function setupProductBuyToGether{{ forloop.index }}() {
                                            const state = {
                                                qtdDefault: 0,
                                                quantity: 1,
                                                stockTotal: 0,
                                                price: '{{ mainPrice | plus: mainPriceBuyToGether }}',
                                                products: [
                                                    {
                                                        id: {{ product.id }},
                                                        quantity: 0,
                                                        stockTotal: parseInt('{{ product.stockTotal }}'),

                                                    },
                                                    {
                                                        id: {{ productBuyToGether.id }},
                                                        quantity: 0,
                                                        stockTotal: parseInt('{{ productBuyToGether.stockTotal }}'),
                                                    }
                                                ],
                                                themeConfig: {
                                                    buyActionPlugin: '{{ themeConfig.buyAction.plugin  }}',
                                                    priceType: '{{ themeConfig.price.type  }}',
                                                },
                                                product: {{ product | json }},
                                                productBuyToGether: {{ productBuyToGether | json }},
                                            }

                                            function changeProductParent{{ forloop.index }}(newQnt = 0) {
                                                this.state.qtdDefault = parseInt(newQnt);
                                                let newStockTotalDefault = this.state.products[0].stockTotal;
                                                if (newStockTotalDefault > this.state.qtdDefault) {
                                                    newStockTotalDefault = parseInt(this.state.products[0].stockTotal) - parseInt(this.state.qtdDefault);
                                                }
                                                this.state.stockTotal = parseInt(Math.min(newStockTotalDefault, this.state.products[1].stockTotal))
                                            }

                                            function getProductBuyToGether{{ forloop.index }} () {
                                                this.state.stockTotal = Math.min(this.state.products[0].stockTotal, this.state.products[1].stockTotal)
                                            }

                                            function openShippingCalculationBuyToGether{{ forloop.index }} () {
                                                window.dispatchEvent(
                                                    new CustomEvent("change-quantity", {detail: this.state.products})
                                                );
                                                openSideNavOverlay('.sidenav-shipping-calculation', true);
                                            }

                                            function openPaymentCalculationBuyToGether{{ forloop.index }} () {
                                                window.dispatchEvent(
                                                    new CustomEvent("change-payment-calculate", {detail: {price: this.state.price}})
                                                );
                                                openSideNavOverlay('.sidenav-payment-calculation');
                                            }

                                            function handleAddToCartBuyToGether{{ forloop.index }}() {
                                                this.state.products[0].quantity = (this.state.quantity);
                                                this.state.products[1].quantity = this.state.quantity;
                                                changeQuantityProdutBuyToGether(this.state.products[0].quantity);
                                                window.dispatchEvent(
                                                    new CustomEvent("cart-add", {detail: this.state.products})
                                                );
                                                openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: false});
                                            }

                                            function handleQuantityBuyToGether{{ forloop.index }}(operation = '') {
                                                if (this.state.stockTotal === 0) {
                                                    this.state.quantity = 1;
                                                    return;
                                                }
                                                let newQuantity = typeof this.state.quantity === 'string' ? parseInt(this.state.quantity) : this.state.quantity;
                                                if (operation === '+') {
                                                    if (newQuantity >= 1 && this.state.quantity < this.state.stockTotal) {
                                                        this.state.quantity = newQuantity + 1;
                                                    } else {
                                                        this.state.quantity
                                                    }
                                                } else if (operation === '-') {
                                                    if (this.state.quantity > 1) {
                                                        this.state.quantity = newQuantity - 1;
                                                    } else {
                                                        this.state.quantity = 1;
                                                    }
                                                } else {
                                                    if (this.state.quantity < 1) {
                                                        this.state.quantity = 1
                                                    } else if (this.state.quantity > this.state.stockTotal) {
                                                        this.state.quantity = this.state.stockTotal;
                                                    }
                                                }
                                            }

                                            function buyChatProductBuyToGether{{ forloop.index }}() {
                                                if (this.state.product && this.state.productBuyToGether) {
                                                    const newProduct = {
                                                        id: this.state.product.id,
                                                        quantity: this.state.quantity,
                                                        title: this.state.product.title,
                                                        url: this.state.product.url,
                                                        unitPrice: '{{ mainPricePrimary }}',
                                                        totalPrice: (parseInt('{{ mainPricePrimary }}') * this.state.quantity),
                                                    };
                                                    const newProductBuyToGether = {
                                                        id: this.state.productBuyToGether.id,
                                                        quantity: this.state.quantity,
                                                        title: this.state.productBuyToGether.title,
                                                        url: this.state.productBuyToGether.url,
                                                        unitPrice: '{{ mainPricePrimaryBuyToGether }}',
                                                        totalPrice: (parseInt('{{ mainPricePrimaryBuyToGether }}') * this.state.quantity),
                                                    };
                                                    if (this.state.themeConfig.buyActionPlugin === 'whatsapp') {
                                                        const msgChat = StoreSDK.utils.msgChatBuyProduct(this.state.themeConfig.buyActionPlugin, [newProduct, newProductBuyToGether], window.location.hostname, this.state.themeConfig.priceType);
                                                        sendWhatsPlugin(msgChat);
                                                    }
                                                }
                                            }

                                            return {
                                                state,
                                                changeProductParent{{ forloop.index }},
                                                getProductBuyToGether{{ forloop.index }},
                                                handleQuantityBuyToGether{{ forloop.index }},
                                                openShippingCalculationBuyToGether{{ forloop.index }},
                                                openPaymentCalculationBuyToGether{{ forloop.index }},
                                                handleAddToCartBuyToGether{{ forloop.index }},
                                                buyChatProductBuyToGether{{ forloop.index }},
                                            }
                                        }
                                    </script>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}
