<section class="showcase showcase-{{ showcaseSection.id }} showcase-model-{{ showcaseSection.typeId }}">
    {% assign sectionConfig = showcaseSection.config %}
    <div class="container">
        <!-- Título da Vitrine1 -->
        {% if showcaseSection.name %}
            {% assign styleTitle = '' %}
            {% case sectionConfig.namePosition %}
                {% when 'center' %}
                    {% assign styleTitle = 'text-align: center;' %}
                {% when 'left' %}
                    {% assign styleTitle = 'text-align: left;' %}
                {% when 'right' %}
                    {% assign styleTitle = 'text-align: right;' %}
                {% when "hidden" %}
                    {% assign styleTitle = "display: none;" %}
            {% endcase %}
            <h2 class="showcase-title" style="{{ styleTitle }}">
                {{ showcaseSection.name }}
            </h2>
        {% endif %}
        <div class="showcase-products showcase-products_{{ sectionConfig.display }} showcase-products_{{ sectionConfig.display }}__{{ sectionConfig.columnQuantity }}">
            {% case sectionConfig.display %}
                {% when 'grid' %}
                    <ul class="showcase-list">
                        {%- render 'sections/showcase-model-product', showcaseSection: showcaseSection, sectionConfig: sectionConfig, products: products, renderModelExample: true, themeConfig: themeConfig -%}
                    </ul>
                {% when 'carousel' %}
                    <div class="showcase-list showcase-list-{{ sectionConfig.columnQuantity }}">
                        <ul class="showcase-slider showcase-slider-{{ sectionConfig.columnQuantity }}">
                            {%- render 'sections/showcase-model-product', showcaseSection: showcaseSection, sectionConfig: sectionConfig, products: products, renderModelExample: true, themeConfig: themeConfig -%}
                        </ul>
                        <div class="controls controls-arrow" aria-label="Carousel Navigation" tabindex="0">
                            <button class="slider__arrow slider__arrow--prev" aria-label="Anterior">
                                {{ themeConfig.icons.arrow.prev }}
                            </button>
                            <button class="slider__arrow slider__arrow--next" aria-label="Próximo">
                                {{ themeConfig.icons.arrow.next }}
                            </button>
                        </div>
                    </div>
            {% endcase %}
        </div>
    </div>
</section>
