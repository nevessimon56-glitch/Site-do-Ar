<div class="sidenav-overlay sidenav-order sidenav-order_cancel"
     x-data="setupOrderModal()"
     x-init="init()"
     x-on:cancel-order.window="cancelOrder($event.detail)"
>
    <form class="sidenav-container form-order" x-on:submit.prevent>
        <div class="sidenav-header sidenav-order_header">
            <a class="btn-sidenav-close float-right" href="javascript:void(0)" aria-label="Fechar" onclick="closeSideNavOverlay()">
                {{ themeConfig.icons.close }}
            </a>
            <template x-if="state.cancellationRequest.length > 0">
                <div class="sidenav-title">
                    Acompanhar cancelamento
                </div>
            </template>
            <template x-if="state.cancellationRequest.length < 1">
                <div class="sidenav-title">
                    Solicitar Cancelamento do Pedido
                </div>
            </template>
        </div>

        <template x-if="state.cancellationRequest.length > 0">
            <div class="sidenav-body sidenav-order_body sidenav-order_body--chat">
                <div class="order-cancel-panel panel">
                    <div class="order-cancel-panel__head panel-header">
                        <div class="order-cancel-panel__badge">
                            Pedido <strong x-text="state.orderId"></strong>
                        </div>
                    </div>
                    <div class="order-cancel-panel__messages panel-body">
                        <template x-for="(orderCancel, index) in state.cancellationRequest" :key="index">
                            <div class="order-cancel-tile tile"
                                 :class="orderCancel?.metadata?.anser ? 'order-cancel-tile--reply' : 'order-cancel-tile--customer'">
                                <div class="order-cancel-tile__icon tile-icon">
                                    <template x-if="orderCancel?.metadata?.anser && orderCancel?.metadata?.slug">
                                        <figure class="avatar order-cancel-avatar"
                                                :class="(orderCancel.metadata.slug) === (state.statusCancel.aceito) ? 'avatar_success order-cancel-avatar--success' : 'avatar_warning order-cancel-avatar--warning'">
                                            <template x-if="(orderCancel.metadata.slug) === (state.statusCancel.aceito)">
                                                {{ themeConfig.icons.order.check }}
                                            </template>
                                            <template x-if="(orderCancel.metadata.slug) === (state.statusCancel.recusado)">
                                                {{ themeConfig.icons.order.close }}
                                            </template>
                                        </figure>
                                    </template>
                                    <template x-if="!orderCancel.metadata.anser">
                                        <figure class="avatar order-cancel-avatar"
                                                :class="(orderCancel?.metadata?.name?.length > 0) && (orderCancel.metadata.name !== state.customerName) ? 'order-cancel-avatar--store' : 'order-cancel-avatar--client'">
                                            <template x-if="orderCancel.metadata.name === state.customerName">
                                                {{ themeConfig.icons.order.client }}
                                            </template>
                                            <template x-if="(orderCancel?.metadata?.name?.length > 0) && (orderCancel.metadata.name !== state.customerName)">
                                                {{ themeConfig.icons.order.store }}
                                            </template>
                                            <template x-if="(!orderCancel?.metadata?.name?.length)">
                                                {{ themeConfig.icons.order.client }}
                                            </template>
                                        </figure>
                                    </template>
                                </div>
                                <div class="order-cancel-tile__content tile-content">
                                    <template x-if="orderCancel.metadata.name">
                                        <div class="order-cancel-tile__meta tile-subtitle">
                                            <span class="order-cancel-tile__label">Respondido por</span>
                                            <span class="order-cancel-tile__value" x-text="orderCancel.metadata.name"></span>
                                        </div>
                                    </template>
                                    <template x-if="orderCancel.metadata.anser">
                                        <div class="order-cancel-tile__meta tile-subtitle">
                                            <span class="order-cancel-tile__label">Data da resposta</span>
                                            <span class="order-cancel-tile__value" x-text="StoreSDK.utils.toDateLocale(orderCancel.createdAt)"></span>
                                        </div>
                                        <template x-if="orderCancel?.metadata?.slug">
                                            <div class="order-cancel-tile__status"
                                                 :class="(orderCancel.metadata.slug) === (state.statusCancel.aceito) ? 'order-cancel-tile__status--approved' : 'order-cancel-tile__status--denied'">
                                                <span x-text="(orderCancel.metadata.slug) === (state.statusCancel.aceito) ? 'Cancelamento aprovado' : 'Cancelamento recusado'"></span>
                                            </div>
                                        </template>
                                    </template>
                                    <template x-if="!orderCancel.metadata.anser">
                                        <div class="order-cancel-tile__meta tile-subtitle">
                                            <span class="order-cancel-tile__label">Data da mensagem</span>
                                            <span class="order-cancel-tile__value" x-text="StoreSDK.utils.toDateTimeLocale(orderCancel.createdAt)"></span>
                                        </div>
                                    </template>
                                    <div class="order-cancel-tile__message">
                                        <p x-text="orderCancel.message"></p>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                    <template x-if="!state.messageClosed">
                        <div class="order-cancel-panel__footer panel-footer">
                            <div class="order-cancel-compose input-group">
                                <input id="order-cancel-followup"
                                       class="form-input order-cancel-compose__input"
                                       name="message"
                                       type="text"
                                       placeholder="Digite sua mensagem..."
                                       x-model="state.order.message"
                                       @focus="scrollActiveField($event.target)"
                                       @keydown.enter.prevent="sendOrderCancellation(false)"/>
                                <button class="btn order-cancel-compose__btn input-group-btn"
                                        type="button"
                                        @click="sendOrderCancellation(false)">
                                    ENVIAR
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </template>

        <template x-if="!state.cancellationRequest.length">
            <div class="sidenav-order_request">
                <div class="sidenav-body sidenav-order_body">
                    <p class="s-subtitle sidenav-order_intro">
                        Informe o motivo do cancelamento
                    </p>
                    <div class="form-group order-cancel-form"
                         :class="{ 'has-error': state.errors.message }">
                        <label class="form-label" for="order-cancel-reason">Digite o motivo *</label>
                        <textarea id="order-cancel-reason"
                                  class="form-input order-cancel-form__textarea"
                                  name="message"
                                  rows="5"
                                  placeholder="Descreva o motivo do cancelamento..."
                                  x-model="state.order.message"
                                  @focus="scrollActiveField($event.target)"
                                  :disabled="state.cancellationWasRequested"></textarea>
                        <p class="form-input-hint" x-text="state.errors.message"></p>
                    </div>
                </div>
                <div class="sidenav-footer sidenav-order_footer">
                    <div class="form-group">
                        <button class="btn btn-login btn-block order-cancel-form__submit"
                                type="button"
                                aria-label="Enviar solicitação de cancelamento"
                                @click="sendOrderCancellation(true)">
                            ENVIAR
                        </button>
                    </div>
                </div>
            </div>
        </template>
    </form>
</div>

<script>
    function setupOrderModal() {
        const state = {
            order: {
                message: ''
            },
            cancellationRequest: [],
            cancellationWasRequested: false,
            errors: {
                message: ''
            },
            orderId: null,
            messageClosed: false,
            customerName: '',
            statusCancel: {
                aberto: 'refund.request',
                aceito: 'refund.accepted',
                recusado: 'refund.denied',
            },
        }

        function validate() {
            const errors = {};

            if (!this.state.order.message) {
                errors.message = 'Informe o motivo do cancelamento';
            }

            this.state.errors = errors;
            return Object.keys(errors).length === 0;
        }

        function cancelOrder(data) {
            if (data?.orderId?.length < 0) {
                notyf.open({
                    type: 'warning',
                    message: 'Não foi possível enviar a solicitação. Tente novamente mais tarde.'
                });
                setTimeout(function () {
                    closeLoadingSideOverlay('.sidenav-order');
                }, 500);
            }

            this.state.cancellationRequest = [];
            this.state.cancellationWasRequested = data?.cancellationWasRequested || false

            this.state.orderId = data.orderId;
            if (data?.cancellationRequest?.length > 0) {
                this.state.cancellationRequest = data.cancellationRequest;
                this.state.messageClosed = data.cancellationRequest.some((itemCancel) => (itemCancel?.metadata?.slug === this.state.statusCancel.aceito || itemCancel?.metadata?.slug === this.state.statusCancel.recusado));
            }
            this.state.customerName = data?.customerName || '';
        }

        function scrollActiveField(field) {
            if (!field || window.innerWidth > 767) {
                return;
            }

            const scrollField = function () {
                const viewport = window.visualViewport;
                if (!viewport) {
                    field.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    return;
                }

                const visibleTop = viewport.offsetTop + 12;
                const visibleBottom = viewport.offsetTop + viewport.height - 12;
                const rect = field.getBoundingClientRect();
                const compose = field.closest('.order-cancel-compose, .order-cancel-form, .order-cancel-panel__footer, .sidenav-order_footer');

                if (rect.bottom > visibleBottom || rect.top < visibleTop) {
                    if (compose) {
                        compose.scrollIntoView({ block: 'end', behavior: 'smooth' });
                    } else {
                        field.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                }
            };

            setTimeout(scrollField, 80);
            setTimeout(scrollField, 320);
        }

        function updateKeyboardInset() {
            const root = document.querySelector('.sidenav-order_cancel');
            if (!root || window.innerWidth > 767) {
                if (root) {
                    root.style.removeProperty('--order-cancel-keyboard-inset');
                }
                return;
            }

            const viewport = window.visualViewport;
            if (!viewport) {
                return;
            }

            const keyboardInset = Math.max(0, window.innerHeight - viewport.height - viewport.offsetTop);
            root.style.setProperty('--order-cancel-keyboard-inset', keyboardInset + 'px');

            if (keyboardInset > 60) {
                root.classList.add('keyboard-open');
            } else {
                root.classList.remove('keyboard-open');
            }
        }

        function init() {
            const root = document.querySelector('.sidenav-order_cancel');
            if (!root || root.dataset.keyboardInsetBound === '1') {
                return;
            }

            root.dataset.keyboardInsetBound = '1';

            const onViewportChange = function () {
                updateKeyboardInset();
            };

            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', onViewportChange);
                window.visualViewport.addEventListener('scroll', onViewportChange);
            }

            window.addEventListener('resize', onViewportChange);
        }

        function sendOrderCancellation(isStart) {
            if (this.state.orderId < 0) {
                return;
            }
            if (!isStart && !this.state.order.message) {
                return;
            }

            if (!this.validate()) {
                return;
            }
            openLoadingSideOverlay('.sidenav-order');
            StoreSDK.request.post(`/ajax/order/cancel/${this.state.orderId}`, this.state.order)
                .then((response) => {
                    if (response?.order?.metadata !== '') {
                        this.state.cancellationWasRequested = true;
                        this.state.cancellationRequest.push(
                            {
                                orderId: response?.order?.orderId || 0,
                                metadata: response.order.metadata,
                                message: response?.order?.message || '',
                                createdAt: response?.order?.createdAt || '',
                            }
                        );
                    }

                    this.state.order.message = '';

                    notyf.open({
                        type: 'success',
                        message: 'Solicitação enviada com sucesso. Agora é só acompanhar o pedido. O pedido será cancelado após a aprovação da loja.',
                    });
                    setTimeout(function () {
                        closeLoadingSideOverlay('.sidenav-order');
                    }, 500);

                }).catch(() => {
                    notyf.open({
                        type: 'warning',
                        message: 'Não foi possível enviar a solicitação. Tente novamente mais tarde.',
                    });
                    setTimeout(function () {
                        closeLoadingSideOverlay('.sidenav-order');
                    }, 500);
                });
        }

        return {
            state,
            init,
            cancelOrder,
            validate,
            scrollActiveField,
            sendOrderCancellation
        }
    }
</script>

