<div class="sidenav-overlay sidenav-order" x-data="setupSidenavOrder()" x-init="init()">
    <div class="sidenav-container">
        <div class="sidenav-header">
            <a class="btn-sidenav-close float-right" href="javascript:void(0)" aria-label="Fechar" onclick="closeSideNavOverlay()">
                <svg class="icon_close" x="0px" y="0px" viewBox="0 0 512.001 512.001">
                    <path d="M284.286,256.002L506.143,34.144c7.811-7.811,7.811-20.475,0-28.285c-7.811-7.81-20.475-7.811-28.285,0L256,227.717L34.143,5.859c-7.811-7.811-20.475-7.811-28.285,0c-7.81,7.811-7.811,20.475,0,28.285l221.857,221.857L5.858,477.859c-7.811,7.811-7.811,20.475,0,28.285c3.905,3.905,9.024,5.857,14.143,5.857c5.119,0,10.237-1.952,14.143-5.857L256,284.287l221.857,221.857c3.905,3.905,9.024,5.857,14.143,5.857s10.237-1.952,14.143-5.857c7.811-7.811,7.811-20.475,0-28.285L284.286,256.002z"></path>
                </svg>
            </a>
            <div class="sidenav-title"
                 x-text="messages.length ? 'Acompanhar pedido' : 'Solicitar Cancelamento do Pedido'"></div>
        </div>
        <div class="sidenav-body">
            <p class="s-subtitle" x-show="!messages.length">Informe o motivo do cancelamento</p>
            <p class="order-cancel-id" x-show="orderId">
                Pedido ID: <strong x-text="orderId"></strong>
            </p>
            <div class="panel" x-show="messages.length">
                <template x-for="(message, messageIndex) in messages" :key="messageIndex">
                    <div class="tile">
                        <div class="tile-content">
                            <div class="avatar">
                                <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                                </svg>
                            </div>
                            <div class="tile-body">
                                <div class="tile-title">
                                    Respondido por:
                                    <span x-text="message.respondedBy || message.userName || message.name || 'Você'"></span>
                                </div>
                                <div class="tile-subtitle">
                                    Data da mensagem:
                                    <span x-text="formatDateTime(message.createdAt || message.date)"></span>
                                </div>
                                <div class="tile-text" x-text="message.message || message.text || message.reason"></div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
            <div class="form-group" :class="{ 'has-error': !!errors.message }">
                <label class="form-label" for="order-cancel-reason">Digite o motivo *</label>
                <textarea id="order-cancel-reason"
                          class="form-input"
                          rows="5"
                          x-model="message"
                          @input="errors = {}"></textarea>
                <p class="form-input-hint" x-text="errors.message"></p>
            </div>
        </div>
        <div class="sidenav-footer">
            <div class="form-group">
                <button class="btn btn-login btn-block btn-order-cancel-send"
                        type="button"
                        @click.prevent="sendCancellation()"
                        :disabled="sending"
                        x-text="sending ? 'ENVIANDO...' : 'ENVIAR'"
                        aria-label="Enviar"></button>
            </div>
        </div>
    </div>
</div>

<script>
    function setupSidenavOrder() {
        const customerOrders = {{ customerOrders | json }} || {};
        let listenerBound = false;

        function getApiErrorMessage(error) {
            if (!error) {
                return 'Não foi possível enviar a solicitação de cancelamento.';
            }

            if (typeof error === 'string') {
                return error;
            }

            const data = error.data || error.response || error.body || error;

            if (typeof data === 'string') {
                return data;
            }

            return data.message
                || data.error
                || data.errors?.message
                || (Array.isArray(data.errors) ? data.errors[0] : null)
                || error.message
                || 'Não foi possível enviar a solicitação de cancelamento.';
        }

        return {
            orderId: null,
            orderHash: null,
            message: '',
            messages: [],
            errors: {},
            customerName: '',
            sending: false,

            init() {
                if (listenerBound) {
                    return;
                }

                listenerBound = true;

                window.addEventListener('cancel-order', (event) => {
                    const detail = event.detail || {};

                    this.orderId = detail.orderId;
                    this.orderHash = detail.orderHash || null;
                    this.customerName = detail.customerName || '';
                    this.message = '';
                    this.errors = {};
                    this.sending = false;

                    if (!this.orderHash) {
                        const order = customerOrders?.result?.find((item) => Number(item.id) === Number(detail.orderId));
                        this.orderHash = order?.hash || null;
                    }

                    if (Array.isArray(detail.cancellationRequest) && detail.cancellationRequest.length) {
                        this.messages = detail.cancellationRequest;
                        return;
                    }

                    const order = customerOrders?.result?.find((item) => Number(item.id) === Number(detail.orderId));
                    if (Array.isArray(order?.cancellationRequest) && order.cancellationRequest.length) {
                        this.messages = order.cancellationRequest;
                        return;
                    }

                    this.messages = [];
                    this.loadCancellationMessages(detail.orderId);
                });
            },

            loadCancellationMessages(orderId) {
                if (!orderId) {
                    return;
                }

                StoreSDK.request.get(`/ajax/customer/order/cancellation/${orderId}`)
                    .then((response) => {
                        const loadedMessages = response?.result || response?.messages || response?.cancellationRequest;
                        if (Array.isArray(loadedMessages) && loadedMessages.length) {
                            this.messages = loadedMessages;
                        }
                    })
                    .catch(() => {});
            },

            formatDateTime(dateValue) {
                if (!dateValue) {
                    return '';
                }

                const date = new Date(dateValue);
                if (Number.isNaN(date.getTime())) {
                    return dateValue;
                }

                return date.toLocaleString('pt-BR', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                }).replace(',', ' -');
            },

            getMessageValue() {
                const textarea = document.getElementById('order-cancel-reason');
                return (this.message || textarea?.value || '').trim();
            },

            validate() {
                if (!this.getMessageValue()) {
                    this.errors = { message: 'Por favor, informe o motivo do cancelamento' };
                    return false;
                }

                this.errors = {};
                return true;
            },

            sendCancellation() {
                if (!this.orderId || this.sending || !this.validate()) {
                    return;
                }

                const message = this.getMessageValue();
                this.sending = true;

                if (typeof openLoadingSideOverlay === 'function') {
                    openLoadingSideOverlay('.sidenav-order');
                }

                const payload = {
                    orderId: this.orderId,
                    message: message
                };

                if (this.orderHash) {
                    payload.hash = this.orderHash;
                }

                StoreSDK.request.post('/ajax/customer/order/cancellation', payload)
                    .then((response) => {
                        const responseMessages = response?.result || response?.messages || response?.cancellationRequest;

                        if (Array.isArray(responseMessages)) {
                            this.messages = responseMessages;
                        } else {
                            this.messages = this.messages.concat([{
                                message: message,
                                createdAt: new Date().toISOString(),
                                respondedBy: this.customerName || 'Você'
                            }]);
                        }

                        const order = customerOrders?.result?.find((item) => Number(item.id) === Number(this.orderId));
                        if (order) {
                            order.cancellationRequest = this.messages;
                        }

                        this.message = '';
                        this.errors = {};

                        if (typeof closeLoadingSideOverlay === 'function') {
                            closeLoadingSideOverlay('.sidenav-order');
                        }

                        this.sending = false;

                        if (typeof notyf !== 'undefined') {
                            notyf.success('Solicitação enviada com sucesso. Agora é só acompanhar o pedido. O pedido será cancelado após a aprovação da loja.');
                        }
                    })
                    .catch((error) => {
                        if (typeof closeLoadingSideOverlay === 'function') {
                            closeLoadingSideOverlay('.sidenav-order');
                        }

                        this.sending = false;

                        const apiMessage = getApiErrorMessage(error);
                        this.errors = { message: apiMessage };

                        if (typeof notyf !== 'undefined') {
                            notyf.open({
                                type: 'warning',
                                message: apiMessage
                            });
                        }
                    });
            }
        };
    }
</script>
