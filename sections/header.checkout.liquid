<header class="header header-checkout">
    <div class="header-content content">
        <div class="container">
            <div class="navbar">
                <div class="navbar-section">
                    <a class="logo" href="/" title="{{ store.name }}">
                        <h1>{{ store.name }}</h1>
                        {% if theme.logo.path %}
                            <picture>
                                <img class="lazy" data-src="{{ theme.logo.path | imgUrl: 260 }}" alt="{% if theme.logo.title and theme.logo.title != '' %}{{ theme.logo.title }}{% else %}{{ store.name }}{% endif %}">
                            </picture>
                        {% else %}
                            {{ themeConfig.icons.image }}
                        {% endif %}
                    </a>
                </div>
                <div class="navbar-section">
                    <div class="header-link header-link_ssl" href="javascript:void(0)" title="Site Seguro">
                        <div class="icon-ssl">{{ iconSecurity }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
