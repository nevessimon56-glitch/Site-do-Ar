{% layout 'layout/theme' %}
{% block content %}
{% render 'sections/header', store: store, menu: menu, theme: theme, cart: cart, seo: seo, themeConfig: themeConfig %}
<main class="account-main change-account-main">
    <div class="account-content content">
        <div class="account-container container">
            <div class="columns">
                <div class="column col-12 hide-xxl show-lg">
                    <details class="page-accordion page-accordion_top accordion">
                        <summary class="accordion-header">
                            <div class="accordion-title">
                                <span>
                                    Painel do cliente
                                </span>
                            </div>
                            {{ themeConfig.icons.arrow.down }}
                        </summary>
                        <div class="accordion-body">
                            {%- render 'sections/customer-account-menu', themeConfig: themeConfig -%}
                        </div>
                    </details>
                </div>
                <div class="column col-3 col-xxl-4 hide-lg">
                    <div class="card card-pages-nav">
                        <div class="card-header">
                            Painel do cliente
                        </div>
                        <div class="card-body">
                            {%- render 'sections/customer-account-menu', themeConfig: themeConfig -%}
                        </div>
                    </div>
                </div>
                <div class="column col-9 col-xxl-8 col-lg-12">
                    <div id="form-account" class="card card-page card-page-form" x-data="setupAccount()" x-on:change-customer-account.window="changeAccount($event.detail.customer)">
                        <div class="card-header">
                            <h1 class="card-title">
                                Dados cadastrais
                            </h1>
                            <p class="card-text">
                                Por favor, preencha os campos abaixo corretamente.
                            </p>
                        </div>
                        <div class="card-body">
                            <form x-on:submit.prevent>
                                <div class="columns">
                                    <div class="column col-4 col-md-12">
                                        <div class="form-group form-group_custom">
                                            <select x-model="state.customer.typePerson" id="selectTypeUser"
                                                    class="form-select" @change="loadInputMaskAccount()">
                                                    {% if store.acceptedDocuments contains 'cpf' %}
                                                    <option value="F">Pessoa física</option>
                                                    {% endif %}
                                                    {% if store.acceptedDocuments contains "cnpj" %}
                                                    <option value="J">Pessoa jurídica</option>
                                                    {% endif %}
                                                    {% if store.acceptedDocuments contains "others" %}
                                                    <option value="E">Outros(Estrangeiro)</option>
                                                    {% endif %}
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Start - Física -->
                                    <div class="column col-8 col-md-12" x-show="state.customer.typePerson === 'F'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.name === '' || typeof state.customer.name === 'undefined' }">
                                            <label class="form-label" for="name">Nome completo *</label>
                                            <input
                                                    id="name"
                                                    name="name"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.name }"
                                                    autocomplete="name"
                                                    autofocus="autofocus"
                                                    type="text"
                                                    x-model="state.customer.name"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.name"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6" x-show="state.customer.typePerson === 'F'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.document === '' || typeof state.customer.document === 'undefined' }">
                                            <label class="form-label" for="cpf">CPF *</label>
                                            <input
                                                    :class="{ 'is-error': !!state.errors.document }"
                                                    class="form-input masked-input-account"
                                                    data-mask="###.###.###-##"
                                                    id="cpf"
                                                    name="cpf"
                                                    type="tel"
                                                    x-model="state.customer.document"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.document"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6" x-show="state.customer.typePerson === 'F'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.secondaryDocument === '' || typeof state.customer.secondaryDocument === 'undefined' }">
                                            <label class="form-label" for="rg">RG</label>
                                            <input
                                                    id="rg"
                                                    name="rg"
                                                    class="form-input masked-input-account"
                                                    type="text"
                                                    x-model="state.customer.secondaryDocument"
                                            >
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'F'">
                                        <div class="form-group form-group_custom">
                                            <label class="form-label" for="genre">Sexo</label>
                                            <div class="form-group">
                                                <select
                                                        id="genre"
                                                        name="genre"
                                                        class="form-select"
                                                        x-model="state.customer.genre"
                                                >
                                                    <option value="M">Masculino</option>
                                                    <option value="F">Feminino</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'F'">
                                        <div class="form-group form-group_custom__placeholder">
                                            <label class="form-label" for="birth-date">Data do nascimento</label>
                                            <input
                                                    id="birth-date"
                                                    name="birth-date"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.birthDate }"
                                                    autocomplete="bday"
                                                    data-mask='["##/##/##", "##/##/####"]'
                                                    type="tel"
                                                    x-model="state.customer.birthDate"
                                                    placeholder="DD/MM/AAAA"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.birthDate"></p>
                                        </div>
                                    </div>
                                    <!-- End - Física -->
                                    <!-- Start - Jurídica -->
                                    <div class="column col-8 col-md-12" x-show="state.customer.typePerson === 'J'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.name === '' || typeof state.customer.name === 'undefined' }">
                                            <label class="form-label" for="corporate-name">Razão social *</label>
                                            <input
                                                    id="corporate-name"
                                                    name="corporate-name"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.name }"
                                                    autocomplete="organization"
                                                    autofocus="autofocus"
                                                    type="text"
                                                    x-model="state.customer.name"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.name"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12 col-md-12" x-show="state.customer.typePerson === 'J'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.document === '' || typeof state.customer.document === 'undefined' }">
                                            <label class="form-label" for="cnpj">CNPJ *</label>
                                            <input
                                                    id="cnpj"
                                                    name="cnpj"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.document }"
                                                    data-mask='["###.###.###-##", "##.###.###/####-##"]'
                                                    autocomplete="document"
                                                    type="tel"
                                                    x-model="state.customer.document"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.document"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'J'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.secondaryDocument === '' || typeof state.customer.secondaryDocument === 'undefined' }">
                                            <label class="form-label" for="state-registration">
                                                Inscrição Estadual
                                            </label>
                                            <input
                                                    id="state-registration"
                                                    name="state-registration"
                                                    class="form-input masked-input-account"
                                                    type="text"
                                                    x-model="state.customer.secondaryDocument"
                                            >
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'J'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.fantasyName === '' || typeof state.customer.fantasyName === 'undefined' }">
                                            <label class="form-label" for="fantasy-name">Nome fantasia *</label>
                                            <input
                                                    id="fantasy-name"
                                                    name="fantasy-name"
                                                    class="form-input"
                                                    type="text"
                                                    x-model="state.customer.fantasyName"
                                                    :class="{ 'is-error': !!state.errors.fantasyName }"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.fantasyName"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'J'">
                                        <div class="form-group form-group_custom__placeholder">
                                            <label class="form-label" for="date">Data de fundação</label>
                                            <input
                                                    id="date"
                                                    name="date"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.birthDate }"
                                                    autocomplete="bday"
                                                    data-mask='["##/##/##", "##/##/####"]'
                                                    type="tel"
                                                    x-model="state.customer.birthDate"
                                                    placeholder="DD/MM/AAAA"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.birthDate"></p>
                                        </div>
                                    </div>
                                    <!-- End - Jurídica -->
                                    <!-- Start - Estrangeira -->
                                    <div class="column col-8 col-md-12" x-show="state.customer.typePerson === 'E'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.name === '' || typeof state.customer.name === 'undefined' }">
                                            <label class="form-label" for="name">Nome completo *</label>
                                            <input
                                                    id="name"
                                                    name="name"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.name }"
                                                    autocomplete="name"
                                                    autofocus="autofocus"
                                                    type="text"
                                                    x-model="state.customer.name"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.name"></p>
                                        </div>
                                    </div>
                                    <div class="column col-12" x-show="state.customer.typePerson === 'E'">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.document === '' || typeof state.customer.document === 'undefined' }">
                                            <label class="form-label" for="passport">Passaporte *</label>
                                            <input
                                                    id="passport"
                                                    name="passport"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.document }"
                                                    type="tel"
                                                    x-model="state.customer.document"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.document"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'E'">
                                        <div class="form-group form-group_custom">
                                            <label class="form-label" for="genre">Sexo</label>
                                            <div class="form-group">
                                                <select
                                                        id="genre"
                                                        name="genre"
                                                        class="form-select"
                                                        x-model="state.customer.genre"
                                                >
                                                    <option value="M">Masculino</option>
                                                    <option value="F">Feminino</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12" x-show="state.customer.typePerson === 'E'">
                                        <div class="form-group form-group_custom__placeholder">
                                            <label class="form-label" for="birth-date">Data do nascimento</label>
                                            <input
                                                    id="birth-date"
                                                    name="birth-date"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.birthDate }"
                                                    autocomplete="bday"
                                                    data-mask='["##/##/##", "##/##/####"]'
                                                    type="tel"
                                                    x-model="state.customer.birthDate"
                                                    placeholder="DD/MM/AAAA"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.birthDate"></p>
                                        </div>
                                    </div>
                                    <!-- End - Estrangeira -->
                                </div>
                                <div class="columns">
                                    <div class="column col-6">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.cellphone === '' || typeof state.customer.cellphone === 'undefined' }">
                                            <label class="form-label" for="cellphone">Celular *</label>
                                            <input
                                                    id="cellphone"
                                                    name="cellphone"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.cellphone }"
                                                    type="tel"
                                                    data-mask='["(##) #####-####", "(##) ####-####"]'
                                                    x-model="state.customer.cellphone"
                                                    :disabled="old.customer.cellphone"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.cellphone"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6">
                                        <div class="form-group form-group_custom"
                                             :class="{ 'onFocus': state.customer.phone === '' || typeof state.customer.phone === 'undefined' }">
                                            <label class="form-label" for="tel">Telefone fixo</label>
                                            <input
                                                    id="tel"
                                                    name="tel"
                                                    class="form-input masked-input-account"
                                                    type="tel"
                                                    autocomplete="tel"
                                                    data-mask='["(##) #####-####", "(##) ####-####"]'
                                                    x-model="state.customer.phone"
                                                    :class="{ 'is-error': !!state.errors.phone }"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.phone"></p>
                                        </div>
                                    </div>
                                    <div class="column col-12">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.email === '' || typeof state.customer.email === 'undefined' }">
                                            <label class="form-label" for="email">Email *</label>
                                            <input
                                                    id="email"
                                                    name="email"
                                                    class="form-input"
                                                    type="email"
                                                    autocomplete="email"
                                                    x-model="state.customer.email"
                                                    :disabled="old.customer.email"
                                                    :class="{ 'is-error': !!state.errors.email }"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.email"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column col-3 col-xl-12">
                                        <div class="form-group form-group_custom"
                                             :class="{ 'onFocus': state.customer.mainAddress.zipcode === '' || typeof state.customer.mainAddress.zipcode === 'undefined' }">
                                            <label class="form-label" for="zipcode">CEP *</label>
                                            <input
                                                    id="zipcode"
                                                    name="zipcode"
                                                    class="form-input masked-input-account"
                                                    :class="{ 'is-error': !!state.errors.zipcode }"
                                                    data-mask='#####-###'
                                                    autocomplete="postal-code"
                                                    type="tel"
                                                    x-model="state.customer.mainAddress.zipcode"
                                                    @focusout="handleZipcodeChange()"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.zipcode"></p>
                                        </div>
                                    </div>
                                    <div class="column col-7 col-xl-9">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.mainAddress.street === '' || typeof state.customer.mainAddress.street === 'undefined' }">
                                            <label class="form-label" for="street">Endereço *</label>
                                            <input
                                                    id="street"
                                                    name="street"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.street }"
                                                    autocomplete="street-address[0]"
                                                    type="text"
                                                    x-model="state.customer.mainAddress.street"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.street"></p>
                                        </div>
                                    </div>
                                    <div class="column col-2 col-xl-3">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.mainAddress.number === '' || typeof state.customer.mainAddress.number === 'undefined' }">
                                            <label class="form-label" for="number">Número *</label>
                                            <input
                                                    id="number"
                                                    name="number"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.number }"
                                                    type="text"
                                                    x-model="state.customer.mainAddress.number"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.number"></p>
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.mainAddress.complement === '' || typeof state.customer.mainAddress.complement === 'undefined' }">
                                            <label class="form-label" for="complement">Complemento</label>
                                            <input
                                                    id="complement"
                                                    name="complement"
                                                    class="form-input"
                                                    type="text"
                                                    x-model="state.customer.mainAddress.complement"
                                            >
                                        </div>
                                    </div>
                                    <div class="column col-6 col-md-12">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.mainAddress.district === '' || typeof state.customer.mainAddress.district === 'undefined' }">
                                            <label class="form-label" for="district">Bairro *</label>
                                            <input
                                                    id="district"
                                                    name="district"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.district }"
                                                    type="text"
                                                    x-model="state.customer.mainAddress.district"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.district"></p>
                                        </div>
                                    </div>
                                    <div class="column col-4 col-md-12">
                                        <div class="form-group form-group_custom" :class="{ 'onFocus': state.customer.mainAddress.city === '' || typeof state.customer.mainAddress.city === 'undefined' }">
                                            <label class="form-label" for="city">Cidade *</label>
                                            <input
                                                    id="city"
                                                    name="city"
                                                    class="form-input"
                                                    :class="{ 'is-error': !!state.errors.city }"
                                                    type="text"
                                                    x-model="state.customer.mainAddress.city"
                                            >
                                            <p class="form-input-hint" x-text="state.errors.city"></p>
                                        </div>
                                    </div>
                                    <div class="column col-4 col-md-12">
                                        <div class="form-group form-group_custom">
                                            <label class="form-label" for="state">Estado *</label>
                                            <select
                                                    id="state"
                                                    name="state"
                                                    class="form-select"
                                                    x-model="state.customer.mainAddress.state"
                                            >
                                                <template x-for="(federation, index) in state.states" :key="index">
                                                    <option x-text="federation.value" :value="federation.value"></option>
                                                </template>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="column col-4 col-md-12">
                                        <div class="form-group form-group_custom">
                                            <label class="form-label" for="country">País *</label>
                                            <select
                                                    id="country"
                                                    name="country"
                                                    class="form-select"
                                                    autocomplete="country"
                                                    x-model="state.customer.mainAddress.country"
                                                    @change="fetchStates(state.customer.mainAddress.country)"
                                            >
                                                <template x-for="(country, index) in state.countries" :key="index">
                                                    <option x-text="country.name" :value="country.value"></option>
                                                </template>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column col-8 col-md-12">
                                        <div class="form-group form-group_send-email">
                                            <label class="form-checkbox">
                                                <input type="checkbox" :value="!state.customer.sendMail" x-model="state.customer.sendMail">
                                                <i class="form-icon"></i>
                                                Desejo receber avisos de ofertas de produtos e serviços
                                            </label>
                                        </div>
                                    </div>
                                    <div class="column col-4 col-md-12">
                                        <div class="form-group">
                                            <button
                                                    class="btn btn-login btn-block"
                                                    type="button"
                                                    aria-label="Salvar"
                                                    @click="saveUser()"
                                            >
                                                Salvar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% render 'sections/footer', store: store, customer: customer, cart: cart, pages: pages, payments: payments, stamps: stamps, social: social, themeConfig: themeConfig %}
<script>
    /** Start - Mask input */
    var customInputMaskAccount = null;

    function loadInputMaskAccount() {
        customInputMaskAccount = Maska.create('.masked-input-account');
    }

    function reloadInputMaskAccount() {
        if (customInputMaskAccount) {
            customInputMaskAccount.destroy();
        }
        customInputMaskAccount = Maska.create('.masked-input-account');
    }
    /** End - Mask input */
    function setupAccount() {
        const customTemp =
                {% if customer %}
            {
                name: {% if customer.name %}('{{ customer.name | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                document: {% if customer.document %}'{{ customer.document }}'{% else %}''{% endif %},
                typePerson: {% if customer.typePerson %}'{{ customer.typePerson }}'{% else %}''{% endif %},

                phone: {% if customer.phone %}'{{ customer.phone }}'{% else %}''{% endif %},
                cellphone: {% if customer.cellphone %}'{{ customer.cellphone }}'{% else %}''{% endif %},
                email: {% if customer.email %}'{{ customer.email }}'{% else %}''{% endif %},
                secondaryPhone: {% if customer.secondaryPhone %}'{{ customer.secondaryPhone }}'{% else %}''{% endif %},
                fantasyName: {% if customer.fantasyName %}('{{ customer.fantasyName | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                secondaryDocument: {% if customer.secondaryDocument %}('{{ customer.secondaryDocument | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},

                {% if customer.address %}
                address: [
                    {% for customerAddress in customer.address %}
                    {
                        street: {% if customerAddress.street %}('{{ customerAddress.street | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        receiver: {% if customerAddress.receiver %}('{{ customerAddress.receiver | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        number: {% if customerAddress.number %}('{{ customerAddress.number | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        zipcode: {% if customerAddress.zipcode %}'{{ customerAddress.zipcode }}'{% else %}''{% endif %},
                        complement: {% if customerAddress.complement %}('{{ customerAddress.complement | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        district: {% if customerAddress.district %}('{{ customerAddress.district | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        city: {% if customerAddress.city %}('{{ customerAddress.city | escape }}').replaceAll("&#39;", "'").replaceAll("&#34;", '"'){% else %}''{% endif %},
                        state: {% if customerAddress.state %}'{{ customerAddress.state }}'{% else %}''{% endif %},
                        country: {% if customerAddress.country %}'{{ customerAddress.country }}'{% else %}''{% endif %},
                        addressGroupId: {% if customerAddress.addressGroupId %}{{ customerAddress.addressGroupId }}{% else %}''{% endif %},
                        main: {% if customerAddress.main %}{{ customerAddress.main }}{% else %}false{% endif %},
                        userId: {% if customerAddress.userId %}{{ customerAddress.userId }}{% else %}''{% endif %},
                        createdAt: {% if customerAddress.createdAt %}'{{ customerAddress.createdAt }}'{% else %}''{% endif %},
                        id: {% if customerAddress.id %}{{ customerAddress.id }}{% else %}''{% endif %},
                    },
                    {% endfor %}
                ],
                {% endif %}
            };
        {% else %}
        { };
        {% endif %}

        let old = { customer: customTemp };
        let state = {
            customer: customTemp,
            countries: JSON.parse('{{ countries | json }}') || {},
            states: JSON.parse('{{ states | json }}') || {},
            errors: {
                name: '',
                document: '',
                cellphone: '',
                email: '',
                zipcode: '',
                street: '',
                number: '',
                district: '',
                city: '',
                birthdate: '',
            }
        }

        if (state.customer.address && !state.customer.address.length) {
            state.customer.address = [{ main: true, country: '' }];
        }

        if (state.customer.birthDate) {
            const dateSplit = state.customer.birthDate.split('-')
            state.customer.birthDate = `${dateSplit[2]}/${dateSplit[1]}/${dateSplit[0]}`;
        }

        state.customer.mainAddress = state.customer.address.find(adrs => adrs.main === true);

        state.customer.typePerson = state.customer.typePerson ? state.customer.typePerson : 'F';

        function fetchStates(country) {
            StoreSDK.request.get(`/user/${country}/states`)
                .then((response) => {
                    this.state.states = response.statesList;
                })
        }

        function changeAccount(customer) {
            if (customer) {
                let newCustomer = customer || '';

                if (customer.address && !customer.address.length) {
                    newCustomer.address = [{main: true, country: ''}];
                }

                if (customer.birthDate) {
                    const dateSplit = customer.birthDate.split('-')
                    newCustomer.birthDate = `${dateSplit[2].split('T')[0]}/${dateSplit[1]}/${dateSplit[0]}`;
                }

                newCustomer.typePerson = customer.typePerson ? customer.typePerson : 'F';

                newCustomer.email = customer.contacts.find((contact) => contact.contactGroupId === 1)?.value;
                newCustomer.emailId = customer.contacts.find((contact) => contact.contactGroupId === 1)?.id;
                newCustomer.cellphone = customer.contacts.find((contact) => contact.contactGroupId === 2)?.value;
                newCustomer.cellphoneId = customer.contacts.find((contact) => contact.contactGroupId === 2)?.id;
                newCustomer.phone = customer.contacts.find((contact) => contact.contactGroupId === 3)?.value;
                newCustomer.phoneId = customer.contacts.find((contact) => contact.contactGroupId === 3)?.id;

                newCustomer.mainAddress = customer.address.find(adrs => adrs.main === true);
                this.state.customer = newCustomer;
                loadInputMaskAccount();
            }
        }

        function validate() {
            this.state.errors = {};
            /*** Remover espaços brancos ***/
            this.state.customer.name = StoreSDK.utils.removeBlankSpaces(this.state.customer.name);
            this.state.customer.mainAddress.street = StoreSDK.utils.removeBlankSpaces(this.state.customer.mainAddress.street);
            this.state.customer.mainAddress.number = StoreSDK.utils.removeBlankSpaces(this.state.customer.mainAddress.number);
            this.state.customer.mainAddress.district = StoreSDK.utils.removeBlankSpaces(this.state.customer.mainAddress.district);
            this.state.customer.mainAddress.city = StoreSDK.utils.removeBlankSpaces(this.state.customer.mainAddress.city);

            if (this.state.customer.typePerson === 'F') {
                if (!StoreSDK.utils.validateFullName(this.state.customer.name)) {
                    this.state.errors.name = 'Informe o nome completo';
                }
            }

            if (this.state.customer.typePerson === 'J') {
                /*** Remover espaços brancos ***/
                this.state.customer.fantasyName = StoreSDK.utils.removeBlankSpaces(this.state.customer.fantasyName);
                if (!this.state.customer.name) {
                    this.state.errors.name = 'Informe o Razão Social';
                }
                if (!this.state.customer.fantasyName) {
                    this.state.errors.fantasyName = 'Informe o nome fantasia';
                }
            }

            if (this.state.customer.typePerson === 'F' && (!this.state.customer.document || !StoreSDK.utils.validateCpf(this.state.customer.document))) {
                this.state.errors.document = 'Informe o CPF corretamente';
            }

            if (this.state.customer.typePerson === 'J' && (!this.state.customer.document || !StoreSDK.utils.validateCnpj(this.state.customer.document))) {
                this.state.errors.document = 'Informe o CNPJ corretamente';
            }

            // Campo está preenchido e não é válido. Ex.: preencher a data "20/20/20"
            const data = new Date();
            if (this.state.customer.birthDate && Number(this.state.customer.birthDate.split('/')[2]) > data.getFullYear()) this.state.errors.birthDate = 'Ano deve ser menor ou igual a ano atual';
            if ((this.state.customer.birthDate && this.state.customer.birthDate.length < 10) || (this.state.customer.birthDate &&  !StoreSDK.utils.validateDate(this.state.customer.birthDate))) {
                this.state.errors.birthDate = 'Informe uma data válida';
            }

            if (!this.state.customer.cellphone && !this.state.customer.email) {
                this.state.errors.cellphone = 'Informe o email ou número de celular';
                this.state.errors.email = 'Informe o email ou número de celular';
            }

            if (this.state.customer.cellphone && ((this.state.customer.cellphone.length < 14) || (this.state.customer.cellphone.match(/(\d+)/)[0] < 1))) {
                this.state.errors.cellphone = 'Informe o número de celular corretamente';
            }

            if (this.state.customer.phone && ((this.state.customer.phone.length < 14) || (this.state.customer.phone.match(/(\d+)/)[0] < 1))) {
                this.state.errors.phone = 'Informe o número do telefone corretamente';
            }

            if (this.state.customer.email && !StoreSDK.utils.validateEmail(this.state.customer.email)) {
                /*** Remover espaços brancos ***/
                this.state.customer.email = StoreSDK.utils.removeBlankSpaces(this.state.customer.email);

                this.state.errors.email = 'Informe um email válido';
            }

            if (!this.state.customer.mainAddress.zipcode) {
                this.state.errors.zipcode = 'Informe o CEP';
            } else if (this.state.customer.mainAddress.zipcode && ((this.state.customer.mainAddress.zipcode.length < 9) || (this.state.customer.mainAddress.zipcode.match(/(\d+)/)[0] < 1))) {
                this.state.errors.zipcode = 'Informe o CEP corretamente';
            }

            if (!this.state.customer.mainAddress.street) {
                this.state.errors.street = 'Informe a rua';
            }

            if (!this.state.customer.mainAddress.number) {
                this.state.errors.number = 'Informe o número';
            }

            if (!this.state.customer.mainAddress.district) {
                this.state.errors.district = 'Informe o bairro';
            }

            if (!this.state.customer.mainAddress.city) {
                this.state.errors.city = 'Informe a cidade';
            }

            if (Object.keys(this.state.errors).length) {
                return false;
            }
            return true;
        }

        function saveUser() {
            if (!this.validate()) {
                document.getElementById("form-account").scrollIntoView({behavior: 'smooth'});
                return;
            }

            openLoadingMain();

            const body = JSON.parse(JSON.stringify(this.state.customer));

            if (body.birthDate) {
                body.birthDate = StoreSDK.utils.normalizeBRDate(body.birthDate);
            }

            body.address = body.address.map(addr => {
                if (addr.id === body.mainAddress.id) {
                    return body.mainAddress;
                }

                return addr;
            })

            StoreSDK.request.put('/ajax/customer/edit', body)
                .then((res) => {
                    closeLoadingMain();
                    if (typeof mb_track !== 'undefined') {
                        window.mb_track('accountSync', {
                            user: {
                                user_id: res?.id,
                                email: res.contacts?.find(contact => contact.contactGroupId === 1)?.value,
                                phone: res.contacts?.find(contact => contact.contactGroupId === 2)?.value,
                                name: res?.name || res?.fantasyName,
                            }
                        });
                    }
                    notyf.success('Cadastro atualizado com sucesso!');
                })
                .catch((error) => {
                    closeLoadingMain();
                    if (error.data && error.data.code && error.data.message) {
                        notyf.open({
                            type: 'warning',
                            message: error.data.message,
                        });
                    } else {
                        notyf.open({
                            type: 'warning',
                            message: 'Não foi possível salvar as edições',
                        });
                    }
                });
        }

        function handleZipcodeChange() {
            if (!this.state.customer.mainAddress.zipcode) {
                return;
            }

            StoreSDK.request.get(`/ajax/address/${this.state.customer.mainAddress.country || 'BR'}/${this.state.customer.mainAddress.zipcode}`)
                .then((response) => {
                    if (response.address) {
                        this.state.customer.mainAddress.street = response.address.street;
                        this.state.customer.mainAddress.district = response.address.district;
                        this.state.customer.mainAddress.city = response.address.city;
                        this.state.customer.mainAddress.state = response.address.state;
                    }
                });
        }

        return {
            state,
            old,
            validate,
            fetchStates,
            saveUser,
            handleZipcodeChange,
            changeAccount,
        }
    }
</script>
{% endblock %}
