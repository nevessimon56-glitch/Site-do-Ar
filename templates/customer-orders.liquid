<script>
    function setupOrders() {
        const state = {
            customer: {{ customer | json }} || {},
            customerOrders: {{ customerOrders | json }} || {}
        };

        function init() {
            if (this.state?.customerOrders?.result.length > 0) {
                this.state.customerOrders.result = this.state.customerOrders.result.map((order) => {
                    const orderProducts = order.products.map((product) => {
                        const reviewProduct = (order.reviews || []).find((review) => (Number(review.productId) === Number(product.productId)));
                        if (reviewProduct) {
                            return {
                                ...product,
                                review: reviewProduct
                            }
                        }
                        return {
                            ...product
                        }
                    });

                    return {
                        ...order,
                        paymentStatus: this.getPaymentStatusName(order),
                        products: orderProducts
                    };
                });
            }
        }

        function getPaymentStatusName(order) {
            let paymentStatus = '';
            if ((order.paymentStatusId === 1 || !order.paymentStatusId) && !getStatus(6, order)) {
                paymentStatus = 'Aguardando Pagamento';
            }
            if (order.paymentStatusId === 2 && !getStatus(6)) {
                paymentStatus = 'Pagamento Confirmado';
            }
            if (order.paymentStatusId === 3) {
                paymentStatus = 'Pagamento Reembolsado';
            }
            if (order.paymentStatusId === 4 && !getStatus(6)) {
                paymentStatus = 'Pagamento em Análise';
            }
            if (order.paymentStatusId === 6) {
                paymentStatus = 'Pagamento Reembolsado Parcialmente';
            }
            return paymentStatus;
        }

        function getStatus(statusId = null, order) {
            if (!statusId) {
                if (order.paymentStatusId === 2) {
                    return false;
                }

                const lastHistory = order.statusHistory[order.statusHistory.length - 1];
                if (lastHistory?.statusId > 1) {
                    return false;
                }
                return true;
            }

            if (!order?.statusHistory) {
                return null;
            }

            if (statusId === 1) return order.statusHistory[0];

            const lastHistory = order.statusHistory[order.statusHistory.length - 1];
            if (lastHistory?.statusId < statusId) {
                return null;
            }

            const history = order?.statusHistory?.findLast((status) => statusId === status?.statusId);
            if (!history) {
                const nextHistory = order.statusHistory.reduce((last, item) => {
                    if (!last && item?.statusId >= statusId) {
                        last = item;
                    }

                    return last;
                }, null);

                return nextHistory;
            }
            return history;
        }

        function previousPage() {
            if (this.state.customerOrders.pagination.current - 1 <= 0) {
                return;
            } else {
                const previousPage = this.state.customerOrders.pagination.current - 1;
                window.location.href = '/pedidos/' + previousPage;
            }
        }

        function nextPage() {
            if ((this.state.customerOrders.pagination.pages - this.state.customerOrders.pagination.current) <= 0) {
                return;
            } else {
                const nextPage = this.state.customerOrders.pagination.current + 1;
                window.location.href = '/pedidos/' + nextPage;
            }
        }

        function formatDate(createdAt) {
            return StoreSDK.utils.toDateLocale(createdAt);
        }

        function formatTotal(total) {
            return StoreSDK.utils.toCurrency(total);
        }
        serialize = function(obj, prefix) {
            var str = [],
                p;
            for (p in obj) {
                if (obj.hasOwnProperty(p)) {
                    var k = prefix ? prefix + "[" + p + "]" : p,
                        v = obj[p];
                    str.push((v !== null && typeof v === "object") ?
                        serialize(v, k) :
                        encodeURIComponent(k) + "=" + encodeURIComponent(v));
                }
            }
            return str.join("&");
        }
        function checkWarranty(order) {
            let listProducts = '';
            order.products.forEach((option) => {
                const sku = option.sku ? `  - Referência: ${option.sku}\n` : '';
                listProducts += `${sku}  - Produto Id: ${option.productId}\n  - Nome: ${option.title}\n  - Preço: ${StoreSDK.utils.toCurrency(option.price)}\n  - Quantidade: ${option.quantity}\n\n`
            });
            const message = {
                message: `Pedido: ${order.id}\n\nRelato da Solicitação: \n\nProdutos: \n${listProducts}\n`,
                subject: `Solicitar garantia pedido ${order.id}`,
            }
            window.location.href = `/pagina/fale-conosco?${serialize(message)}`;
        }

        function cancelOrder(orderId) {
            let orderCancelData = [];
            if (this.state?.customerOrders?.result?.length > 0) {
                orderCancelData = this.state.customerOrders.result.find((order) => ((Number(order.id) === Number(orderId)) && (order?.cancellationRequest?.length > 0)));
            }
            if (orderCancelData) {
                openSideNavOverlay('.sidenav-order', false, {isViewCart: false});
                window.dispatchEvent(
                    new CustomEvent("cancel-order", {
                        detail: {
                            orderId: orderId,
                            cancellationWasRequested: true,
                            cancellationRequest: orderCancelData.cancellationRequest,
                            customerName: this.state.customer?.name || 0,
                        }
                    })
                )
            } else {
                openSideNavOverlay('.sidenav-order', false, {isViewCart: false});
                window.dispatchEvent(
                    new CustomEvent("cancel-order", {
                        detail: {
                            orderId: orderId,
                            cancellationWasRequested: false,
                            customerName: this.state.customer?.name || 0,
                        }
                    })
                )
            }
        }

        function handleOrderSelected(orderOption) {
            this.state.paymentSelected = paymentOption;
            this.state.order.showAll = orderOption;
        }

        function renderOrder(order) {
            StoreSDK.request.get(`/checkout/order/view/${order.hash}`)
                .then(response => {
                    window.location.href = response.url;
                });
        }

        return {
            state,
            init,
            formatDate,
            formatTotal,
            nextPage,
            previousPage,
            renderOrder,
            checkWarranty,
            cancelOrder,
            getPaymentStatusName,
            getStatus,
        }
    }
</script>
<style>
    tr {
        cursor: pointer;
    }
</style>
{% render 'sections/sidenav-order', customer: customer, customerOrders: customerOrders, themeConfig: themeConfig %}
{% render 'sections/footer', store: store, customer: customer, cart: cart, pages: pages, payments: payments, stamps: stamps, social: social, themeConfig: themeConfig, theme: theme %}
{% endblock %}
