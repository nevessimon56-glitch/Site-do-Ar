{% comment %} VERSAO: 2026-07-27-pedidos-cancelamento-drawer-v8 {% endcomment %}
{% layout 'layout/theme' %}
{% block content %}
{% render 'sections/header', store: store, pages: pages, menu: menu, theme: theme, cart: cart, seo: seo, themeConfig: themeConfig %}
<main class="orders-main" x-data="setupOrders()">
    <div class="orders-content content">
        <div class="orders-container container">
            <div class="columns">
                <div class="column col-3 col-xxl-4 hide-lg col-custom1">
                    <div class="card card-pages-nav">
                        <div class="card-header">
                            Painel do cliente
                        </div>
                        <div class="card-body">
                            {%- render 'sections/customer-account-menu', themeConfig: themeConfig -%}
                        </div>
                    </div>
                </div>
                <div class="column col-9 col-xxl-8 col-lg-12 hide-lg col-custom2">
                    <div class="card card-page card-page-table card-page-table_orders">
                        <div class="card-header">
                            <div class="card-title">
                                <span>Meus Pedidos</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="page-table">
                                <div class="page-thead">
                                    <div class="page-table-list">
                                        <div class="page-table-item">
                                            <span class="label">Código</span>
                                        </div>
                                        <div class="page-table-item">
                                            <span class="label">Data</span>
                                        </div>
                                        <div class="page-table-item">
                                            <span class="label">Valor Total</span>
                                        </div>
                                        <div class="page-table-item">
                                            <span class="label">Forma de pagamento</span>
                                        </div>
                                        <div class="page-table-item">
                                            <span class="label">Situação</span>
                                        </div>
                                        <div class="page-table-item">
                                            <span class="label">Ação</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="page-tbody">
                                    <template x-for="(order, index) in state.customerOrders.result" :key="index">
                                        <div class="page-table-content">
                                            <div class="page-table-box page-table-box_main">
                                                <div class="page-table-list">
                                                    <div class="page-table-item">
                                                        <div x-text="order.id"></div>
                                                    </div>
                                                    <div class="page-table-item">
                                                        <div x-text="formatDate(order.createdAt)"></div>
                                                    </div>
                                                    <div class="page-table-item">
                                                        <div x-text="formatTotal(order.total)"></div>
                                                    </div>
                                                    <div class="page-table-item">
                                                        <div x-text="order.payments[0].paymentName"></div>
                                                    </div>
                                                    <div class="page-table-item">
                                                        <div x-text="order.status.name"></div>
                                                    </div>
                                                    <div class="page-table-item">
                                                        <div class="dropdown">
                                                            <a href="javascript:void(0)" class="btn dropdown-toggle">
                                                                Selecione ação
                                                            </a>
                                                            <ul class="menu">
                                                                <li x-show="order.payments[0].paymentLink" class="menu-item">
                                                                    <a :href="order.payments[0].paymentLink"
                                                                       target="_blank" title="Pagamento">
                                                                        Pagamento
                                                                    </a>
                                                                </li>
                                                                <li class="menu-item">
                                                                    <a x-bind:href="`checkout/order/view/${order.hash}`" title="Visualizar Detalhes do Pedido">
                                                                        Visualizar Pedido
                                                                    </a>
                                                                </li>
                                                                <li class="menu-item" x-show="order.status.name !== 'Cancelado'">
                                                                    <a href="javascript:void(0)"
                                                                       class="menu-item_link"
                                                                       :class="{ 'menu-item-link_disabled': !canCancelOrder(order) }"
                                                                       :aria-disabled="!canCancelOrder(order) ? 'true' : 'false'"
                                                                       @click.prevent="canCancelOrder(order) && checkCancel(order)"
                                                                       title="Solicitar Cancelamento">
                                                                        <span class="menu-item-link_text">Cancelar Pedido</span>
                                                                        <div class="menu-item-disabled_icon" x-show="!canCancelOrder(order)">{{ themeConfig.icons.close }}</div>
                                                                    </a>
                                                                </li>
                                                                <li class="menu-item" x-show="(order.status.name !== 'Pendente') && (order.status.name !== 'Cancelado')">
                                                                    <a href="javascript:void(0)"
                                                                       @click="checkWarranty(order)" title="Solicitar Garantia">
                                                                        Solicitar Garantia
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                        <a class="btn-page-open" @click="order.isOpen = !order.isOpen"
                                                           href="javascript:void(0)" title="Visualizar pedido">
                                                            {{ themeConfig.icons.arrow.down }}
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-main-order">
                                                <div class="page-table-box page-table-box_second" x-show="order.isOpen">
                                                    <div class="table-products">
                                                        <div class="table-products-title">
                                                            Produto(s)
                                                        </div>
                                                        <template x-for="product in order.products">
                                                            <div class="table-product">
                                                                <div class="table-product-image">
                                                                    <template x-if="product.image">
                                                                        <picture>
                                                                            <img class="lazy" x-bind:data-src="product.image" :alt="product.title">
                                                                        </picture>
                                                                    </template>
                                                                    <template x-if="!product.image">
                                                                        {{ themeConfig.icons.image }}
                                                                    </template>
                                                                </div>
                                                                <div class="table-product-info">
                                                                    <div class="table-product-title"
                                                                         x-text="product.title"></div>
                                                                    <div class="table-product-text"
                                                                         x-show="product.sku != null">
                                                                        <span x-text="`#${product.sku}`"></span>
                                                                    </div>
                                                                    <template x-if="product.products">
                                                                        <div class="table-product-text">
                                                                            <template x-for="(productKit, index, collection) in product.products" :key="index">
                                                                                <span x-text="`${[productKit.quantity + 'x '+productKit.title]}${(product.products.length !== index+1) ? ' / ' : ''}`"></span>
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                </div>
                                                                <div class="table-product-qnt">
                                                                    <div x-text="`${product.quantity} un`"></div>
                                                                </div>
                                                                <div class="table-product-price">
                                                                    <div x-text="Intl.NumberFormat('pt-BR', { style: 'currency',currency: 'BRL', }).format( product.price * product.quantity)"></div>
                                                                </div>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </div>
                                                <div class="page-table-box page-table-box_second">
                                                    <div class="table-products">
                                                        <div class="table-products-title">
                                                            Dados de entrega
                                                        </div>
                                                        <template x-if="order && order.shippings">
                                                            <template x-for="orderShipping in order.shippings">
                                                                <div class="table-product table-product_custom">

                                                                    <div class="col-12">
                                                                        <div class="columns">
                                                                            <div class="column col-3">
                                                                                <p x-text="orderShipping.shippingName"></p>
                                                                                <p x-text="Intl.NumberFormat('pt-BR', { style: 'currency',currency: 'BRL', }).format(orderShipping.value)"></p>
                                                                            </div>
                                                                            <div class="column col-5">
                                                                                <template x-if="orderShipping.invoiceUrl || orderShipping.invoiceDanfeUrl">
                                                                                    <p>
                                                                                        Nota fiscal
                                                                                    </p>
                                                                                    <template x-if="orderShipping.invoiceUrl">
                                                                                        <p>
                                                                                            <a :href="orderShipping.invoiceUrl" target="_blank">
                                                                                                <span title="Nota fiscal">Abrir o <strong>XML</strong> da nota fiscal</span>
                                                                                            </a>
                                                                                        </p>
                                                                                    </template>
                                                                                    <template x-if="orderShipping.invoiceDanfeUrl">
                                                                                        <p>
                                                                                            <a :href="orderShipping.invoiceDanfeUrl" target="_blank">
                                                                                                <span title="Nota fiscal">Abrir o <strong>DANFE</strong> da nota fiscal</span>
                                                                                            </a>
                                                                                        </p>
                                                                                    </template>
                                                                                </template>
                                                                                <template x-if="!orderShipping.invoiceUrl && !orderShipping.invoiceDanfeUrl">
                                                                                    <p>
                                                                                        Nota fiscal
                                                                                    </p>
                                                                                    <p>
                                                                                        <span title="Nota fiscal">Não disponível</span>
                                                                                    </p>
                                                                                </template>
                                                                            </div>
                                                                            <div class="column col-4">
                                                                                <template x-if="orderShipping?.trackingCode && orderShipping?.trackingUrl">
                                                                                    <p>
                                                                                        Código de rastreamento
                                                                                    </p>
                                                                                    <p>
                                                                                        <a :href="orderShipping.trackingUrl" target="_blank">
                                                                                            <span title="Código de rastreio" x-text="orderShipping?.trackingCode"></span>
                                                                                        </a>
                                                                                    </p>
                                                                                </template>
                                                                                <template x-if="!orderShipping?.trackingCode && orderShipping?.trackingUrl">
                                                                                    <p>
                                                                                        Código de rastreamento
                                                                                    </p>
                                                                                    <p>
                                                                                        <a title="Clique aqui para abrir o url de rastreio" :href="orderShipping.trackingUrl" target="_blank">
                                                                                            Clique aqui para abrir o url de rastreio
                                                                                        </a>
                                                                                    </p>
                                                                                </template>
                                                                                <template x-if="orderShipping?.trackingCode && !orderShipping?.trackingUrl">
                                                                                    <p>
                                                                                        Código de rastreamento
                                                                                    </p>
                                                                                    <p>
                                                                                        <span title="Código de rastreio" x-text="orderShipping?.trackingCode"></span>
                                                                                    </p>
                                                                                </template>
                                                                                <template x-if="!orderShipping?.trackingCode && !orderShipping?.trackingUrl">
                                                                                    <p>Código de rastreamento</p>
                                                                                    <p>Não disponível</p>
                                                                                </template>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </template>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                    <template x-if="state.customerOrders.result.length < 0">
                                        <div class="page-table-content">
                                            <div class="page-table-box page-table-box_main">
                                                <p>Nenhum pedido cadastrado</p>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="column col-12 hide-xxl show-lg">
                    <details class="page-accordion page-accordion_top accordion">
                        <summary class="accordion-header">
                            <div class="accordion-title">
                                <span>
                                    Painel do cliente
                                </span>
                            </div>
                            {{ themeConfig.icons.arrow.down }}
                        </summary>
                        <div class="accordion-body">
                            {%- render 'sections/customer-account-menu', themeConfig: themeConfig -%}
                        </div>
                    </details>
                    <div class="page-title">Meus Pedidos</div>
                    <template x-for="(order, index) in state.customerOrders.result" :key="index">
                        <details class="page-accordion-info page-accordion_orders accordion">
                            <summary class="accordion-header">
                                <ul class="accordion-list accordion-header-list">
                                    <li class="accordion-item accordion-header-item">
                                        <p class="accordion-title">Código</p>
                                        <p class="accordion-text" x-text="order.id"></p>
                                    </li>
                                    <li class="accordion-item accordion-header-item">
                                        <p class="accordion-title">Data</p>
                                        <p class="accordion-text" x-text="formatDate(order.createdAt)"></p>
                                    </li>
                                    <li class="accordion-item accordion-header-item">
                                        <p class="accordion-title">Valor Total</p>
                                        <p class="accordion-text" x-text="formatTotal(order.total)"></p>
                                    </li>
                                </ul>
                                {{ themeConfig.icons.arrow.down }}
                            </summary>
                            <div class="accordion-body">
                                <ul class="accordion-list accordion-body-list">
                                    <li class="accordion-item accordion-body-item">
                                        <div class="accordion-item-box">
                                            <p class="accordion-title">Pagamento</p>
                                            <p class="accordion-text" x-text="order.payments[0].paymentName"></p>
                                        </div>
                                    </li>
                                    <li class="accordion-item accordion-body-item">
                                        <div class="accordion-item-box">
                                            <p class="accordion-title">Situação</p>
                                            <p class="accordion-text" x-text="order.status.name"></p>
                                        </div>
                                    </li>
                                    <li class="accordion-item accordion-body-item">
                                        <div class="dropdown">
                                            <a href="javascript:void(0)" class="btn dropdown-toggle">
                                                Selecione ação
                                            </a>
                                            <ul class="menu">
                                                <li x-show="order.payments[0].paymentLink" class="menu-item">
                                                    <a :href="order.payments[0].paymentLink" target="_blank" title="Pagamento">
                                                        Pagamento
                                                    </a>
                                                </li>
                                                <li class="menu-item">
                                                    <a x-bind:href="`checkout/order/view/${order.hash}`" title="Visualizar Detalhes do Pedido">
                                                        Visualizar Pedido
                                                    </a>
                                                </li>
                                                <li class="menu-item" x-show="order.status.name !== 'Cancelado'">
                                                    <a href="javascript:void(0)"
                                                       class="menu-item_link"
                                                       :class="{ 'menu-item-link_disabled': !canCancelOrder(order) }"
                                                       :aria-disabled="!canCancelOrder(order) ? 'true' : 'false'"
                                                       @click.prevent="canCancelOrder(order) && checkCancel(order)"
                                                       title="Solicitar Cancelamento">
                                                        <span class="menu-item-link_text">Cancelar Pedido</span>
                                                        <div class="menu-item-disabled_icon" x-show="!canCancelOrder(order)">{{ themeConfig.icons.close }}</div>
                                                    </a>
                                                </li>
                                                <li class="menu-item" x-show="(order.status.name !== 'Pendente') && (order.status.name !== 'Cancelado')">
                                                    <a href="javascript:void(0)"
                                                       @click="checkWarranty(order)" title="Solicitar Garantia">
                                                        Solicitar Garantia
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </li>
                                </ul>
                                <div class="table-products">
                                    <div class="table-products-title">
                                        Dados de entrega
                                    </div>
                                    <template x-if="order && order.shippings">
                                        <template x-for="orderShipping in order.shippings">
                                            <div class="table-product table-product_custom">
                                                <div class="col-12">
                                                    <div class="columns">
                                                        <div class="column col-4 col-md-6 col-sm-12">
                                                            <p class="accordion-title">
                                                                Frete
                                                            </p>
                                                            <p class="accordion-text" x-text="orderShipping.shippingName"></p>
                                                        </div>
                                                        <div class="column col-4 col-md-6 col-sm-12">
                                                            <p class="accordion-title">
                                                                Custo do frete
                                                            </p>
                                                            <p class="accordion-text" x-text="Intl.NumberFormat('pt-BR', { style: 'currency',currency: 'BRL', }).format(orderShipping.value)"></p>
                                                        </div>
                                                        <div class="column col-4 col-md-6 col-sm-12">
                                                            <template x-if="orderShipping?.trackingCode && orderShipping?.trackingUrl">
                                                                <p class="accordion-title">
                                                                    Código de rastreamento
                                                                </p>
                                                                <p class="accordion-text">
                                                                    <a :href="orderShipping.trackingUrl" target="_blank">
                                                                        <span title="Código de rastreio" x-text="orderShipping?.trackingCode"></span>
                                                                    </a>
                                                                </p>
                                                            </template>
                                                            <template x-if="!orderShipping?.trackingCode && orderShipping?.trackingUrl">
                                                                <p class="accordion-title">
                                                                    Código de rastreamento
                                                                </p>
                                                                <p class="accordion-text">
                                                                    <a title="Clique aqui para abrir o url de rastreio" :href="orderShipping.trackingUrl" target="_blank">
                                                                        Clique aqui para abrir o url de rastreio
                                                                    </a>
                                                                </p>
                                                            </template>
                                                            <template x-if="orderShipping?.trackingCode && !orderShipping?.trackingUrl">
                                                                <p class="accordion-title">
                                                                    Código de rastreamento
                                                                </p>
                                                                <p class="accordion-text">
                                                                    <span title="Código de rastreio" x-text="orderShipping?.trackingCode"></span>
                                                                </p>
                                                            </template>
                                                            <template x-if="!orderShipping?.trackingCode && !orderShipping?.trackingUrl">
                                                                <p class="accordion-title">
                                                                    Código de rastreamento
                                                                </p>
                                                                <p class="accordion-text">
                                                                    Não disponível
                                                                </p>
                                                            </template>
                                                        </div>
                                                        <div class="column col-12 col-md-6 col-sm-12">
                                                            <template x-if="orderShipping.invoiceUrl || orderShipping.invoiceDanfeUrl">
                                                                <p class="accordion-title">
                                                                    Nota fiscal
                                                                </p>
                                                                <template x-if="orderShipping.invoiceUrl">
                                                                    <p class="accordion-text">
                                                                        <a :href="orderShipping.invoiceUrl" target="_blank">
                                                                            <span title="Nota fiscal">Abrir o <strong>XML</strong> da nota fiscal</span>
                                                                        </a>
                                                                    </p>
                                                                    </template>
                                                                <template x-if="orderShipping.invoiceDanfeUrl">
                                                                    <p class="accordion-text">
                                                                        <a :href="orderShipping.invoiceDanfeUrl" target="_blank">
                                                                            <span title="Nota fiscal">Abrir o <strong>DANFE</strong> da nota fiscal</span>
                                                                        </a>
                                                                    </p>
                                                                </template>
                                                            </template>
                                                            <template x-if="!orderShipping.invoiceUrl && !orderShipping.invoiceDanfeUrl">
                                                                <p class="accordion-title">
                                                                    Nota fiscal
                                                                </p>
                                                                <p class="accordion-text">
                                                                    <span title="Nota fiscal">Não disponível</span>
                                                                </p>
                                                            </template>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>
                                    </template>
                                </div>
                                <div class="table-products">
                                    <div class="table-products-title">
                                        Produto(s)
                                    </div>
                                    <template x-for="product in order.products">
                                        <div class="table-product">
                                            <div class="table-product-image">
                                                <template x-if="product.image">
                                                    <picture>
                                                        <img class="lazy" x-bind:data-src="product.image" :alt="product.title">
                                                    </picture>
                                                </template>
                                                <template x-if="!product.image">
                                                    {{ themeConfig.icons.image }}
                                                </template>
                                            </div>
                                            <div class="table-product-info">
                                                <div class="table-product-title" x-text="`${product.title}`"></div>
                                                <div class="table-product-text" x-text="`${product.quantity} un`"></div>
                                            </div>
                                            <div class="table-product-price">
                                                <div x-text="Intl.NumberFormat('pt-BR', { style: 'currency',currency: 'BRL', }).format( product.price * product.quantity)"></div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </details>
                    </template>
                    <template x-if="state.customerOrders.result.length < 0">
                        <div class="page-table-box page-table-box_main">
                            <p>Nenhum pedido cadastrado</p>
                        </div>
                    </template>
                </div>
                <div class="column col-12">
                    <div class="page-pagination">
                        <ul class="pagination_list">
                            <li class="pagination_item">
                                <a class="pagination_link__arrow" @click.debounce.500="previousPage()"
                                   title="Anterior"
                                   :class="[(state.customerOrders.pagination.current - 1 <= 0 ) ? 'disable' : '']">
                                    {{ themeConfig.icons.arrow.prev }}
                                </a>
                            </li>
                            <li class="pagination_item">
                                <a class="pagination_link__arrow" @click.debounce.500="nextPage()"
                                   title="Seguinte"
                                   :class="[(state.customerOrders.pagination.pages - state.customerOrders.pagination.current <= 0 ) ? 'disable' : '']">
                                    {{ themeConfig.icons.arrow.next }}
                                </a>
                            </li>
                        </ul>
                        <div class="pagination_info">
                            <div x-text="`Visualizando ${state.customerOrders.pagination.current} / ${state.customerOrders.pagination.pages} de ${state.customerOrders.pagination.total} registros encontrados`"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sidenav-overlay sidenav-order">
        <div class="sidenav-container">
            <div class="sidenav-header">
                <a class="btn-sidenav-close float-right" href="javascript:void(0)" aria-label="Fechar" onclick="closeSideNavOverlay()">
                    <svg class="icon_close" x="0px" y="0px" viewBox="0 0 512.001 512.001">
                        <path d="M284.286,256.002L506.143,34.144c7.811-7.811,7.811-20.475,0-28.285c-7.811-7.81-20.475-7.811-28.285,0L256,227.717L34.143,5.859c-7.811-7.811-20.475-7.811-28.285,0c-7.81,7.811-7.811,20.475,0,28.285l221.857,221.857L5.858,477.859c-7.811,7.811-7.811,20.475,0,28.285c3.905,3.905,9.024,5.857,14.143,5.857c5.119,0,10.237-1.952,14.143-5.857L256,284.287l221.857,221.857c3.905,3.905,9.024,5.857,14.143,5.857s10.237-1.952,14.143-5.857c7.811-7.811,7.811-20.475,0-28.285L284.286,256.002z"></path>
                    </svg>
                </a>
                <div class="sidenav-title"
                     x-text="state.cancelOrder.messages.length ? 'Acompanhar pedido' : 'Solicitar Cancelamento do Pedido'"></div>
            </div>
            <div class="sidenav-body">
                <p class="s-subtitle" x-show="!state.cancelOrder.messages.length">Informe o motivo do cancelamento</p>
                <p class="order-cancel-id" x-show="state.cancelOrder.order">
                    Pedido ID: <strong x-text="state.cancelOrder.order.id"></strong>
                </p>
                <div class="panel" x-show="state.cancelOrder.messages.length">
                    <template x-for="(message, messageIndex) in state.cancelOrder.messages" :key="messageIndex">
                        <div class="tile">
                            <div class="tile-content">
                                <div class="avatar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                        <path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                                    </svg>
                                </div>
                                <div class="tile-body">
                                    <div class="tile-title">
                                        Respondido por:
                                        <span x-text="message.respondedBy || message.userName || message.name || 'Você'"></span>
                                    </div>
                                    <div class="tile-subtitle">
                                        Data da mensagem:
                                        <span x-text="formatDateTime(message.createdAt || message.date)"></span>
                                    </div>
                                    <div class="tile-text" x-text="message.message || message.text || message.reason"></div>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
                <div class="form-group" :class="{ 'has-error': !!state.cancelOrder.errors.message }">
                    <label class="form-label" for="order-cancel-reason">Digite o motivo *</label>
                    <textarea id="order-cancel-reason"
                              class="form-input"
                              rows="5"
                              x-model="state.cancelOrder.message"
                              @keydown.enter.prevent="sendCancellation()"></textarea>
                    <p class="form-input-hint" x-text="state.cancelOrder.errors.message"></p>
                </div>
            </div>
            <div class="sidenav-footer">
                <p class="order-cancel-status" x-show="state.cancelOrder.statusMessage" x-text="state.cancelOrder.statusMessage"></p>
                <div class="form-group">
                    <button id="order-cancel-send-btn"
                            class="btn btn-login btn-block btn-order-cancel-send"
                            type="button"
                            @click.prevent="sendCancellation()"
                            onclick="return window.sendOrderCancellation(event)"
                            :disabled="state.cancelOrder.sending"
                            x-text="state.cancelOrder.sending ? 'ENVIANDO...' : 'ENVIAR'"
                            aria-label="Enviar">ENVIAR</button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    function setupOrders() {
        const state = {
            customer: {{ customer | json }} || {},
            customerOrders: {{ customerOrders | json }} || {},
            cancelOrder: {
                order: null,
                message: '',
                messages: [],
                errors: {},
                sending: false,
                statusMessage: ''
            }
        };

        function previousPage() {
            if (this.state.customerOrders.pagination.current - 1 <= 0) {
                return;
            } else {
                const previousPage = this.state.customerOrders.pagination.current - 1;
                window.location.href = '/pedidos/' + previousPage;
            }
        }

        function nextPage() {
            if ((this.state.customerOrders.pagination.pages - this.state.customerOrders.pagination.current) <= 0) {
                return;
            } else {
                const nextPage = this.state.customerOrders.pagination.current + 1;
                window.location.href = '/pedidos/' + nextPage;
            }
        }

        function formatDate(createdAt) {
            return StoreSDK.utils.toDateLocale(createdAt);
        }

        function formatTotal(total) {
            return StoreSDK.utils.toCurrency(total);
        }
        serialize = function(obj, prefix) {
            var str = [],
                p;
            for (p in obj) {
                if (obj.hasOwnProperty(p)) {
                    var k = prefix ? prefix + "[" + p + "]" : p,
                        v = obj[p];
                    str.push((v !== null && typeof v === "object") ?
                        serialize(v, k) :
                        encodeURIComponent(k) + "=" + encodeURIComponent(v));
                }
            }
            return str.join("&");
        }
        function formatDateTime(dateValue) {
            if (!dateValue) {
                return '';
            }

            const date = new Date(dateValue);
            if (Number.isNaN(date.getTime())) {
                return dateValue;
            }

            return date.toLocaleString('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            }).replace(',', ' -');
        }

        const cancelBlockedStatuses = [
            'em transporte',
            'em transito',
            'em trânsito',
            'enviado',
            'despachado',
            'expedido',
            'em expedição',
            'em expedicao',
            'saiu para entrega',
            'entregue',
            'finalizado',
            'concluído',
            'concluido'
        ];

        function normalizeStatusName(statusName) {
            return (statusName || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function isOrderInTransit(order) {
            const statusName = normalizeStatusName(order?.status?.name);

            if (cancelBlockedStatuses.some((blockedStatus) => statusName.includes(blockedStatus))) {
                return true;
            }

            if (order?.shippings?.some((shipping) => !!shipping?.trackingCode)) {
                return true;
            }

            return false;
        }

        function canCancelOrder(order) {
            if (!order) {
                return false;
            }

            if (order.canCancel === false) {
                return false;
            }

            if (normalizeStatusName(order?.status?.name) === 'cancelado') {
                return false;
            }

            return !isOrderInTransit(order);
        }

        function setCancellationMessages(messages) {
            state.cancelOrder.messages = Array.isArray(messages) ? messages : [];
        }

        function loadCancellationMessages(order) {
            if (order.cancellationRequest && order.cancellationRequest.length) {
                setCancellationMessages(order.cancellationRequest);
            }

            StoreSDK.request.get(`/ajax/customer/order/cancellation/${order.id}`)
                .then((response) => {
                    const messages = response?.result || response?.messages || response?.cancellationRequest || response;
                    if (Array.isArray(messages)) {
                        setCancellationMessages(messages);
                    }
                })
                .catch(() => {});
        }

        function checkCancel(order) {
            if (!canCancelOrder(order)) {
                return;
            }

            state.cancelOrder.order = order;
            state.cancelOrder.message = '';
            state.cancelOrder.errors = {};
            setCancellationMessages(order.cancellationRequest || []);
            loadCancellationMessages(order);
            openSideNavOverlay('.sidenav-order', false);
        }

        function validateCancellation() {
            const errors = {};

            if (!state.cancelOrder.message || !state.cancelOrder.message.trim()) {
                errors.message = 'Por favor, informe o motivo do cancelamento';
            }

            state.cancelOrder.errors = errors;
            return Object.keys(errors).length === 0;
        }

        function showCancellationError(message) {
            state.cancelOrder.statusMessage = message;
            state.cancelOrder.errors = { message: message };
            if (typeof notyf !== 'undefined') {
                notyf.open({
                    type: 'warning',
                    message: message
                });
            }
        }

        function setCancellationLoading(loading) {
            if (typeof openLoadingSideOverlay === 'function' && typeof closeLoadingSideOverlay === 'function') {
                if (loading) {
                    openLoadingSideOverlay('.sidenav-order');
                } else {
                    closeLoadingSideOverlay('.sidenav-order');
                }
            }
        }

        function finishCancellationRequest() {
            state.cancelOrder.sending = false;
            setCancellationLoading(false);
        }

        function postCancellation(order, message) {
            const payload = {
                orderId: order.id,
                id: order.id,
                message: message,
                reason: message,
                hash: order.hash
            };

            if (typeof StoreSDK === 'undefined' || !StoreSDK.request || typeof StoreSDK.request.post !== 'function') {
                return Promise.reject(new Error('StoreSDK indisponível. Recarregue a página e tente novamente.'));
            }

            return StoreSDK.request.post('/ajax/customer/order/cancellation', payload);
        }

        function sendCancellation() {
            try {
                const order = state.cancelOrder.order;
                if (!order) {
                    showCancellationError('Pedido não encontrado. Feche e abra novamente.');
                    return false;
                }

                if (!validateCancellation()) {
                    return false;
                }

                if (state.cancelOrder.sending) {
                    return false;
                }

                const message = state.cancelOrder.message.trim();
                state.cancelOrder.errors = {};
                state.cancelOrder.statusMessage = '';
                state.cancelOrder.sending = true;
                setCancellationLoading(true);

                postCancellation(order, message).then(function (response) {
                    const messages = response && (response.result || response.messages || response.cancellationRequest);
                    if (Array.isArray(messages)) {
                        setCancellationMessages(messages);
                    } else {
                        state.cancelOrder.messages = state.cancelOrder.messages.concat([{
                            message: message,
                            createdAt: new Date().toISOString(),
                            respondedBy: (state.customer && state.customer.name) || 'Você'
                        }]);
                    }

                    order.cancellationRequest = state.cancelOrder.messages;
                    state.cancelOrder.message = '';
                    state.cancelOrder.errors = {};
                    state.cancelOrder.statusMessage = '';
                    finishCancellationRequest();

                    if (typeof notyf !== 'undefined') {
                        notyf.success('Solicitação enviada com sucesso. Agora é só acompanhar o pedido. O pedido será cancelado após a aprovação da loja.');
                    }
                }).catch(function (error) {
                    finishCancellationRequest();
                    const apiMessage = error && (
                        (error.data && (error.data.message || error.data.error)) ||
                        error.message
                    );
                    showCancellationError(apiMessage || 'Não foi possível enviar a solicitação de cancelamento.');
                });

                return true;
            } catch (error) {
                finishCancellationRequest();
                showCancellationError((error && error.message) || 'Erro inesperado ao enviar a solicitação.');
                return false;
            }
        }

        function checkWarranty(order) {
            let listProducts = '';
            order.products.forEach((option) => {
                const sku = option.sku ? `  - Referência: ${option.sku}\n` : '';
                listProducts += `${sku}  - Produto Id: ${option.productId}\n  - Nome: ${option.title}\n  - Preço: ${StoreSDK.utils.toCurrency(option.price)}\n  - Quantidade: ${option.quantity}\n\n`
            });
            const message = {
                message: `Pedido: ${order.id}\n\nRelato da Solicitação: \n\nProdutos: \n${listProducts}\n`,
                subject: `Solicitar garantia pedido ${order.id}`,
            }
            window.location.href = `/pagina/fale-conosco?${serialize(message)}`;
        }

        function handleOrderSelected(orderOption) {
            this.state.paymentSelected = paymentOption;
            this.state.order.showAll = orderOption;
        }

        function renderOrder(order) {
            StoreSDK.request.get(`/checkout/order/view/${order.hash}`)
                .then(response => {
                    window.location.href = response.url;
                });
        }

        return {
            state,
            formatDate,
            formatDateTime,
            formatTotal,
            nextPage,
            previousPage,
            renderOrder,
            checkWarranty,
            checkCancel,
            canCancelOrder,
            sendCancellation,
            validateCancellation,
        };
    }

    window.sendOrderCancellation = function sendOrderCancellationFromWindow(event) {
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }

        const main = document.querySelector('.orders-main');
        if (!main || typeof main._x_dataStack === 'undefined' || !main._x_dataStack.length) {
            return false;
        }

        const component = main._x_dataStack[0];
        if (component && typeof component.sendCancellation === 'function') {
            return component.sendCancellation();
        }

        return false;
    };
</script>
