<header class="header">
    <div class="container">
        <div class="navbar">
            <div class="navbar-section">
                <a class="logo" href="/" title="{{ store.name }}">
                    <h1>{{ store.name }}</h1>
                    {% if  theme.logo.path %}
                        <picture>
                            <img class="lazy" data-src="{{ theme.logo.path | imgUrl: 192 }}" alt="{% if theme.logo.title and theme.logo.title != '' %}{{ theme.logo.title }}{% else %}{{ store.name }}{% endif %}">
                        </picture>
                    {% else %}
                        {{ themeConfig.icons.image }}
                    {% endif %}
                </a>
            </div>
            <div class="navbar-center">
                {% assign styleNavMain = 'center' %}
                {% if menu.items.size >  4 %}
                    {% assign styleNavMain = 'space-between' %}
                {% endif %}
                <nav class="nav-main" style="justify-content: {{ styleNavMain }}">
                    {% for menuItem in menu.items limit: 6 %}
                        <div class="nav-main_item dropdown">
                            <a href="{{ menuItem.link }}" class="nav-main_link dropdown-toggle" tabindex="0" title="{{ menuItem.name }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                                <div class="nav-main-box_link">
                                    {% if menuItem.iconSvg %}
                                        <div class="nav-main_icon nav-main-icon_svg">
                                            {{ menuItem.iconSvg }}
                                        </div>
                                    {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                        <div class="nav-main_icon nav-main-icon_img">
                                            <picture>
                                                <img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuItem.name }}">
                                            </picture>
                                        </div>
                                    {% endif %}
                                    <div class="nav-main_text">
                                        <span>{{ menuItem.name }}</span>
                                        {% if menuItem.items.size > 0 %}
                                            {{ themeConfig.icons.arrow.down }}
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                            {% if menuItem.items.size > 0 %}
                                <div class="nav-main_content dropdown-content">
                                    {% assign limitMenuChildren = 6 %}
                                    {% assign limitMenuAll = 6 | times: 5 %}
                                    {% assign startMenuChildren = 1 %}
                                    {% assign endMenuChildren = startMenuChildren | times: limitMenuChildren %}
                                    {% for menuChildrenItem1 in menuItem.items limit:limitMenuAll %}
                                        {% if forloop.index == startMenuChildren %}
                                            <ul>
                                        {% endif %}
                                        <li class="nav-children dropdown">
                                            {% if menuChildrenItem1.newTab == true %}
                                                <a class="nav-main_children" title="{{ menuChildrenItem1.name }}" href="{{ menuChildrenItem1.link }}" target="_blank">
                                                    {{ menuChildrenItem1.name }}
                                                </a>
                                            {% else %}
                                                <a class="nav-main_children" title="{{ menuChildrenItem1.name }}" href="{{ menuChildrenItem1.link }}">
                                                    {{ menuChildrenItem1.name }}
                                                </a>
                                            {% endif %}
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                <ul class="nav-main_content nav-main_content__children dropdown-content">
                                                    {% for menuChildrenItem2 in menuChildrenItem1.items %}
                                                        <li class="nav-children dropdown">
                                                            {% if menuChildrenItem2.newTab == true %}
                                                                <a class="nav-main_children" href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}" target="_blank">
                                                                    {{ menuChildrenItem2.name }}
                                                                </a>
                                                            {% else %}
                                                                <a class="nav-main_children" href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}">
                                                                    {{ menuChildrenItem2.name }}
                                                                </a>
                                                            {% endif %}
                                                            {% if menuChildrenItem2.items.size > 0 %}
                                                                <ul class="nav-main_content nav-main_content__children dropdown-content">
                                                                    {% for menuChildrenItem3 in menuChildrenItem2.items %}
                                                                        <li class="nav-children dropdown">
                                                                            {% if menuChildrenItem3.newTab == true %}
                                                                                <a class="nav-main_children" href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}" target="_blank">
                                                                                    {{ menuChildrenItem3.name }}
                                                                                </a>
                                                                            {% else %}
                                                                                <a class="nav-main_children" href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}">
                                                                                    {{ menuChildrenItem3.name }}
                                                                                </a>
                                                                            {% endif %}
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                        {% if forloop.index == endMenuChildren or forloop.last %}
                                            </ul>
                                            {% assign startMenuChildren = endMenuChildren | plus: 1 %}
                                            {% assign endMenuChildren = endMenuChildren | plus: limitMenuChildren %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        {% for i in (1..6) %}
                            <div class="nav-main_item dropdown">
                                <a href="javascript:void(0)" class="nav-main_link dropdown-toggle" tabindex="{{ i }}" title="Categoria">
                                    <span>Categoria {{ i }}</span>
                                    {{ themeConfig.icons.arrow.down }}
                                </a>
                                <ul class="nav-main_content dropdown-content">
                                    {% for x in (1..5) %}
                                        <li class="nav-children dropdown">
                                            <a class="nav-main_children" href="javascript:void(0)">
                                                <div class="nav-main-box_link">
                                                    <div class="nav-main_text">Categoria {{ i }}</div>
                                                    <div class="nav-main_arrow">
                                                        {{ themeConfig.icons.arrow.down }}
                                                    </div>
                                                </div>
                                            </a>
                                            <ul class="nav-main_content nav-main_content__children dropdown-content">
                                                {% for y in (1..5) %}
                                                    <li class="nav-children dropdown">
                                                        <a class="nav-main_children" href="javascript:void(0)">
                                                            Categoria {{ i }}.{{ x }}.{{ y }}
                                                        </a>
                                                        <ul class="nav-main_content nav-main_content__children dropdown-content">
                                                            {% for z in (1..5) %}
                                                                <li class="nav-children dropdown">
                                                                    <a class="nav-main_children" href="javascript:void(0)">
                                                                        Categoria {{ i }}.{{ x }}.{{ y }}.{{ z }}
                                                                    </a>
                                                                </li>
                                                            {% endfor %}
                                                        </ul>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </nav>
            </div>
            <div class="navbar-section">
                <a class="header-link header-link_search search_link" href="javascript:void(0)" title="Busca" onclick="openSearch()">
                    <div class="icon-search">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </div>
                </a>
                {% if themeConfig.account.type != 'disabled' %}
                    <a class="header-link header-link_account account_link hide-lg"
                       href="javascript:void(0)"
                       title="Acesse sua conta"
                       onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                        {{ themeConfig.icons.user }}
                    </a>
                {% endif %}
                {% if themeConfig.cart.type == 'default' %}
                    <a class="header-link header-link_cart cart_link" href="javascript:void(0)" title="Carrinho" {% if themeConfig.buyAction.type == "login" %}@click="openSideNavOverlayCartB2B()"{% else %}onclick="openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: true})"{% endif %}>
                        {{ themeConfig.icons.cart }}
                        {% assign cartQtd = 0 %}
                        {% if cart.quantity %}
                            {% assign cartQtd = cart.quantity %}
                        {% endif %}
                        <span class="cart_quantity" data-cart-quantity>{{ cartQtd }}</span>
                    </a>
                {% endif %}
                <a class="header-link header-link_menu__mobile menu-mobile_link" href="javascript:void(0)" title="Menu Mobile" onclick="openNavMobile()">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </a>
            </div>
        </div>
        <!-- Search -->
        <div class="search close">
            <form id="myForm" method="POST" action="">
                <div class="input-group">
                    <input type="search" id="term" class="form-input" placeholder="Buscar produtos">
                    <button class="btn" title="Enviar" onclick="alterForm()">
                        {{ themeConfig.icons.search }}
                    </button>
                </div>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            </form>
        </div>
    </div>
    <!-- Nav Mobile -->
    <nav class="sidebar-nav show-lg">
        {% if themeConfig.account.type != 'disabled' %}
            <div class="sidebar-nav-header">
                <div class="sidebar-nav-account">
                <span class="sidebar-nav-icon account_link">
                    {{ themeConfig.icons.user }}
                </span>
                    <template x-if="data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link sidebar-nav-link_user account_link" href="javascript:void(0)" x-bind:title="`${data.user ? data.user : 'visitante'}`"
                               x-text="`Olá ${data.user ? data.user : 'visitante'}`" onclick="openSideNavOverlay('.sidenav-overlay_account', true)"></a>
                            <a class="sidebar-nav-link sidebar-nav-link_logout" href="javascript:void(0)" title="Logout" @click="headerLogout()">Logout</a>
                        </div>
                    </template>
                    <template x-if="!data.isLogged">
                        <div class="sidebar-nav-text">
                            <a class="sidebar-nav-link account_link" href="javascript:void(0)" title="Login ou Cadastre-se" onclick="openSideNavOverlay('.sidenav-overlay_account', true)">
                                Login ou Cadastre-se
                            </a>
                        </div>
                    </template>
                </div>
            </div>
        {% endif %}
        <div class="sidebar-nav-content content">
            <div>
                <ul class="nav-mobile metismenu" id="nav-mobile">
                    {% for menuItem in menu.items %}
                        <li class="nav-mobile_item">
                            {% assign classArrowItem = '' %}
                            {% if menuItem.items.size > 0 %}
                                {% assign classArrowItem = ' has-arrow' %}
                            {% endif %}
                            <div class="nav-mobile_link{{ classArrowItem }}" aria-expanded="false">
                                <p>
                                    <a href="{{ menuItem.link }}" title="{{ menuItem.name }}"{% if menuItem.newTab == true %} target="_blank"{% endif %}>
                                        <div class="nav-mobile-box_link">
                                            {% if menuItem.iconSvg %}
                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                    {{ menuItem.iconSvg }}
                                                </div>
                                            {% elsif menuItem.icon and menuItem.icon.file and menuItem.icon.file.url %}
                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                    <picture>
                                                        <img class="lazy" data-src="{{ menuItem.icon.file.url }}" alt="{{ menuItem.name }}">
                                                    </picture>
                                                </div>
                                            {% endif %}
                                            <div class="nav-mobile_text">
                                                {{ menuItem.name }}
                                            </div>
                                        </div>
                                    </a>
                                </p>
                            </div>
                            {% if menuItem.items.size > 0 %}
                                <ul>
                                    {% for menuChildrenItem1 in menuItem.items %}
                                        <li>
                                            {% assign classArrowChildren1 = '' %}
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                {% assign classArrowChildren1 = ' has-arrow' %}
                                            {% endif %}
                                            <div class="nav-mobile_link{{ classArrowChildren1 }}" aria-expanded="false">
                                                <p>
                                                    <a href="{{ menuChildrenItem1.link }}" title="{{ menuChildrenItem1.name }}"{% if menuChildrenItem1.newTab == true %} target="_blank"{% endif %}>
                                                        <div class="nav-mobile-box_link">
                                                            {% if menuChildrenItem1.iconSvg %}
                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                    {{ menuChildrenItem1.iconSvg }}
                                                                </div>
                                                            {% elsif menuChildrenItem1.icon and menuChildrenItem1.icon.file and menuChildrenItem1.icon.file.url %}
                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                    <picture>
                                                                        <img class="lazy" data-src="{{ menuChildrenItem1.icon.file.url }}" alt="{{ menuChildrenItem1.name }}">
                                                                    </picture>
                                                                </div>
                                                            {% endif %}
                                                            <div class="nav-mobile_text">
                                                                {{ menuChildrenItem1.name }}
                                                            </div>
                                                        </div>
                                                    </a>
                                                </p>
                                            </div>
                                            {% if menuChildrenItem1.items.size > 0 %}
                                                <ul>
                                                    {% for menuChildrenItem2 in menuChildrenItem1.items %}
                                                        <li>
                                                            {% assign classArrowChildren2 = '' %}
                                                            {% if menuChildrenItem2.items.size > 0 %}
                                                                {% assign classArrowChildren2 = ' has-arrow' %}
                                                            {% endif %}
                                                            <div class="nav-mobile_link{{ classArrowChildren2 }}" aria-expanded="false">
                                                                <p>
                                                                    <a href="{{ menuChildrenItem2.link }}" title="{{ menuChildrenItem2.name }}"{% if menuChildrenItem2.newTab == true %} target="_blank" {% endif %}>
                                                                        <div class="nav-mobile-box_link">
                                                                            {% if menuChildrenItem2.isSvg %}
                                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                                    {{ menuChildrenItem2.iconSvg }}
                                                                                </div>
                                                                            {% elsif menuChildrenItem2.icon and menuChildrenItem2.icon.file and menuChildrenItem2.icon.file.url %}
                                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                                    <picture>
                                                                                        <img class="lazy" data-src="{{ menuChildrenItem2.icon.file.url }}" alt="{{ menuChildrenItem2.name }}">
                                                                                    </picture>
                                                                                </div>
                                                                            {% endif %}
                                                                            <div class="nav-mobile_text">
                                                                                {{ menuChildrenItem2.name }}
                                                                            </div>
                                                                        </div>
                                                                    </a>
                                                                </p>
                                                            </div>
                                                            {% if menuChildrenItem2.items.size > 0 %}
                                                                <ul>
                                                                    {% for menuChildrenItem3 in menuChildrenItem2.items %}
                                                                        <li>
                                                                            <div class="nav-mobile_link" aria-expanded="false">
                                                                                <p>
                                                                                    <a href="{{ menuChildrenItem3.link }}" title="{{ menuChildrenItem3.name }}"{% if menuChildrenItem3.newTab == true %} target="_blank"{% endif %}>
                                                                                        <div class="nav-mobile-box_link">
                                                                                            {% if menuChildrenItem3.isSvg %}
                                                                                                <div class="nav-mobile_icon nav-mobile-icon_svg">
                                                                                                    {{ menuChildrenItem3.iconSvg }}
                                                                                                </div>
                                                                                            {% elsif menuChildrenItem3.icon and menuChildrenItem3.icon.file and menuChildrenItem3.icon.file.url %}
                                                                                                <div class="nav-mobile_icon nav-mobile-icon_img">
                                                                                                    <picture>
                                                                                                        <img class="lazy" data-src="{{ menuChildrenItem3.icon.file.url }}" alt="{{ menuChildrenItem3.name }}">
                                                                                                    </picture>
                                                                                                </div>
                                                                                            {% endif %}
                                                                                            <div class="nav-mobile_text">
                                                                                                {{ menuChildrenItem3.name }}
                                                                                            </div>
                                                                                        </div>
                                                                                    </a>
                                                                                </p>
                                                                            </div>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </nav>
    <script>
        function alterForm() {
            var input = document.getElementById("term").value;
            if (input.length > 0) {
                document.getElementById("myForm").action = '/busca/' + encodeURI(input).replace(/\//g, '%2f');
            } else {
                document.getElementById("myForm").addEventListener('submit', function(e){
                    e.preventDefault();
                }, false);
                window.location.href = `${window.location.protocol}//${window.location.host}/busca/`;
            }
        }
    </script>
</header>
