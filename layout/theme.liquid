    display: none;
    position: fixed;
    z-index: 2147483647;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    box-sizing: border-box;
  }
  #diag360pop.show {
    display: block !important;
    animation: d360in 0.35s ease forwards;
  }
  @keyframes d360in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #d360close {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.08);
    color: #334155;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #d360close:hover, #d360close:focus { background: rgba(15, 23, 42, 0.14); color: #0f172a; }
  .d360title { font-size: 16px; font-weight: 800; line-height: 1.35; margin: 0 32px 6px 0; color: #4c1d95; }
  .d360text  { font-size: 13px; color: #64748b; line-height: 1.45; margin: 0 0 14px; }
  .d360cta {
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-height: 44px; padding: 12px 16px; border-radius: 12px; border: 0;
    background: linear-gradient(135deg, #6d28d9, #5b21b6);
    color: #fff !important; font-weight: 700; font-size: 14px;
    cursor: pointer; text-decoration: none !important;
    box-shadow: 0 6px 18px rgba(109, 40, 217, 0.35);
  }
  .d360cta:hover { opacity: 0.92; }
  .d360items, .d360badge, .d360skip { display: none !important; }
  @media (min-width: 768px) {
    #diag360pop {
      bottom: 24px;
      right: 24px;
      width: 300px;
      max-width: calc(100vw - 32px);
      padding: 18px 18px 16px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid #e9d5ff;
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
      color: #0f172a;
    }
  }
  @media (max-width: 767px) {
    #diag360pop {
      left: 12px;
      right: 12px;
      bottom: calc(72px + env(safe-area-inset-bottom, 0));
      max-height: 32vh;
      padding: 16px 16px 14px;
      border-radius: 16px 16px 12px 12px;
      background: #fff;
      border: 1px solid #e9d5ff;
      box-shadow: 0 -4px 24px rgba(15, 23, 42, 0.14);
    }
    body.sda-pdp-sticky-on #diag360pop { bottom: calc(132px + env(safe-area-inset-bottom, 0)); }
  }
</style>

<div id="diag360backdrop" aria-hidden="true"></div>
<div id="diag360pop" role="dialog" aria-labelledby="d360title" aria-modal="false">
  <button id="d360close" type="button" aria-label="Fechar">&#x2715;</button>
  <p class="d360title" id="d360title">Não sabe qual BTU escolher?</p>
  <p class="d360text">Descubra o modelo ideal para o seu ambiente.</p>
  <a class="d360cta" href="/pagina/diagnostico-360">Fazer diagnóstico</a>
</div>

<script>
(function(){
  try {
    var KEY = 'diag360_shown_session';
    function isDiagPage() {
      var p = (window.location.pathname || '').toLowerCase();
      return p.indexOf('diagnostico') !== -1 || p.indexOf('diag360') !== -1;
    }
    function isMobile() {
      return window.matchMedia('(max-width: 767px)').matches;
    }
    function jaViu() {
      try { return sessionStorage.getItem(KEY) === '1'; } catch(e) { return false; }
    }
    function marcarVisto() {
      try { sessionStorage.setItem(KEY, '1'); } catch(e) {}
    }
    if (jaViu() || isDiagPage()) return;
    var el = document.getElementById('diag360pop');
    if (!el) return;
    var opened = false;
    function fechar(e) {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      marcarVisto();
      el.classList.remove('show');
      el.style.display = 'none';
    }
    function abrir() {
      if (opened || jaViu() || isDiagPage()) return;
      opened = true;
      marcarVisto();
      el.classList.add('show');
      el.style.display = 'block';
    }
    var btnClose = document.getElementById('d360close');
    if (btnClose) btnClose.addEventListener('click', fechar);
    function onScroll() {
      if (window.scrollY > 100) abrir();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.setTimeout(abrir, isMobile() ? 8000 : 10000);
  } catch(e) {
    console.error('Popup diag360:', e);
  }
})();
</script>

</body>
</html>

