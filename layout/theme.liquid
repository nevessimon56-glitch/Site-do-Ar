<script>
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            loadFilesJSDefer();
            loadInputMask();
        }
    });

    window.addEventListener('load', function () {
        loadFilesJSDefer();
        loadInputMask();
    });
    function loadFilesJSDefer() {
        if (window.__wdnaThemeDeferLoading) {
            return;
        }
        if (document.querySelector('script[data-wdna-theme-defer="1"]')) {
            return;
        }
        window.__wdnaThemeDeferLoading = true;
        var all_defer_script = document.createElement('script');
        all_defer_script.setAttribute('data-wdna-theme-defer', '1');
        all_defer_script.setAttribute('src', '{{ 'assets/theme-defer.js' | themeAssetUrl }}');
        all_defer_script.onerror = function () {
            window.__wdnaThemeDeferLoading = false;
            if (all_defer_script.parentNode) {
                all_defer_script.parentNode.removeChild(all_defer_script);
            }
        };
        document.querySelector('body').appendChild(all_defer_script);
    }

    captureUrlParameter();

    function captureUrlParameter() {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            let sellerInit = null;
            let linkSellerInit = null;
            let refInit = null;

            urlParams.forEach((value, key) => {
                if (key.toLowerCase() === 'seller') {
                    sellerInit = value;
                }
                if (key.toLowerCase() === 'linkseller') {
                    linkSellerInit = value;
                }
                if (key.toLowerCase() === 'ref') {
                    refInit = value;
                }
            });

            if (linkSellerInit) {
                localStorage.setItem('linkSeller', linkSellerInit);
                localStorage.removeItem('seller');
                localStorage.removeItem('ref');
            } else if (sellerInit) {
                localStorage.setItem('seller', sellerInit);
                localStorage.removeItem('linkSeller');
                localStorage.removeItem('ref');
            } else if (refInit) {
                localStorage.setItem('ref', refInit);
                localStorage.removeItem('seller');
                localStorage.removeItem('linkSeller');
            }
        } catch (e) {}
    }

    window.currencyStore = {% if store.symbolPrice %}"{{ store.symbolPrice }}"{% else %}null{% endif %};
</script>
