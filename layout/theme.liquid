    }
  });
</script>
<script>
    function setupStore() {
        return {
            data: { isLogged: null, user: '' },
            init: function initStore() {
                var c = window.__SITE_DOAR_CUSTOMER__;
                if (c) {
                    this.changeCustomerLogin(c);
                } else {
                    this.data.isLogged = false;
                    this.data.user = '';
                }
            },
            headerLogout: function headerLogout() {
                StoreSDK.request.post('/ajax/logout').then((res) => {
                    window.location.href = window.location.href
                });
            },
            changeCustomerLogin: function changeCustomerLogin(customer) {
                this.data.isLogged = !!customer;
                if (customer) {
                    this.data.user = customer.name || customer.fantasyName || customer.email || '';
                } else {
                    this.data.user = '';
                }
                window.__SITE_DOAR_CUSTOMER__ = customer || null;
                if (typeof window.sdaUpdateUtilityBarLabels === 'function') {
                    window.sdaUpdateUtilityBarLabels(customer);
                }
                if (typeof window.sdaSyncMobileCatalogDock === 'function') {
                    window.sdaSyncMobileCatalogDock();
                }
                if (window.SiteDoarFavorites && typeof window.SiteDoarFavorites.mergeGuestOnLogin === 'function') {
                    window.SiteDoarFavorites.mergeGuestOnLogin();
                }
                if (this.data.isLogged) {
                    var elsShowcaseBtnLoginBuy = document.querySelectorAll('.login-btn_logged');
                    for (var i = 0; i < elsShowcaseBtnLoginBuy.length; i++) {
                        elsShowcaseBtnLoginBuy[i].classList.remove('d-hide');
                    }
                } else {
                    var elsShowcasePriceLogin = document.querySelectorAll('.login-btn_not_logged');
                    for (var i = 0; i < elsShowcasePriceLogin.length; i++) {
                        elsShowcasePriceLogin[i].classList.remove('d-hide');
                    }
                }
            },
            openSideNavOverlayCartB2B: function openSideNavOverlayCartB2B() {
                if(this.data.isLogged){
                    openSideNavOverlay('.sidenav-overlay_cart', false, {isViewCart: true});
                } else {
                    openSideNavOverlay('.sidenav-overlay_account', true);
                }
            },
            utilityGreeting: function utilityGreeting() {
                if (!this.data.user) return 'Olá';
                var parts = String(this.data.user).trim().split(' ');
                var first = parts[0] || '';
                return first ? ('Olá, ' + first) : 'Olá';
            },
            checkLoginLogged: function checkLoginLogged() {
                if (this.data.isLogged) {
                    var elsShowcaseBtnLoginBuy = document.querySelectorAll('.login-btn_logged');
                    for (var i = 0; i < elsShowcaseBtnLoginBuy.length; i++) {
                        elsShowcaseBtnLoginBuy[i].classList.remove('d-hide');
                    }
                } else {
                    var elsShowcasePriceLogin = document.querySelectorAll('.login-btn_not_logged');
                    for (var i = 0; i < elsShowcasePriceLogin.length; i++) {
                        elsShowcasePriceLogin[i].classList.remove('d-hide');
                    }
                }
            },
        }
    }
    window.__SITE_DOAR_CUSTOMER__ = {{ customer | json }} || null;
    const customer = window.__SITE_DOAR_CUSTOMER__;
    if (typeof mb_track !== 'undefined') {
        mb_track('setRecoveryUrl', 'https://{{ store.url }}/checkout');
    }
    if (customer) {
        if (typeof mb_track !== 'undefined') {
            window.mb_track('accountSync', {
                user: {
                    user_id: customer.customerId,
                    email: customer.email,
                    phone: customer.cellphone,
                    name: customer.name || customer.fantasyName,
                }
            });
        }
    }
</script>
<script>
(function () {
  function sdaHideStuckLoader() {
    var el = document.querySelector('.loading-main.loading');
    if (el) el.classList.remove('loading');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(sdaHideStuckLoader, 50);
    });
  } else {
    setTimeout(sdaHideStuckLoader, 50);
  }
  window.addEventListener('load', function () {
    setTimeout(sdaHideStuckLoader, 150);
  });
  setTimeout(sdaHideStuckLoader, 12000);
})();
</script>
