{% comment %}
  Popup Diagnóstico 360: CSS em assets/theme-custom.css.
  HTML omitido só quando checkout (templates/checkout.liquid). Página de pedido (checkout-order) ainda recebe o markup; JS bloqueia via .checkout-main (allowPopupPage).
  order.id no layout não está referenciado em outro arquivo — não usar até validar escopo global no staging WDNA.
{% endcomment %}
{% unless checkout %}
<div id="diag360backdrop" aria-hidden="true"></div>
<div id="diag360pop" role="dialog" aria-modal="true" aria-labelledby="d360title" hidden>
  <button id="d360close" type="button" aria-label="Fechar">&#x2715;</button>
  <div class="d360badge"><span class="d360dot"></span> Novo</div>
  <p class="d360title" id="d360title">Qual ar-condicionado é ideal para você?</p>
  <p class="d360text">Responda 10 perguntas e descubra a recomendação certa para o seu ambiente.</p>
  <div class="d360items">
    <span class="d360item">BTUs ideais para o seu espaço</span>
    <span class="d360item">Perfil personalizado de climatização</span>
    <span class="d360item">Link direto para os produtos certos</span>
  </div>
  <a class="d360cta" href="/pagina/diagnostico-360">&#127777; Fazer diagnóstico grátis</a>
  <button class="d360skip" id="d360skip" type="button">Agora não</button>
</div>

<script>
(function(){
  try {
    var KEY = 'diag360_shown_session';
    var lastFocused = null;

    function isDiagPage() {
      var p = (window.location.pathname || '').toLowerCase();
      return p.indexOf('diagnostico') !== -1 || p.indexOf('diag360') !== -1;
    }

    function allowPopupPage() {
      var p = (window.location.pathname || '').toLowerCase();
      if (isDiagPage()) return false;
      if (/checkout|cadastro|register|\/conta|\/account|\/cliente|pedido/.test(p)) return false;
      if (document.querySelector('.checkout-main, .account-main')) return false;
      if (p === '/' || p === '') return true;
      if (document.querySelector('.home-main, .product-main, .search-main')) return true;
      return false;
    }

    function isMobile() {
      return window.matchMedia('(max-width: 767px)').matches;
    }

    // Controle por SESSÃO: enquanto a aba/navegação continuar (mesma visita ao site),
    // o popup já apareceu uma vez não aparece de novo, mesmo trocando de página
    // (home, produto, categoria etc). Quando a pessoa fecha o site e entra de novo
    // (nova sessão), o sessionStorage zera e o popup pode aparecer outra vez.
    function jaViu() {
      try { return sessionStorage.getItem(KEY) === '1'; } catch(e) { return false; }
    }

    function marcarVisto() {
      try { sessionStorage.setItem(KEY, '1'); } catch(e) {}
    }

    if (jaViu()) return;
    if (!allowPopupPage()) return;

    var el = document.getElementById('diag360pop');
    var backdrop = document.getElementById('diag360backdrop');
    var btnClose = document.getElementById('d360close');
    var btnSkip = document.getElementById('d360skip');
    if (!el) return;

    function fechar(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      el.classList.remove('show');
      el.setAttribute('hidden', '');
      if (backdrop) {
        backdrop.classList.remove('show');
        backdrop.setAttribute('aria-hidden', 'true');
      }
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    function abrir() {
      if (!allowPopupPage() || jaViu()) return;
      marcarVisto();
      lastFocused = document.activeElement;
      el.removeAttribute('hidden');
      el.classList.add('show');
      if (backdrop && isMobile()) {
        backdrop.classList.add('show');
        backdrop.setAttribute('aria-hidden', 'false');
      }
      if (btnClose) btnClose.focus();
    }

    if (btnClose) btnClose.addEventListener('click', fechar);
    if (btnSkip) btnSkip.addEventListener('click', fechar);
    if (backdrop) backdrop.addEventListener('click', fechar);
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && el.classList.contains('show')) fechar(ev);
    });

    function foraClick(e) {
      if (!el.classList.contains('show')) return;
      if (el.contains(e.target)) return;
      fechar(e);
    }
    document.addEventListener('mousedown', foraClick);
    document.addEventListener('touchstart', foraClick, { passive: true });

    setTimeout(abrir, isMobile() ? 3000 : 5000);
  } catch(e) {
    console.error('Popup diag360:', e);
  }
})();
</script>
{% endunless %}

